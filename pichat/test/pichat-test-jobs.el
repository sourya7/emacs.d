    (let* ((spec (pichat-test-job-spec project-dir))
           (_first (pichat-job-save store spec))
           (job (pichat-job-save store spec))
           (older (pichat-job-enqueue store nil job)))
      (pichat-job-cancel-queued store older)
      (let* ((latest (pichat-job-enqueue store nil job))
             (token (plist-get (pichat-job-claim store latest) :attempt)))
        (pichat-job-advance store latest token "running")
        (pichat-job-advance store latest token "settling")
        (pichat-job-advance store latest token "finished"
                            '(:result "completed" :safe-to-release t :synchronized t
                              :summary "ANSWER_BELONGS_IN_RUN_REPORT"))
        (pichat-jobs)
        (forward-line 1)
        (should (equal (tabulated-list-get-id) job))
        (pichat-jobs-details)
        (should-not (string-match-p "Response preview:\\|ANSWER_BELONGS_IN_RUN_REPORT"
                                    (buffer-string)))
        (pichat-test-job-press "Completed ·")
        (should (equal pichat-jobs--detail (cons 'runs latest)))
        (should (string-match-p "ANSWER_BELONGS_IN_RUN_REPORT" (buffer-string)))
        (pichat-test-job-press "Job definition")
        (should (equal pichat-jobs--detail (cons 'jobs job)))
        (pichat-test-job-press "Completed ·")
        (pichat-test-job-press "Run history")
        (should (equal pichat-jobs--filter job))
        (should (string-match-p (plist-get spec :title) mode-line-process))
        (should-not (string-match-p (regexp-quote job) mode-line-process))
        (should (equal (mapcar #'car tabulated-list-entries) (list latest older)))
        (pichat-jobs-toggle)
        (should (equal (tabulated-list-get-id) job))
        (should (equal (plist-get (pichat-job-record store 'runs latest) :state) "finished"))
        (should-not (pichat-session-list))))))

(ert-deftest pichat-jobs-no-workspace-blocker-and-local-uncertainty-actions ()

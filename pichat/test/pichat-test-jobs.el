(ert-deftest pichat-job-files-discovery-preview-is-inert-and-retains-roots ()
  (pichat-test-with-job-executor ()
    (let* ((record (pichat-test-job-author project-dir))
           (effective (expand-file-name "effective-agent/" agent-dir))
           (pichat-pi-extra-env `(("PI_CODING_AGENT_DIR" . ,effective)))
           (pichat-jobs--executor nil) (pichat-jobs--owned-store nil)
           (data (pichat-job--copy (plist-get record :definition)))
           (file (expand-file-name "jobs/global.json" effective)))
      (setf (plist-get data :directory) project-dir)
      (make-directory (file-name-directory file) t)
      (with-temp-file file (insert (decode-coding-string (json-serialize data) 'utf-8)))
      (with-temp-file (expand-file-name ".pi/jobs/bad.json" project-dir) (insert "not JSON"))
      (cl-letf (((symbol-function 'pichat-job-store-open) (lambda (&rest _) (ert-fail "store open")))
                ((symbol-function 'pichat-job-launch-capture) (lambda (&rest _) (ert-fail "capture")))
                ((symbol-function 'pichat-job-executor-open) (lambda (&rest _) (ert-fail "executor")))
                ((symbol-function 'make-process) (lambda (&rest _) (ert-fail "process")))
                ((symbol-function 'transient-setup) #'ignore))
        (pichat-job-definitions project-dir)
        (should (derived-mode-p 'tabulated-list-mode))
        (should (= (length tabulated-list-entries) 2))
        (should header-line-format)
        (should tabulated-list-use-header-line)
        (should (string-match-p "2 files · 1 diagnostic (D)" mode-line-process))
        (should (equal (aref (tabulated-list-get-entry) 1) "Global"))
        (should (equal (aref (tabulated-list-get-entry) 2) "jobs/global.json"))
        (should-not (string-match-p "Scope:\\|Authored ID:\\|Discovery and Preview" (buffer-string)))
        (should-not (string-match-p "bad.json" (buffer-string)))
        (let ((discovery (current-buffer)))
          (call-interactively (key-binding (kbd "D")))
          (should (string-match-p "bad.json" (buffer-string)))
          (should (string-match-p (regexp-quote project-dir) (buffer-string)))
          (cl-letf (((symbol-function 'pichat-job-definition-discover)
                     (lambda (&rest _) (ert-fail "inspector rediscovered files"))))
            (call-interactively (key-binding (kbd "g"))))
          (pichat-view-quit)
          (should (eq (current-buffer) discovery)))
        (forward-line 1)
        (should (equal (aref (tabulated-list-get-entry) 1) "Project"))
        (let ((selected (tabulated-list-get-id)) (default-directory agent-dir))
          (pichat-job-definition-ui-refresh)
          (should (equal selected (tabulated-list-get-id))))
        (should (string-match-p (regexp-quote project-dir) mode-line-process))
        (let ((discovery (current-buffer)) (selected (tabulated-list-get-id)))
          (call-interactively (key-binding (kbd "RET")))
          (should (eq (current-buffer) discovery))
          (should (string-match-p "pichat-fake/pichat-fake"
                                  (pichat-job-definition-ui--field :model pichat-job-definition-ui--session)))
          (pichat-job-definition-inspect)
          (should-not (string-match-p "Scope:\\|Authored ID:\\|^Root:" (buffer-string)))
          (should (string-match-p (regexp-quote (plist-get record :file)) (buffer-string)))
          (should-not (string-match-p ":version" (buffer-string)))
          (should (eq (get-text-property (point-min) 'face) 'pichat-input-block-face))
          (should-not (string-match-p "^Model:" (buffer-string)))
          (pichat-test-job-press "Details")
          (should (string-match-p "^Model: pichat-fake/pichat-fake" (buffer-string)))
          (should-not (string-match-p "Tools:" (buffer-string)))
          (pichat-test-job-press "Details")
          (pichat-test-job-press "Technical details")
          (should (string-match-p "Scope: project" (buffer-string)))
          (should (string-match-p "Authored ID:" (buffer-string)))
          (cl-letf (((symbol-function 'pichat-job-definition-discover)
                     (lambda (&rest _) (ert-fail "inspector rescan"))))
            (call-interactively (key-binding (kbd "g"))))
          (call-interactively (key-binding (kbd "q")))
          (should (eq (current-buffer) discovery))
          (should (equal selected (tabulated-list-get-id)))
          (pichat-job-definition-ui-cancel)
          (should (plist-get pichat-job-definition-ui--session :closed))
          (backward-char 1)
          (beginning-of-line)
          (call-interactively (key-binding (kbd "RET")))
          (pichat-job-definition-inspect)
          (should-not (string-match-p "Scope:" (buffer-string)))
          (should (string-match-p (regexp-quote effective) (buffer-string)))
          (pichat-test-job-press "Technical details")
          (should (string-match-p "Scope: global" (buffer-string))))
        (should-not pichat-jobs--owned-store)
        (should-not (pichat-session-list))))))


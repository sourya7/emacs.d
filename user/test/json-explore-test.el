;;; json-explore-test.el --- Typed JSON explorer fixtures -*- lexical-binding: t; -*-

;; From the repository root, with vui installed:
;; emacs -Q --batch -L .local/elpaca/builds/vui -L user \
;;   -l user/test/json-explore-test.el -f ert-run-tests-batch-and-exit

(require 'ert)
(require 'json-explore)

(defmacro json-explore-test--with-view (json &rest body)
  (declare (indent 1))
  `(let ((buffer (json-explore-show-value (json-explore-parse ,json)
                                          (generate-new-buffer-name "*JSON fixture*") t)))
     (unwind-protect
         (with-current-buffer buffer
           (vui-flush-sync)
           ,@body)
       (kill-buffer buffer))))

(ert-deftest json-explore-object-array-union-and-types ()
  (json-explore-test--with-view "[{\"value\":null,\"index\":false},{\"index\":0,\"late\":\"\"}]"
    (should (equal (json-explore--view-columns json-explore--view)
                   '(index "value" "index" "late")))
    (dolist (case '(((0 . "value") :null "null")
                    ((0 . "index") :false "false")
                    ((1 . "index") 0 "0")
                    ((1 . "late") "" "\"\"")))
      (pcase-let ((`(,key ,value ,label) case))
        (should (vui-goto-key key))
        (should (equal (json-explore--value-at-point) value))
        (should (looking-at-p (regexp-quote label)))))
    (should (vui-goto-key '(1 . "value")))
    (should (eq (json-explore--value-at-point) json-explore-missing))
    (should (looking-at-p "<missing>"))
    (should-error (json-explore-open) :type 'user-error)))

(ert-deftest json-explore-empty-containers-and-mixed-arrays ()
  (json-explore-test--with-view "[{},[],true,\"x\",{},-2]"
    (should (equal (json-explore--view-columns json-explore--view) '(index value)))
    (should (vui-goto-key '(0 . value)))
    (should (looking-at-p "{}"))
    (json-explore-open)
    (should (hash-table-p (json-explore--value-at-point)))
    (should (string-suffix-p "{}" (buffer-string)))
    (json-explore-back)
    (should (vui-goto-key '(1 . value)))
    (should (looking-at-p (regexp-quote "[]")))
    (json-explore-open)
    (should (equal (json-explore--value-at-point) []))
    (should (string-suffix-p "[]" (buffer-string)))))

(ert-deftest json-explore-path-uses-original-keys-not-labels ()
  (let ((kill-ring nil) (interprogram-cut-function nil)
        (key "a.b[0]\"\\\n\0") (obj (make-hash-table :test 'equal)))
    (puthash key 7 obj)
    (json-explore-test--with-view (json-explore--json (vector obj))
      (should (vui-goto-key (cons 0 key)))
      (json-explore-copy-path)
      (should (equal (car kill-ring) ".[0][\"a.b[0]\\\"\\\\\\n\\u0000\"]"))
      (json-explore-open)
      (should (= (json-explore--value-at-point) 7))
      (should (equal (json-explore--view-path json-explore--view) (list 0 key))))))

(ert-deftest json-explore-cell-motion-and-rendered-search ()
  (json-explore-test--with-view "[{\"a\":\"long value\",\"b\":2},{\"a\":1,\"b\":\"needle\"}]"
    (should (equal (vui-key-at) '(0 . index)))
    (json-explore-next-column 1)
    (should (equal (vui-key-at) '(0 . "a")))
    (let ((column (+ (current-column) 5)))
      (forward-line 1)
      (move-to-column column))
    ;; Same horizontal position inside padding on the next row.
    (should (equal (vui-key-at) '(1 . "a")))
    (json-explore-next-column 1)
    (should (equal (vui-key-at) '(1 . "b")))
    (json-explore-next-cell 1)
    (should (equal (vui-key-at) '(0 . index)))
    (json-explore-previous-cell 1)
    (should (equal (vui-key-at) '(1 . "b")))
    (goto-char (point-min))
    (should (search-forward "needle" nil t))
    (should (equal (vui-key-at) '(1 . "b")))))

(ert-deftest json-explore-sort-is-typed-stable-and-precedes-cap ()
  (let ((json-explore-row-limit 3))
    (json-explore-test--with-view "[{\"n\":10},{\"n\":2},{\"n\":2},{\"n\":-1}]"
      (should (string-match-p "showing 3 of 4" (buffer-string)))
      (should-not (vui-goto-key '(3 . "n")))
      (should (vui-goto-key '(1 . "n")))
      (json-explore-sort)
      (should (equal (vui-key-at) '(1 . "n")))
      (should (equal (json-explore--visible-rows json-explore--view) '(3 1 2)))
      (json-explore-reverse-sort)
      (should (equal (json-explore--visible-rows json-explore--view) '(0 1 2)))
      (should (equal (vui-key-at) '(1 . "n"))))))

(ert-deftest json-explore-back-and-forward-restore-and-branch ()
  (json-explore-test--with-view "[{\"n\":1,\"obj\":{\"b\":0,\"a\":1}},{\"n\":2}]"
    (save-window-excursion
      (switch-to-buffer (current-buffer))
      (let ((before (buffer-list))
            (window (selected-window)))
        (should (vui-goto-key '(0 . "n")))
        (json-explore-sort)
        (json-explore-sort)
        (should (vui-goto-key '(0 . "obj")))
        (set-window-start window (line-beginning-position))
        (set-window-hscroll window 2)
        (let ((start (window-start window)))
          (json-explore-open)
          (should (equal (json-explore--view-path json-explore--view) '(0 "obj")))
          (should (vui-goto-key '("a" . key)))
          (json-explore-sort)
          (json-explore-back)
          (should (= (window-start window) start))
          (should (= (window-hscroll window) 2))
          (should (equal (vui-key-at) '(0 . "obj")))
          (should (equal (json-explore--view-sort json-explore--view) "n"))
          (should (json-explore--view-descending json-explore--view))
          (json-explore-forward)
          (should (equal (vui-key-at) '("a" . key)))
          (should (eq (json-explore--view-sort json-explore--view) 'key))
          (json-explore-back)
          (should (vui-goto-key '(0 . index)))
          (json-explore-open)
          (should (equal (json-explore--view-path json-explore--view) '(0)))
          (should-error (json-explore-forward) :type 'user-error)
          (should-not (seq-difference (buffer-list) before)))))))

(ert-deftest json-explore-inspection-reuses-read-only-companion ()
  (let* ((source (concat (make-string 1000 ?x) "\nlast line"))
         (buffer (json-explore-show-value (vector source :null :false [] (make-hash-table))
                                           (generate-new-buffer-name "*inspection fixture*") t))
         inspection)
    (unwind-protect
        (with-current-buffer buffer
          (vui-flush-sync)
          (cl-letf (((symbol-function 'display-buffer) (lambda (&rest _) nil)))
            (should (vui-goto-key '(0 . value)))
            (should-not (string-match-p "last line" (buffer-string)))
            (json-explore-open)
            (setq inspection json-explore--inspection)
            (with-current-buffer inspection
              (should buffer-read-only)
              (should (eq major-mode 'text-mode))
              (should (equal (buffer-string) source)))
            (dolist (row '(1 2 3 4))
              (should (vui-goto-key (cons row 'value)))
              (let ((value (json-explore--value-at-point)))
                (json-explore-inspect)
                (should (eq inspection json-explore--inspection))
                (with-current-buffer inspection
                  (should buffer-read-only)
                  (should (equal (json-explore--json (json-explore-parse (buffer-string)))
                                 (json-explore--json value))))))))
      (kill-buffer buffer))
    (should-not (buffer-live-p inspection))))


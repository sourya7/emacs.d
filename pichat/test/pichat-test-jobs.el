      ;; Whitespace and explicit default target/cwd spellings are semantic no-ops.
      (setq record (pichat-test-job-author project-dir :directory project-dir :target '(:name "local")))
      (with-temp-buffer
        (insert-file-contents (plist-get record :file))
        (goto-char (point-min)) (insert "\n  ")

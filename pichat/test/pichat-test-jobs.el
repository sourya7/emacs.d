(ert-deftest pichat-jobs-local-times-handle-date-rollover-and-dst-with-chronological-sorting ()
  (let ((previous-zone (getenv "TZ")))
    (unwind-protect
        (pichat-test-with-job-views
          (set-time-zone-rule "EST5EDT,M3.2.0/2,M11.1.0/2")
          (let* ((spec (pichat-test-job-spec project-dir))
                 (job (pichat-job-save store spec))
                 ids)
            (dolist (scenario '(("2026-11-01T00:44:48.414546363Z" "2026-10-31 20:44:48 EDT")
                                ("2026-11-01T05:50:00Z" "2026-11-01 01:50:00 EDT")
                                ("2026-11-01T06:10:00Z" "2026-11-01 01:10:00 EST")))
              (cl-letf (((symbol-function 'pichat-job--now) (lambda () (car scenario))))
                (let* ((id (pichat-job-enqueue store nil job))
                       (token (plist-get (pichat-job-claim store id) :attempt)))
                  (push id ids)
                  (pichat-job-advance store id token "running")
                  (pichat-job-advance store id token "settling")
                  (pichat-job-advance store id token "finished"
                                      '(:result "completed" :safe-to-release t :synchronized t))
                  (pichat-jobs--show-detail executor 'runs id)
                  (should-not (string-match-p (regexp-quote (cadr scenario)) (buffer-string)))
                  (pichat-test-job-press "Details")
                  (should (string-match-p "Times (local):" (buffer-string)))
                  (should (string-match-p (regexp-quote (cadr scenario)) (buffer-string)))
                  (pichat-test-job-press "Inspect raw settings…")
                  (should (eq pichat-jobs--section 'raw))
                  (should (string-match-p (regexp-quote (car scenario)) (buffer-string)))
                  (should (equal (plist-get (pichat-job-record store 'runs id) :created-at)
                                 (car scenario))))))
            (pichat-jobs--show-detail executor 'jobs job)
            (should (string-match-p "Nov 1, 01:10 EST" (buffer-string)))
            (pichat-jobs)
            (pichat-jobs-toggle)
            ;; Local clocks go backwards at DST end; sorting must not.
            (dolist (width '(60 140))
              (cl-letf (((symbol-function 'window-body-width) (lambda (&rest _) width)))
                (dolist (descending '(nil t))
                  (setq tabulated-list-sort-key (cons "Queued" descending))
                  (pichat-jobs-refresh)
                  (should (assoc "Queued" (append tabulated-list-format nil)))
                  (let (displayed)
                    (goto-char (point-min))
                    (while (not (eobp))
                      (when-let* ((id (tabulated-list-get-id))) (push id displayed))
                      (forward-line 1))
                    (should (equal (nreverse displayed) (if descending ids (reverse ids))))))))))
      (set-time-zone-rule previous-zone))))


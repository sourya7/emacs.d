      (should (string-prefix-p "Cancelling · " (buffer-string)))
      (cl-letf (((symbol-function 'pichat-job-executor-pump) #'ignore))
        (pichat-job-executor--advance execution "uncertain" '(:reason "Inspect descendants/workspace")))
      (should (string-match-p "Needs inspection" (buffer-string)))
      (should-not (string-match-p "Reservation: Held\\|recheck unavailable" (buffer-string)))
      (should (member "Release reservation…" (pichat-test-job-actions)))
      (pichat-test-job-press "Details")
      (should (string-match-p "Reservation: Held" (buffer-string)))
      (should-not (string-match-p "Recheck remote Pi exit" (buffer-string)))
      (should (equal (plist-get (pichat-job-admission store waiter 1) :reason)
                     "Global concurrency limit"))
      (should (eq (plist-get (pichat-job-admission store waiter 3) :ready) t)))))

(ert-deftest pichat-integration-jobs-live-ui-continuation ()
  ;; Also runnable in a separate terminal Emacs when no graphical display exists.
  (should-not noninteractive)
  (pichat-test-with-job-executor
      (:script '(:turns [(:error "Stopped fixture")]))
    (let* ((spec (pichat-test-job-spec project-dir "read"))
           (id (pichat-job-executor-submit executor spec)))
      (pichat-test-job-wait store id "uncertain")
      (pichat-test-assert-provider-script-consumed status-file)
      (pichat-rpc-stop (pichat-job-execution-session (gethash id (pichat-job-executor-contexts executor))))
      (pichat-job-executor-resolve executor id "Fixture inspected: no tool calls or descendants")
      (let ((original (pichat-job-record store 'runs id)))
        (pichat-jobs--show-detail executor 'runs id)
        (should-not (string-match-p "Repeat…\\|Continue in chat…" (buffer-string)))
        (should-not (string-match-p "Actions…" (buffer-string)))
        (pichat-test-job-goto-button "Details")
        (should (looking-at "▸ Details"))
        (should (member "Repeat…" (pichat-test-job-actions)))
        (should-not (string-match-p "Repeat…" (buffer-string)))
        (pichat-test-job-press "Continue work…")
        (let ((setup (current-buffer)))
          (execute-kbd-macro (kbd "i"))
          (insert "Check the remaining work.")
          (execute-kbd-macro (kbd "C-c C-c"))
          (should (eq setup (current-buffer)))
          (should (equal (plist-get (plist-get (transient-scope) :draft) :guidance)
                         "Check the remaining work."))
          (with-temp-file script-file
            (insert "{\"turns\":[{\"text\":\"CONTINUED_RESULT\",\"expectContextIncludes\":[\"Check the remaining work\",\"Stopped fixture\"]}]}"))
          (execute-kbd-macro (kbd "r"))
          (let* ((report (current-buffer)) (window (selected-window))
                 (next (plist-get (aref (pichat-job-records store 'runs) 1) :id)))
            (pichat-test-job-wait store next "finished")
            (should (eq report (current-buffer)))
            (should (eq window (selected-window)))
            (pichat-jobs--show-detail executor 'runs next)
            (should (string-match-p "CONTINUED_RESULT" (buffer-string)))
            (should-not (string-match-p "Repeat…\\|Continue work…" (buffer-string)))
            (should (member "Repeat…" (pichat-test-job-actions)))
            (should-not (member "Continue work…" (pichat-test-job-actions)))
            (pichat-test-job-press "Details")
            (pichat-test-job-press "Previous run")
            (should (equal pichat-jobs--detail (cons 'runs id)))
            (should (equal original (pichat-job-record store 'runs id)))
            (pichat-test-assert-provider-script-consumed status-file)))))))

(ert-deftest pichat-integration-jobs-live-ui-authored-import ()
  (should-not noninteractive)
  (pichat-test-with-job-executor ()
    (let* ((pichat-jobs--executor nil) (pichat-jobs--owned-store store)
           (pichat-jobs-file (pichat-job-store-file store))
           (_record (pichat-test-job-author project-dir))
           (transient-history nil)
           (transient-history-file (expand-file-name "transient-history.el" agent-dir))
           job)
      (with-temp-file (expand-file-name ".pi/jobs/bad.json" project-dir) (insert "not JSON"))
      (pichat-job-definitions project-dir)
      ;; Programmatic table setup is outside the command loop's mark cleanup.
      (deactivate-mark)
      (let ((discovery (current-buffer)))
        (should header-line-format)
        (should (string-match-p "1 diagnostic" mode-line-process))
        (should-not (string-match-p "bad.json" (buffer-string)))
        (execute-kbd-macro (kbd (if (pichat-view-evil-normal-p) "g D" "D")))
        (should (string-match-p "bad.json" (buffer-string)))
        (execute-kbd-macro (kbd (if (pichat-view-evil-normal-p) "g r q" "g q")))
        (should (eq discovery (current-buffer)))
        (let ((wide (cadr (aref tabulated-list-format 0)))
              (split (split-window-right)))
          (unwind-protect
              (progn
                (pichat-job-definition-ui--resize (selected-frame))
                (should (<= (cadr (aref tabulated-list-format 0)) wide))
                (should (tabulated-list-get-id)))
            (when (window-live-p split) (delete-window split))
            (pichat-job-definition-ui--resize (selected-frame))))
        (deactivate-mark)
        (when (bound-and-true-p evil-local-mode) (evil-normal-state))
        (should (tabulated-list-get-id))
        (let ((selected (tabulated-list-get-id)))
          (should (eq (key-binding (kbd "RET")) #'pichat-job-definition-preview))
          (execute-kbd-macro (kbd "RET"))
          (should (eq (oref transient--prefix command) 'pichat-job-definition-menu))
          (should (eq discovery (current-buffer)))
          (should (string-match-p "Model: pichat-fake/"
                                  (with-current-buffer transient--buffer (buffer-string))))
          (should-not (plist-get pichat-job-definition-ui--session :review))
          (let ((text (with-current-buffer transient--buffer (buffer-string))))
            (should (string-match-p "Review" text))
            (should (string-match-p "Open file" text))
            (should (string-match-p "Job +Execution" text))
            (should (< (string-match "Directory:" text) (string-match "^File" text)))
            (should (< (string-match "o Open file" text) (string-match "i Review" text)))
            (should (< (string-match "i Review" text) (string-match "q Close" text)))
            (dolist (line (split-string text "\n"))
              (should (<= (string-width line) (frame-width))))
            (dolist (key '("m" "p" "t"))
              (should-error (transient-get-suffix 'pichat-job-definition-menu key) :type 'error))
            (should-not (string-match-p "Import:\\|Review import\\|Refresh capture\\|Use current settings\\|Save import\\|Open source JSON" text)))
          (execute-kbd-macro (kbd "d"))
          (should (string-match-p "File:" (buffer-string)))
          (should-not (string-match-p "Scope:\\|Authored ID:" (buffer-string)))
          (let ((inspector (current-buffer)))
            (execute-kbd-macro (kbd "q"))
            (should (eq discovery (current-buffer)))
            (execute-kbd-macro (kbd "i"))
            (let ((text (with-current-buffer transient--buffer (buffer-string))))
              (should (string-match-p "Create" text))
              (should (string-match-p "Save" text))
              (should (string-match-p "Job +Execution" text))
              (should (< (string-match "d Inspect" text) (string-match "RET Save" text)))
              (should (< (string-match "r Use current settings" text) (string-match "RET Save" text)))
              (should (< (string-match "RET Save" text) (string-match "q Cancel" text)))
              (should (string-match-p "Settings\\(.\\|\n\\)*Use current settings" text))
              (should-not (string-match-p "Save import\\|Review import" text)))
            (should (equal (pichat-job-records store 'jobs) []))
            (let ((review (plist-get pichat-job-definition-ui--session :review)))
              (execute-kbd-macro (kbd "d"))
              (should (eq inspector (current-buffer)))
              (should-not (string-match-p ":command" (buffer-string)))
              (execute-kbd-macro (kbd "q"))
              (should (eq review (plist-get pichat-job-definition-ui--session :review))))
            (execute-kbd-macro (kbd "q"))
            (should-not (buffer-live-p inspector)))
          (should (equal selected (tabulated-list-get-id)))
          (should (equal (pichat-job-records store 'jobs) []))
          (execute-kbd-macro (kbd "RET i RET"))
          (should-not transient--prefix)
          (should (eq discovery (current-buffer)))
          (should (equal selected (tabulated-list-get-id))))
        (setq job (plist-get (aref (pichat-job-records store 'jobs) 0) :id))
        (pichat-test-job-author project-dir :instructions "Updated from live authored file λ")
        (switch-to-buffer discovery)
        (execute-kbd-macro (kbd (if (pichat-view-evil-normal-p) "g r" "g")))
        (when (bound-and-true-p evil-local-mode) (evil-normal-state))
        (should (tabulated-list-get-id))
        (execute-kbd-macro (kbd "RET i"))
        (should (string-match-p "Update"
                                (with-current-buffer transient--buffer (buffer-string))))
        (should (string-match-p "Changes    Instructions"
                                (with-current-buffer transient--buffer (buffer-string))))
        (execute-kbd-macro (kbd "d"))
        (should-not (string-match-p "After:" (buffer-string)))
        (pichat-test-job-goto-button "Changes")
        (execute-kbd-macro (kbd "TAB"))
        (should (string-match-p "After: Updated from live authored file λ" (buffer-string)))
        (execute-kbd-macro (kbd "q RET"))
        (should (= (length (pichat-job-records store 'jobs)) 1))
        (should (equal (plist-get (plist-get (pichat-job-record store 'jobs job) :spec) :instructions)
                       "Updated from live authored file λ"))
        (let ((bytes (pichat-job-store-bytes store)))
          (execute-kbd-macro (kbd "RET i"))
          (should (string-match-p "Already up to date"
                                  (with-current-buffer transient--buffer (buffer-string))))
          (execute-kbd-macro (kbd "RET"))
          (should (equal bytes (pichat-job-store-bytes store)))
          (execute-kbd-macro (kbd "RET i r d q"))
          (should (equal "refresh" (pichat-job-import-review-action
                                   (plist-get pichat-job-definition-ui--session :review))))
          (let ((session pichat-job-definition-ui--session))
            (execute-kbd-macro (kbd "C-g"))
            (should (plist-get session :closed))
            (should-not (buffer-live-p (plist-get session :inspector))))
          (should (equal bytes (pichat-job-store-bytes store))))
        (should-not pichat-jobs--executor)
        (should-not (pichat-session-list))
        (should (equal (pichat-job-records store 'runs) []))))))

(ert-deftest pichat-integration-jobs-live-ui-repeat-and-save-as ()
  (should-not noninteractive)
  (pichat-test-with-job-executor (:script '(:turns [(:text "REPEATED_RESULT")]))
    (let* ((spec (pichat-test-job-spec project-dir))
           (id (pichat-job-enqueue store spec)))
      (pichat-job-cancel-queued store id)
      (let ((before (pichat-job-record store 'runs id)))
        (unwind-protect
            (progn
              (pichat-jobs--show-detail executor 'runs id)
              (execute-kbd-macro (kbd (if (pichat-view-evil-normal-p) "g a r" "a r")))
              (should (eq (plist-get (transient-scope) :kind) 'repeat))
              (should-not (string-match-p "Repeating may repeat"
                                          (with-current-buffer transient--buffer (buffer-string))))
              (execute-kbd-macro (kbd "v"))
              (should (string-match-p (regexp-quote (plist-get spec :instructions)) (buffer-string)))
              (execute-kbd-macro (kbd "q r"))
              (let ((next (plist-get (aref (pichat-job-records store 'runs) 1) :id))
                    (origin (current-buffer)))
                (pichat-test-job-wait store next "finished")
                (should (eq (current-buffer) origin))
                (should (equal (plist-get (plist-get (pichat-job-record store 'runs next) :trigger)
                                        :repeat-of) id))
                (pichat-jobs--show-detail executor 'runs next)
                (execute-kbd-macro (kbd (if (pichat-view-evil-normal-p) "g a s" "a s")))
                (should (eq (plist-get (transient-scope) :kind) 'save-as))
                (should-not (string-match-p "Run once"
                                           (with-current-buffer transient--buffer (buffer-string))))
                (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "Saved historical work")))
                  (execute-kbd-macro (kbd "n")))
                (execute-kbd-macro (kbd "s"))
                (should (eq (car pichat-jobs--detail) 'jobs))
                (should (equal header-line-format "Saved historical work"))
                (should (= 1 (length (pichat-job-records store 'jobs))))
                (should (= 2 (length (pichat-job-records store 'runs))))
                (should (equal before (pichat-job-record store 'runs id)))
                (pichat-test-assert-provider-script-consumed status-file)))
          (when transient--prefix (transient-quit-all)))))))


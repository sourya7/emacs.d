(ert-deftest pichat-job-schedule-owned-timers-fire-once-and-retire-on-disable-delete ()
  (pichat-test-with-job-executor ()
    (let ((job (pichat-job-save store (pichat-test-job-spec project-dir)))
          (now (float-time)) callbacks cancelled (pumps 0))
      (cl-letf (((symbol-function 'run-at-time)
                 (lambda (_time repeat callback)
                   (should-not repeat)
                   (push callback callbacks) callback))
                ((symbol-function 'cancel-timer) (lambda (timer) (push timer cancelled)))
                ((symbol-function 'pichat-job-executor-pump) (lambda (_) (cl-incf pumps))))
        (pichat-job-executor-schedule-change executor job
                                             (list :kind "interval" :start (+ now 10) :seconds 60))
        (pichat-job-schedule-enable store job t now)
        (pichat-job-executor-schedule-refresh executor)
        (should (= (length callbacks) 1))
        (let ((first (car callbacks)))
          (pichat-job-executor-schedule-refresh executor)
          (should (= (length callbacks) 1))
          (cl-letf (((symbol-function 'float-time) (lambda (&optional _) (+ now 190))))
            (funcall first))
          (should (= (length (pichat-job-records store 'runs)) 1))
          (should (= pumps 1))
          (should (= (length callbacks) 2))
          (funcall first)
          (should (= pumps 1))
          (pichat-job-executor-schedule-enable executor job nil)
          (should cancelled)
          (funcall (car callbacks))
          (should (= pumps 1))
          (pichat-job-cancel-queued store (plist-get (aref (pichat-job-records store 'runs) 0) :id))
          (pichat-job-delete store job)
          (pichat-job-executor-schedule-refresh executor)
          (should (= (hash-table-count (pichat-job-executor-schedules executor)) 0)))))))


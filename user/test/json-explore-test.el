;;; json-explore-test.el --- Typed JSON explorer fixtures -*- lexical-binding: t; -*-

;; From the repository root, with vui installed:
;; emacs -Q --batch -L .local/elpaca/builds/vui -L user \
;;   -l user/test/json-explore-test.el -f ert-run-tests-batch-and-exit

(require 'ert)
(require 'json-explore)

(defmacro json-explore-test--with-view (json &rest body)
  (declare (indent 1))
  `(let ((buffer (json-explore-show-value (json-explore-parse ,json)
                                          (generate-new-buffer-name "*JSON fixture*") t)))
     (unwind-protect
         (with-current-buffer buffer
           (vui-flush-sync)
           ,@body)
       (kill-buffer buffer))))

(defun json-explore-test--header ()
  ;; `format-mode-line' returns an empty string in batch Emacs.
  (eval (cadr header-line-format) t))

(ert-deftest json-explore-object-array-union-and-types ()
  (json-explore-test--with-view "[{\"value\":null,\"index\":false},{\"index\":0,\"late\":\"\"}]"
    (should (equal (json-explore--view-columns json-explore--view)
                   '(index "value" "index" "late")))
    (dolist (case '(((nil 0 "value") :null "null")
                    ((nil 0 "index") :false "false")
                    ((nil 1 "index") 0 "0")
                    ((nil 1 "late") "" "\"\"")))
      (pcase-let ((`(,key ,value ,label) case))
        (should (vui-goto-key key))
        (should (equal (json-explore--value-at-point) value))
        (should (looking-at-p (regexp-quote label)))))
    (should (vui-goto-key '(nil 1 "value")))
    (should (eq (json-explore--value-at-point) json-explore-missing))
    (let ((end (next-single-property-change (point) 'vui-key)))
      (should (string-match-p "\\` +\\'" (buffer-substring-no-properties (point) end))))
    (should-error (json-explore-open) :type 'user-error)))

(ert-deftest json-explore-record-layout-follows-width-and-keeps-per-table-overrides ()
  (let ((width 80))
    (cl-letf (((symbol-function 'json-explore--field-window-width) (lambda () width)))
      (json-explore-test--with-view
          "{\"rows\":[{\"first_column_long\":1,\"second_column_long\":2},{\"first_column_long\":3}],\"other\":[{\"a\":1}]}"
        (json-explore-open-all-sections)
        (let ((key '(("rows") 0 "second_column_long")))
          (should (vui-goto-key key))
          (should-not (json-explore--stacked-at-point-p))
          ;; The header fits 42 columns only without the inline indent.
          (setq width 42)
          (vui-refresh)
          (vui-flush-sync)
          (should (equal (vui-key-at) key))
          (should (json-explore--stacked-at-point-p))
          (should-not (vui-goto-key '(("rows") 1 "second_column_long")))
          (should (vui-goto-key '(("other") 0 "a")))
          (should-not (json-explore--stacked-at-point-p))
          (should (vui-goto-key key))
          (json-explore-toggle-layout)
          (should (equal (vui-key-at) key))
          (should-not (json-explore--stacked-at-point-p))
          (should (vui-goto-key '(("rows") 1 "second_column_long")))
          (json-explore-toggle-layout)
          (should (equal (vui-key-at) '(("rows") 1 index)))
          (json-explore-open)
          (setq width 100)
          (json-explore-back)
          (should (equal (vui-key-at) '(("rows") 1 index)))
          (should (json-explore--stacked-at-point-p)))))))

(ert-deftest json-explore-stacked-records-key-wrap-sort-and-cap ()
  (let ((json-explore-row-limit 2))
    (cl-letf (((symbol-function 'json-explore--field-window-width) (lambda () 32)))
      (json-explore-test--with-view
          "{\"rows\":[{\"score\":2,\"long_text\":\"long words that wrap onto more than one line\",\"meta\":{}},{\"score\":1},{\"score\":3}]}"
        (json-explore-open-all-sections)
        (should (string-match-p "showing 2 of 3" (buffer-string)))
        (should (vui-goto-key '(("rows") 0 index)))
        (let ((start (line-beginning-position)))
          (should (vui-goto-key '(("rows") 1 index)))
          (let ((end (line-beginning-position)))
            (goto-char start)
            (while (< (point) end)
              (should (equal (seq-take (vui-key-at) 2) '(("rows") 0)))
              (when (bolp) (should (<= (string-width (thing-at-point 'line t)) 32)))
              (forward-char 1))))
        (should (vui-goto-key '(("rows") 0 "long_text")))
        (forward-line 1)
        (should (equal (plist-get (json-explore-thing-at-point) :path) '("rows" 0 "long_text")))
        (json-explore-next-cell 1)
        (should (equal (vui-key-at) '(("rows") 0 "meta")))
        (should (vui-goto-key '(("rows") 1 "score")))
        (json-explore-next-column 1)
        (should (equal (vui-key-at) '(("rows") 1 index)))
        (should (vui-goto-key '(("rows") 0 "score")))
        (json-explore-sort)
        (should (string-match-p "^ +\\[1\\]  1\n +\\[0\\]  2" (buffer-string)))
        (json-explore-reverse-sort)
        (should (vui-goto-key '(("rows") 2 "score")))
        (should-not (vui-goto-key '(("rows") 1 index)))
        (should (vui-goto-key '(("rows") 0 "meta")))
        (json-explore-open)
        (should (equal (json-explore-current-path) '("rows" 0 "meta")))))))

(ert-deftest json-explore-stacked-heading-is-fixed-and-navigable ()
  (let ((kill-ring nil))
    (cl-letf (((symbol-function 'json-explore--field-window-width) (lambda () 40)))
      (json-explore-test--with-view
          "[{\"primary\":7,\"status\":\"active\"},{\"primary\":\"abcdefghijklmnopqrstuvwxyz-abcdefghijklmnopqrstuvwxyz\",\"status\":\"draft\"},{\"status\":\"paused\"}]"
        (should-not (string-match-p "^ +primary " (buffer-string)))
        (should (vui-goto-key '(nil 1 "primary")))
        (should (equal (thing-at-point 'line t) "[1]  abcdefghijklmnopqrstuvwxyz-abcdefg…\n"))
        (should (equal (json-explore--value-at-point)
                       "abcdefghijklmnopqrstuvwxyz-abcdefghijklmnopqrstuvwxyz"))
        (should-not (vui-goto-key '(nil 2 "primary")))
        (should (vui-goto-key '(nil 2 index)))
        (should (looking-at-p "\\[2\\]$"))
        (json-explore-next-column 1)
        (should (equal (vui-key-at) '(nil 2 "status")))
        (should (vui-goto-key '(nil 0 index)))
        (json-explore-copy-path)
        (should (equal (current-kill 0 t) ".[0]"))
        (json-explore-next-cell 1)
        (should (equal (vui-key-at) '(nil 0 "primary")))
        (json-explore-copy-path)
        (should (equal (current-kill 0 t) ".[0][\"primary\"]"))
        (json-explore-open)
        (should (equal (json-explore-current-path) '(0 "primary")))
        (should (= (json-explore-current-value) 7))))))

(ert-deftest json-explore-adapter-table-layout-defaults-are-overridable ()
  (let ((width 80))
    (cl-letf (((symbol-function 'json-explore--field-window-width) (lambda () width)))
      (let ((buffer (json-explore-open-source
                     (json-explore-make-source
                      :value (json-explore-parse "{\"a\":[{\"x\":1,\"y\":2,\"z\":3}],\"b\":[{\"x\":2}]}")
                      :view (lambda (_value _context)
                              (vui-vstack
                               (json-explore-table :path '("a") :layout 'stacked :heading "z"
                                                   :columns '(("x" "Custom") ("y" "Y") ("z" "Z")))
                               (json-explore-table :path '("b") :layout 'table
                                                   :columns '(("x" "An intentionally long custom column"))))))
                     :buffer-name (generate-new-buffer-name "*JSON layouts*") :no-display t)))
        (unwind-protect
            (with-current-buffer buffer
              (should (vui-goto-key '(("a") 0 index)))
              (should (json-explore--stacked-at-point-p))
              (should (looking-at-p "\\[0\\]  3$"))
              (json-explore-next-column 1)
              (should (equal (vui-key-at) '(("a") 0 "z")))
              (json-explore-next-column 1)
              (should (equal (vui-key-at) '(("a") 0 "x")))
              (should (looking-at-p "  Custom  1"))
              (json-explore-toggle-layout)
              (should-not (json-explore--stacked-at-point-p))
              (setq width 25)
              (vui-refresh)
              (vui-flush-sync)
              (should (vui-goto-key '(("b") 0 "x")))
              (should-not (json-explore--stacked-at-point-p)))
          (kill-buffer buffer))))))

(ert-deftest json-explore-string-labels-quote-only-ambiguous-values ()
  (dolist (case '(("example" . "example") ("two words" . "two words")
                  ("NULL" . "NULL") ("01" . "01") ("+1" . "+1") (".5" . ".5")
                  ("" . "\"\"") ("null" . "\"null\"") ("true" . "\"true\"")
                  ("false" . "\"false\"") ("0" . "\"0\"") ("-0" . "\"-0\"")
                  ("-12.5E+3" . "\"-12.5E+3\"") ("1e-3" . "\"1e-3\"")
                  (" leading" . "\" leading\"") ("trailing " . "\"trailing \"")
                  ("\u00a0edge" . "\"\u00a0edge\"") ("line\nbreak" . "\"line\\nbreak\"")
                  ("a\tb\0c" . "\"a\\tb\\u0000c\"") ("a\u0085b" . "\"a\\u0085b\"")
                  ("a\u2028b" . "\"a\\u2028b\"")))
    (let ((label (json-explore--summary (car case))))
      (should (equal label (cdr case)))
      (should (eq (get-text-property 0 'face label) 'json-explore-string-face))))
  (let ((json-explore-cell-width 8))
    (should (equal (json-explore--summary "0123456789") "0123456…"))
    (should (string-prefix-p "\"" (json-explore--summary "abcdefghij\n")))))

(ert-deftest json-explore-type-faces-preserve-typed-values-in-tables ()
  (json-explore-test--with-view
      "[{\"title\":\"example\",\"null\":null,\"bool\":true,\"num\":1,\"arr\":[1],\"obj\":{\"a\":0}},{\"bool\":false,\"num\":\"1\"}]"
    (should (string-match-p "^Index +title +null +bool +num +arr +obj *$" (buffer-string)))
    (dolist (case '((0 "title" "example" string)
                    (0 "null" "null" constant) (0 "bool" "true" constant)
                    (1 "bool" "false" constant) (0 "num" "1" number)
                    (1 "num" "\"1\"" string) (0 "arr" "[1 items]" summary)
                    (0 "obj" "{1 keys}" summary)))
      (pcase-let ((`(,row ,key ,label ,type) case))
        (should (vui-goto-key (list nil row key)))
        (should (looking-at-p (regexp-quote label)))
        (should (eq (get-text-property (point) 'face)
                    (intern (format "json-explore-%s-face" type))))))
    (should (equal (plist-get (json-explore-thing-at-point) :path) '(0 "obj")))
    (should (vui-goto-key '(nil 1 "num")))
    (should (equal (plist-get (json-explore-thing-at-point) :value) "1"))))

(ert-deftest json-explore-empty-containers-and-mixed-arrays ()
  (json-explore-test--with-view "[{},[],true,\"x\",{},-2]"
    (should (equal (json-explore--view-columns json-explore--view) '(index value)))
    (should (vui-goto-key '(nil 0 value)))
    (should (looking-at-p "{}"))
    (json-explore-open)
    (should (hash-table-p (json-explore--value-at-point)))
    (should (string-suffix-p "{}" (buffer-string)))
    (json-explore-back)
    (should (vui-goto-key '(nil 1 value)))
    (should (looking-at-p (regexp-quote "[]")))
    (json-explore-open)
    (should (equal (json-explore--value-at-point) []))
    (should (string-suffix-p "[]" (buffer-string)))))

(ert-deftest json-explore-path-uses-original-keys-not-labels ()
  (let ((kill-ring nil) (interprogram-cut-function nil)
        (key "a.b[0]%b\"\\\n\0") (obj (make-hash-table :test 'equal)))
    (puthash key 7 obj)
    (json-explore-test--with-view (json-explore--json (vector obj))
      (let ((source (buffer-name))
            (segment "[\"a.b[0]%b\\\"\\\\\\n\\u0000\"]"))
        (should (local-variable-p 'header-line-format))
        (should (equal (json-explore-test--header) source))
        (should-not (string-match-p "^\\.$" (buffer-string)))
        (should (vui-goto-key (list nil 0 key)))
        (json-explore-copy-path)
        (should (equal (car kill-ring) (concat ".[0]" segment)))
        (json-explore-open)
        (should (= (json-explore--value-at-point) 7))
        (should (equal (json-explore--view-path json-explore--view) (list 0 key)))
        (let ((nested (concat source " › [0] › " (replace-regexp-in-string "%" "%%" segment))))
          (should (equal (json-explore-test--header) nested))
          (json-explore-back)
          (should (equal (json-explore-test--header) source))
          (json-explore-forward)
          (should (equal (json-explore-test--header) nested)))))))

(ert-deftest json-explore-breadcrumb-keeps-the-fitting-suffix ()
  (json-explore-test--with-view "{}"
    (setf (json-explore--view-label json-explore--view) "Short"
          (json-explore--view-path json-explore--view)
          '("long_preceding_segment_to_drop" 42 "leaf%name"))
    (should (string-prefix-p "Short › " (json-explore--breadcrumb 80)))
    (should (equal (json-explore--breadcrumb 40) "… › [42] › [\"leaf%name\"]"))
    (should (<= (string-width (json-explore--breadcrumb 12)) 12))
    (setf (json-explore--view-path json-explore--view) nil)
    (should (equal (json-explore--breadcrumb 4) "Sho…"))))

(ert-deftest json-explore-narrow-fields-wrap-without-clipping-or-losing-cell-identity ()
  (let* ((value (concat "a small phrase " (make-string 31 ?界) "\nlast"))
         (json (format "{\"nested\":{\"label\":%s,\"other\":1},\"rows\":[{\"label\":%s}]}"
                       (json-explore--json value) (json-explore--json value))))
    (cl-letf (((symbol-function 'json-explore--field-window-width) (lambda () 40)))
      (json-explore-test--with-view json
        (should (vui-goto-key '(nil "nested" section)))
        (json-explore-open-section)
        (should (vui-goto-key '(("nested") "label" value)))
        (let* ((pos (point))
               (key (vui-key-at))
               (end (next-single-property-change pos 'vui-key))
               (lines (split-string (buffer-substring-no-properties pos end) "\n"))
               (prefix (make-string (current-column) ?\s)))
          (should (= (length prefix) 9))
          (should (> (length lines) 2))
          (should (<= (+ (length prefix) (string-width (car lines))) 40))
          (should (cl-every (lambda (line) (and (string-prefix-p prefix line)
                                               (<= (string-width line) 40)))
                            (cdr lines)))
          (should (equal (concat (car lines)
                                 (mapconcat (lambda (line) (substring line (length prefix)))
                                            (cdr lines) ""))
                         (decode-coding-string (json-explore--json value) 'utf-8)))
          (forward-line 1)
          (forward-char (length prefix))
          (should (eq (get-text-property (point) 'face) 'json-explore-string-face))
          (should (equal (vui-key-at) key))
          (should (equal (json-explore--value-at-point) value))
          (json-explore-next-cell 1)
          (should (equal (vui-key-at) '(("nested") "other" key))))
        (should (vui-goto-key '(nil "rows" section)))
        (json-explore-open-section)
        (should (vui-goto-key '(("rows") 0 "label")))
        (should (json-explore--stacked-at-point-p))
        (json-explore-toggle-layout)
        (should (string-match-p "… *$" (buffer-substring (point) (line-end-position))))))))

(ert-deftest json-explore-cell-motion-and-rendered-search ()
  (json-explore-test--with-view "[{\"a\":\"long value\",\"b\":2},{\"a\":1,\"b\":\"needle\"}]"
    (should (equal (vui-key-at) '(nil 0 index)))
    (json-explore-next-column 1)
    (should (equal (vui-key-at) '(nil 0 "a")))
    (let ((column (+ (current-column) 5)))
      (forward-line 1)
      (move-to-column column))
    ;; Same horizontal position inside padding on the next row.
    (should (equal (vui-key-at) '(nil 1 "a")))
    (json-explore-next-column 1)
    (should (equal (vui-key-at) '(nil 1 "b")))
    (json-explore-next-cell 1)
    (should (equal (vui-key-at) '(nil 0 index)))
    (json-explore-previous-cell 1)
    (should (equal (vui-key-at) '(nil 1 "b")))
    (goto-char (point-min))
    (should (search-forward "needle" nil t))
    (should (equal (vui-key-at) '(nil 1 "b")))))

(ert-deftest json-explore-sort-is-typed-stable-and-precedes-cap ()
  (let ((json-explore-row-limit 3))
    (json-explore-test--with-view "[{\"n\":10},{\"n\":2},{\"n\":2},{\"n\":-1}]"
      (should (string-match-p "showing 3 of 4" (buffer-string)))
      (should-not (vui-goto-key '(nil 3 "n")))
      (should (vui-goto-key '(nil 1 "n")))
      (json-explore-sort)
      (should (equal (vui-key-at) '(nil 1 "n")))
      (should (equal (json-explore--visible-rows json-explore--view (json-explore--sort-at nil)) '(3 1 2)))
      (json-explore-reverse-sort)
      (should (equal (json-explore--visible-rows json-explore--view (json-explore--sort-at nil)) '(0 1 2)))
      (should (equal (vui-key-at) '(nil 1 "n"))))))

(ert-deftest json-explore-back-and-forward-restore-and-branch ()
  (json-explore-test--with-view "[{\"n\":1,\"obj\":{\"b\":0,\"a\":1}},{\"n\":2}]"
    (save-window-excursion
      (switch-to-buffer (current-buffer))
      (let ((before (buffer-list))
            (window (selected-window)))
        (should (vui-goto-key '(nil 0 "n")))
        (json-explore-sort)
        (json-explore-sort)
        (should (vui-goto-key '(nil 0 "obj")))
        (set-window-start window (line-beginning-position))
        (set-window-hscroll window 2)
        (let ((start (window-start window)))
          (json-explore-open)
          (should (equal (json-explore--view-path json-explore--view) '(0 "obj")))
          (should (vui-goto-key '((0 "obj") "a" key)))
          (json-explore-sort)
          (json-explore-back)
          (should (= (window-start window) start))
          (should (= (window-hscroll window) 2))
          (should (equal (vui-key-at) '(nil 0 "obj")))
          (should (equal (json-explore--sort-at nil) '("n" . t)))
          (json-explore-forward)
          (should (equal (vui-key-at) '((0 "obj") "a" key)))
          (should (eq (car (json-explore--sort-at '(0 "obj"))) 'key))
          (json-explore-back)
          (should (vui-goto-key '(nil 0 index)))
          (json-explore-open)
          (should (equal (json-explore--view-path json-explore--view) '(0)))
          (should-error (json-explore-forward) :type 'user-error)
          (should-not (seq-difference (buffer-list) before)))))))

(ert-deftest json-explore-object-page-folds-motion-and-types ()
  (json-explore-test--with-view
      "{\"owner\":null,\"zero\":0,\"labels\":{\"team\":\"infra\",\"child\":{\"team\":\"deep\"}},\"left\":[{\"n\":2}],\"right\":[{\"n\":3}],\"meta\":{},\"empty\":[]}"
    (should (string-match-p "^owner +null\nzero +0" (buffer-string)))
    (should (vui-goto-key '(nil "owner" value)))
    (should (eq (get-text-property (point) 'face) 'json-explore-constant-face))
    (should (vui-goto-key '(nil "zero" value)))
    (should (eq (get-text-property (point) 'face) 'json-explore-number-face))
    (should-not (string-match-p "infra" (buffer-string)))
    (should (vui-goto-key '(nil "labels" section)))
    (should (looking-at-p "▸ labels +{2 keys}"))
    (save-excursion
      (search-forward "{")
      (should (memq 'json-explore-summary-face (ensure-list (get-text-property (1- (point)) 'face)))))
    (json-explore-toggle-section)
    (should (equal (json-explore--cell-at) '(nil "labels" section)))
    (should (string-match-p "infra" (buffer-string)))
    (should-not (string-match-p "deep" (buffer-string)))
    (json-explore-open-all-sections)
    (should (string-match-p "deep" (buffer-string)))
    (should (vui-goto-key '(("left") 0 "n")))
    (json-explore-next-cell 1)
    (should (equal (json-explore--cell-at) '(nil "right" section)))
    (json-explore-next-cell 1)
    (should (equal (json-explore--cell-at) '(("right") 0 index)))
    (json-explore-next-column 1)
    (should (= (json-explore--value-at-point) 3))
    (should (equal (json-explore--cell-path (json-explore--cell-at)) '("right" 0 "n")))
    (json-explore-previous-cell 3)
    (should (equal (json-explore--cell-at) '(("left") 0 "n")))
    (json-explore-close-section)
    (should (equal (json-explore--cell-at) '(nil "left" section)))
    (should-not (vui-goto-key '(("left") 0 "n")))
    (should (vui-goto-key '(("right") 0 "n")))
    (json-explore-close-all-sections)
    (should (equal (json-explore--cell-at) '(nil "right" section)))
    (should-not (string-match-p "infra\\|deep\\|Index" (buffer-string)))
    (should (vui-goto-key '(nil "meta" section)))
    (should (hash-table-p (json-explore--value-at-point)))
    (should (vui-goto-key '(nil "empty" section)))
    (should (equal (json-explore--value-at-point) []))))

(ert-deftest json-explore-table-row-keys-cover-layout-whitespace ()
  (dolist (inline '(nil t))
    (json-explore-test--with-view
        (if inline "{\"rows\":[{\"n\":1},{\"n\":22}]}" "[{\"n\":1},{\"n\":22}]")
      (let ((path (when inline '("rows"))))
        (when inline
          (should (vui-goto-key '(nil "rows" section)))
          (json-explore-toggle-section))
        (dotimes (row 2)
          (should (vui-goto-key (list path row "n")))
          (let ((second-column (point)) (end (line-end-position)))
            (beginning-of-line)
            (when inline (should (= (char-after) ?\s)))
            (should (= (char-before second-column) ?\s))
            (cl-loop for pos from (point) to end do
                     (goto-char pos)
                     (let ((column (if (< pos second-column) 'index "n"))
                           (thing (json-explore-thing-at-point)))
                       (should (equal (vui-key-at) (list path row column)))
                       (should (equal (plist-get thing :row) row))
                       (should (equal (plist-get thing :column) column))))))))))

(ert-deftest json-explore-inline-tables-memoize-and-restore-history ()
  (let ((json-explore-row-limit 2))
    (json-explore-test--with-view
        "{\"left\":[{\"n\":3},{\"n\":1},{\"n\":2}],\"right\":[{\"n\":4},{\"n\":5},{\"n\":6}]}"
      (save-window-excursion
        (switch-to-buffer (current-buffer))
        (let ((render (symbol-function 'json-explore--table)) calls)
          (cl-letf (((symbol-function 'json-explore--table)
                     (lambda (view &rest args)
                       (push (json-explore--view-path view) calls)
                       (apply render view args))))
            (json-explore-open-all-sections)
            (should (equal calls '(("right") ("left"))))
            (should (= (how-many "showing 2 of 3" (point-min) (point-max)) 2))
            (setq calls nil)
            (should (vui-goto-key '(("left") 1 "n")))
            (json-explore-sort)
            (should (equal calls '(("left"))))
            (should-not (vui-goto-key '(("left") 0 "n")))
            (should (vui-goto-key '(("left") 2 "n")))
            (should (vui-goto-key '(("right") 1 "n")))
            (setq calls nil)
            (json-explore-reverse-sort)
            (should (equal calls '(("right"))))
            (setq calls nil)
            (json-explore-close-section)
            (should-not calls)
            (json-explore-open-section)
            (should (equal calls '(("right"))))
            (should (vui-goto-key '(("right") 1 "n")))
            (let ((start (line-beginning-position)))
              (set-window-start (selected-window) start)
              (json-explore-open)
              (should (equal (json-explore--view-path json-explore--view) '("right" 1 "n")))
              (json-explore-back)
              (should (equal (json-explore--cell-at) '(("right") 1 "n")))
              (should (= (window-start) start))
              (should (vui-goto-key '(("left") 2 "n")))
              (should (equal (json-explore--sort-at '("left")) '("n")))
              (should (equal (json-explore--sort-at '("right")) '("n" . t)))
              (json-explore-forward)
              (should (= (json-explore--value-at-point) 5)))))))))

(ert-deftest json-explore-inspection-reuses-read-only-companion ()
  (let* ((source (concat (make-string 1000 ?x) "\nlast line"))
         (buffer (json-explore-show-value (vector source :null :false [] (make-hash-table))
                                           (generate-new-buffer-name "*inspection fixture*") t))
         inspection)
    (unwind-protect
        (with-current-buffer buffer
          (vui-flush-sync)
          (cl-letf (((symbol-function 'display-buffer) (lambda (&rest _) nil)))
            (should (vui-goto-key '(nil 0 value)))
            (should-not (string-match-p "last line" (buffer-string)))
            (json-explore-open)
            (setq inspection json-explore--inspection)
            (with-current-buffer inspection
              (should buffer-read-only)
              (should (eq major-mode 'text-mode))
              (should (equal (buffer-string) source)))
            (dolist (row '(1 2 3 4))
              (should (vui-goto-key (list nil row 'value)))
              (let ((value (json-explore--value-at-point)))
                (json-explore-inspect)
                (should (eq inspection json-explore--inspection))
                (with-current-buffer inspection
                  (should buffer-read-only)
                  (should (equal (json-explore--json (json-explore-parse (buffer-string)))
                                 (json-explore--json value))))))))
      (kill-buffer buffer))
    (should-not (buffer-live-p inspection))))

(ert-deftest json-explore-buffer-and-region-snapshots ()
  (save-window-excursion
    (with-temp-buffer
      (let ((input (current-buffer)) snapshot)
        (unwind-protect
            (progn
              (insert "{\"field\": [false]}")
              (let* ((begin (search-backward "[")) (end (search-forward "]")))
                ;; Keep the input narrowed for both calls: no region means the full buffer.
                (narrow-to-region begin end)
                (setq snapshot (json-explore-buffer))
                (with-current-buffer snapshot
                  (should (hash-table-p (json-explore--view-value json-explore--view)))
                  (should (equal (json-explore-test--header) (buffer-name input))))
                (with-current-buffer input (json-explore-buffer begin end))
                (with-current-buffer snapshot
                  (should (equal (json-explore--view-value json-explore--view) [:false]))
                  (should (equal (json-explore-test--header) (format "%s (region)" (buffer-name input))))
                  (should-error (json-explore-refresh) :type 'user-error))))
          (when (buffer-live-p snapshot) (kill-buffer snapshot)))))))

(defmacro json-explore-test--with-command (&rest body)
  (declare (indent 0))
  `(let* ((directory (make-temp-file "json-explore-test-" t))
          (fixture (expand-file-name "fixture.sh" directory))
          (name (generate-new-buffer-name "*JSON command fixture*")))
     (unwind-protect (progn ,@body)
       (when (get-buffer name) (kill-buffer name))
       (delete-directory directory t))))

(defun json-explore-test--wait ()
  (let ((deadline (+ (float-time) 5)))
    (while (and json-explore--request (< (float-time) deadline))
      (accept-process-output nil 0.05)))
  (should-not json-explore--request))

(ert-deftest json-explore-command-preserves-argv-directory-and-history ()
  (json-explore-test--with-command
    (let* ((context (list :selector "fixture"))
           (argv (list "./fixture.sh" "{\"a\":{\"x\":1},\"literal\":\"; * $(exit 77)\"}")))
      (write-region "printf '%s' \"$1\"" nil fixture nil 'silent)
      (with-current-buffer (json-explore-run-command "sh" argv :directory directory
                                                     :context context :buffer-name name :no-display t)
        (json-explore-test--wait)
        (let* ((root json-explore--view) (source (json-explore--view-source root)))
          (should (equal (json-explore-test--header) "sh"))
          (should (equal (gethash "literal" (json-explore--view-value root)) "; * $(exit 77)"))
          (should (equal (json-explore--source-argv source) argv))
          (should (eq (json-explore--source-context source) context))
          (should (vui-goto-key '(nil "a" section)))
          (json-explore-open)
          (should-not json-explore--request)
          (should (eq (json-explore--view-source json-explore--view) source))
          (json-explore-sort)
          (write-region "printf '%s' '{\"a\":{\"x\":2}}'" nil fixture nil 'silent)
          (let ((default-directory "/")) (json-explore-refresh))
          (json-explore-test--wait)
          (should (equal (json-explore--view-path json-explore--view) '("a")))
          (should (equal (json-explore-test--header) "sh › a"))
          (should (eq (car (json-explore--sort-at '("a"))) 'key))
          (should (equal (vui-key-at) '(("a") "x" key)))
          (should (= (json-explore--value-at-point) 2))
          (write-region "printf '%s' '{}'" nil fixture nil 'silent)
          (json-explore-refresh)
          (json-explore-test--wait)
          (should (string-match-p "Refreshed JSON has no value" (buffer-string)))
          (should (= (json-explore--value-at-point) 2))
          (json-explore-back)
          (should (eq json-explore--view root))
          (should (= (gethash "x" (json-explore--value-at-point)) 1))
          (json-explore-forward)
          (should (= (json-explore--value-at-point) 2))
          (should-not json-explore--request))))))

(ert-deftest json-explore-failed-refresh-keeps-last-good-view-and-diagnostics ()
  (json-explore-test--with-command
    (write-region "printf '%s' '{\"ok\":42}'; echo initial-warning >&2" nil fixture nil 'silent)
    (with-current-buffer (json-explore-run-command "sh" '("./fixture.sh") :directory directory
                                                   :buffer-name name :no-display t)
      (json-explore-test--wait)
      (should (string-match-p "stderr: initial-warning" (buffer-string)))
      (let ((good json-explore--view))
        (dolist (case '(("printf '%s' '{invalid'" . "Exit status 0:.*JSON")
                        ("echo '   '" . "no JSON output")
                        ("printf '%s' 123; echo bad-news >&2; exit 7" . "Exit status 7")))
          (let ((old-diagnostic (json-explore--view-diagnostic good)))
            (write-region (car case) nil fixture nil 'silent)
            (json-explore-refresh)
            (should (string-match-p "Running command" (buffer-string)))
            (should (equal (json-explore--view-diagnostic good) old-diagnostic))
            (should (= (json-explore--value-at-point) 42))
            (json-explore-test--wait))
          (should (string-match-p (cdr case) (buffer-string)))
          (should (eq good json-explore--view))
          (should (= (json-explore--value-at-point) 42)))
        (should (string-match-p "stderr: bad-news" (buffer-string)))
        ;; sh remains in PATH but is not available via Emacs's exec-path.
        (let ((exec-path nil)) (json-explore-refresh))
        (should-not json-explore--request)
        (should (string-match-p "Executable not found.*sh" (buffer-string)))
        (should (eq good json-explore--view))))))

(ert-deftest json-explore-stderr-preview-line-boundaries ()
  (let ((json-explore-stderr-line-limit 2))
    (should (equal (json-explore--stderr-preview "one\n") '("stderr: one")))
    (should (equal (json-explore--stderr-preview "one\ntwo\n") '("stderr: one" "two")))
    (should (equal (json-explore--stderr-preview "one\n\nthree\nlast")

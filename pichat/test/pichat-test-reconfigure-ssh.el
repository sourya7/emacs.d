(ert-deftest pichat-reconfigure-ssh-late-observer-replies-cannot-affect-new-owner ()
  (dolist (transition '(cancel retry process generation transport chat))
    (pichat-test-ssh-restart--run
     (lambda (fixture)
       (let* ((session (plist-get fixture :session))
              (original (plist-get fixture :original))
              (buffer (plist-get fixture :buffer)))
         (pichat-test-ssh-restart--begin fixture)
         (when (eq transition 'retry)
           (pichat-test-ssh-restart--watch fixture 0 'ready))
         (pcase transition
           ((or 'cancel 'retry)
            (pichat-reconfigure-cancel-operation session "User cancelled")
            (when (eq transition 'retry) (pichat-test-ssh-restart--recover fixture 'retry)))
           ('process (setf (pichat-session-process session) nil))
           ('generation (setf (pichat-session-process-generation session) 99))
           ('transport (setf (pichat-session-transport session) pichat-transport-local))
           ('chat (with-current-buffer buffer (setq pichat-chat-session (pichat-session-make)))))
         (let ((owner (pichat-session-restart-operation session)))
           (pichat-test-ssh-restart--watch fixture 0 'ready)
           (pichat-test-ssh-restart--watch fixture 0 'done t)
           (pichat-test-ssh-restart--watch fixture 0 'done nil "Late disconnect")
           (should (eq owner (pichat-session-restart-operation session)))
           (should-not (plist-get fixture :starts))
           (should-not (plist-get fixture :results))
           (should-not (pichat-process-lifetime-confirmed-p original)))
         ;; Restore the fixture's owner only for ordinary buffer cleanup.
         (with-current-buffer buffer (setq pichat-chat-session session))
         (setf (pichat-session-process session) original))))))


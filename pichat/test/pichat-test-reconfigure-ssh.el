;;; pichat-test-reconfigure-ssh.el --- Offline SSH restart safety -*- lexical-binding: t; -*-

(require 'pichat-test-reconfigure-ssh-support)
(require 'pichat-jobs)

(ert-deftest pichat-reconfigure-ssh-supported-restart-waits-for-remote-evidence ()
  (pichat-test-ssh-restart--run
   (lambda (fixture)
     (let* ((session (plist-get fixture :session))
            (original (plist-get fixture :original))
            (buffer (plist-get fixture :buffer))
            (runtime-id (pichat-session-runtime-id session))
            (scope (pichat-session-owner-scope-key session))
            (transport (pichat-session-transport session))
            (draft-target (with-current-buffer buffer (pichat-chat-draft-capture)))
            (retained (pichat-chat-canonical-entry-cache session)))
       (setf (pichat-session-session-file-back-stack session) '("/runtime/parent.jsonl")
             (pichat-session-session-file-forward-stack session) '("/runtime/future.jsonl"))
       (pichat-test-ssh-restart--begin fixture)
       (should (process-live-p original))
       (should-not (plist-get fixture :starts))
       (should-not (with-current-buffer buffer pichat-chat--restart-staging))
       (pichat-test-ssh-restart--watch fixture 0 'ready)
       (should-not (process-live-p original))
       (should-not (pichat-process-lifetime-confirmed-p original))
       (should-not (plist-get fixture :starts))
       (should (with-current-buffer buffer pichat-chat--restart-staging))
       (should-error (pichat-reconfigure--start-replacement
                      (pichat-session-restart-operation session)) :type 'user-error)
       (pichat-test-ssh-restart--watch fixture 0 'done t)
       (pichat-test-wait-until (lambda () (plist-get fixture :results)) 2 "confirmed SSH restart")
       (should (equal '((t nil)) (plist-get fixture :results)))
       (should (= 1 (length (plist-get fixture :starts))))
       (should (pichat-process-lifetime-confirmed-p original))
       (should (eq session (pichat-session-by-runtime-id runtime-id)))
       (should (equal scope (pichat-session-owner-scope-key session)))
       (should (eq transport (pichat-session-transport session)))
       (should (eq buffer (pichat-session-buffer session)))
       (should (equal "source" (pichat-session-id session)))
       (should (equal '("/runtime/parent.jsonl") (pichat-session-session-file-back-stack session)))
       (should (equal '("/runtime/future.jsonl") (pichat-session-session-file-forward-stack session)))
       (should (equal "/runtime/session.jsonl" (pichat-session-session-file session)))
       (should (equal "fake/model" (pichat-session-startup-model session)))
       (should (eq 'coding (pichat-session-preset-name session)))
       (should-not (pichat-session-restart-operation session))
       (should (equal (pichat-entry-cache-leaf-id retained)
                      (pichat-entry-cache-leaf-id (pichat-chat-canonical-entry-cache session))))
       (with-current-buffer buffer
         (should (pichat-chat-draft-current-p draft-target))
         (should (equal "unsent SSH draft" (pichat-chat--input-text)))
         (should (string-match-p "Final persisted answer" (buffer-string)))
         (should-not pichat-chat--restart-staging))))))

(ert-deftest pichat-reconfigure-ssh-preflight-failure-does-not-stop-or-stage ()
  (dolist (failure '(missing-identity setup probe ephemeral busy pending missing-file))
    (pichat-test-ssh-restart--run
     (lambda (fixture)
       (let* ((session (plist-get fixture :session))
              (original (plist-get fixture :original))
              (buffer (plist-get fixture :buffer))
              (retained (pichat-chat-canonical-entry-cache session)))
         (pcase failure
           ('missing-identity
            (process-put original 'pichat-lifetime nil)
            (pichat-test-ssh-restart--begin fixture))
           ('ephemeral
            (setf (pichat-session-persistence session) 'ephemeral)
            (pichat-test-ssh-restart--begin fixture))
           ('busy
            (setf (pichat-session-streaming-p session) t)
            (pichat-test-ssh-restart--begin fixture))
           ('pending
            (with-current-buffer buffer (setq pichat-chat--queue-counts '(1 . 0)))
            (pichat-test-ssh-restart--begin fixture))
           ('missing-file
            (delete-file (plist-get fixture :host-file))
            (pichat-test-ssh-restart--begin fixture))
           ('setup
            (cl-letf (((symbol-function 'pichat-process-lifetime-watch)
                       (lambda (&rest _) (error "Observer setup unavailable"))))
              (pichat-test-ssh-restart--begin fixture)))
           ('probe
            (pichat-test-ssh-restart--begin fixture)
            (pichat-test-ssh-restart--watch fixture 0 'done nil "Observer baseline failed")))
         (should (= 1 (length (plist-get fixture :results))))
         (should-not (caar (plist-get fixture :results)))
         (should (process-live-p original))
         (should-not (plist-get fixture :starts))
         (should-not (pichat-session-restart-operation session))
         (should (eq retained (pichat-chat-canonical-entry-cache session)))
         (should (eq 'manual (pichat-session-preset-name session)))
         (with-current-buffer buffer
           (should-not pichat-chat--restart-staging)
           (should (equal "unsent SSH draft" (pichat-chat--input-text)))))))))

(ert-deftest pichat-reconfigure-ssh-shutdown-timeout-retains-obligation-and-snapshot ()
  (pichat-test-ssh-restart--run
   (lambda (fixture)
     (let* ((session (plist-get fixture :session))
            (original (plist-get fixture :original))
            (pichat-reconfigure-shutdown-timeout 0.02))
       (pichat-test-ssh-restart--begin fixture)
       (pichat-test-ssh-restart--watch fixture 0 'ready)
       (pichat-test-wait-until (lambda () (plist-get fixture :results)) 2 "uncertain remote shutdown")
       (should-not (caar (plist-get fixture :results)))
       (should (string-match-p "Timed out confirming" (cadar (plist-get fixture :results))))
       (should-not (plist-get fixture :starts))
       (should-not (pichat-process-lifetime-confirmed-p original))
       (should (equal (list original) (plist-get (pichat-session-restart-operation session)
                                                :shutdown-obligations)))
       (with-current-buffer (plist-get fixture :buffer)
         (should pichat-chat--restart-staging)
         (save-excursion
           (goto-char pichat-chat--canonical-start)
           (should (search-forward "Final persisted answer" pichat-chat--canonical-end t))
           (should (get-text-property (1- (point)) 'read-only)))
         (should (equal "unsent SSH draft" (pichat-chat--input-text))))
       ;; A late receipt belongs to the timed-out attempt, not a recovery.
       (pichat-test-ssh-restart--watch fixture 0 'done t)
       (should-not (pichat-process-lifetime-confirmed-p original))
       (should-error (pichat-reconfigure-leave-stopped session) :type 'user-error)
       (pichat-test-ssh-restart--recover fixture 'retry)
       (should-not (plist-get (nth 1 (plist-get fixture :watches)) :require-live))
       (pichat-test-ssh-restart--watch fixture 1 'ready)
       (should-not (plist-get fixture :starts))
       (pichat-test-ssh-restart--watch fixture 1 'done t)
       (pichat-test-wait-until (lambda () (= 2 (length (plist-get fixture :results))))
                               2 "fresh retry confirmation")
       (should (equal '(t nil) (cadr (plist-get fixture :results))))))))

(ert-deftest pichat-reconfigure-ssh-probe-loss-after-stop-cannot-authorize-replacement ()

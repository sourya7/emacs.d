(ert-deftest pichat-job-schedule-picker-defaults-to-future-or-existing-selection ()
  (let ((process-environment (cons "TZ=UTC" process-environment))
        (before (float-time)) seen)
    (cl-letf (((symbol-function 'org-read-date)
               (lambda (with-time to-time from-string _prompt default &rest _)
                 (should with-time) (should-not to-time) (should-not from-string)
                 (setq seen (float-time default) org-read-date-final-answer ""))))
      (let ((chosen (pichat-job-schedule-ui-read-time)))
        (should (= chosen seen))

       (pichat-test-ssh-restart--watch fixture 0 'done t)
       (pichat-test-wait-until (lambda () (plist-get fixture :results)) 2 "first replacement failure")
       (should (eq session (pichat--selected-file-conflict key)))
       (pichat-test-ssh-restart--recover fixture 'retry)
       (pichat-test-ssh-restart--watch fixture 1 'ready)
       (pichat-test-ssh-restart--watch fixture 1 'done t)
       (pichat-test-wait-until (lambda () (= 2 (length (plist-get fixture :results))))
                               2 "second replacement failure")
       (should (= 2 (length (plist-get fixture :starts))))
       (pichat-test-ssh-restart--recover fixture 'restore)
       (pichat-test-ssh-restart--watch fixture 2 'done nil "Recovery observer lost")
       (should (= 3 (length (plist-get fixture :results))))
       (let ((failed (pichat-session-restart-operation session))
             (replacement (cadr (plist-get fixture :starts))))
         (pichat-stop-session session)
         (dolist (index '(0 1 2))
           (pichat-test-ssh-restart--watch fixture index 'ready)
           (pichat-test-ssh-restart--watch fixture index 'done t))
         (should (eq failed (pichat-session-restart-operation session)))
         (should-not (pichat-process-lifetime-confirmed-p replacement))
         (should (eq session (pichat--selected-file-conflict key)))
         (should-error (pichat-forget-session session) :type 'user-error)
         (should-error (pichat-reconfigure-leave-stopped session) :type 'user-error))
       (plist-put fixture :rpc-error nil)
       (pichat-test-ssh-restart--recover fixture 'restore)
       (pichat-test-ssh-restart--watch fixture 3 'ready)
       (pichat-test-ssh-restart--watch fixture 3 'done t)
       (pichat-test-wait-until (lambda () (= 4 (length (plist-get fixture :results))))
                               2 "verified recovery")
       (should (equal '(t nil) (nth 3 (plist-get fixture :results))))
       (should (eq 'manual (pichat-session-preset-name session)))
       (should-not (pichat-session-restart-operation session))
       (should (eq session (pichat--selected-file-conflict key)))
       ;; A committed live writer is now owned by the ordinary runtime policy.
       (pichat-stop-session session)
       (should-not (pichat--selected-file-conflict key))
       (should (pichat-forget-session session))))))


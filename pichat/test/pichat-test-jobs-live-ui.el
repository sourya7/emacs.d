;;; pichat-test-jobs-live-ui.el --- Isolated graphical jobs checks -*- lexical-binding: t; -*-

;;; Commentary:
;; Opt-in separate Emacs only; not loaded by the regular suite.  No user state,
;; real provider, or user's live Emacs is used.  These drive controls/geometry;
;; they do not replace visible human layout review.  See TESTING_GUIDELINES.md.

;;; Code:
(require 'pichat-test-job-support)
(require 'pichat-jobs)

(ert-deftest pichat-integration-jobs-live-ui-followup ()
  (pichat-test-with-job-executor
      (:script '(:turns [(:text "LIVE_FOLLOWUP_RESULT")]))
    (let* ((handler (pichat-job-save store (pichat-test-job-spec project-dir "observe")))
           (spec (plist-put (pichat-test-job-spec project-dir "read") :after-job-id handler)))
      (pichat-job--setup spec nil executor)
      (pichat-test-job-goto-button "Change…")
      (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "None")))
        (execute-kbd-macro (kbd "RET")))
      (should-not (plist-get (pichat-job--submission-spec) :after-job-id))
      (should (equal (pichat-job-records store 'runs) []))
      (pichat-test-job-goto-button "Change…")
      (cl-letf (((symbol-function 'completing-read)
                 (lambda (_prompt choices &rest _) (car (rassoc handler choices)))))
        (execute-kbd-macro (kbd "RET")))
      (pichat-test-job-goto-button "Run once")
      (execute-kbd-macro (kbd "RET"))
      (let* ((id (plist-get (aref (pichat-job-records store 'runs) 0) :id))
             (background (current-buffer)) (window (selected-window)))
        (pichat-test-job-wait store id "finished")
        (let ((child (plist-get (plist-get (pichat-job-record store 'runs id) :dispatch) :run-id)))
          (pichat-test-job-wait store child "finished")
          (should (eq (current-buffer) background))
          (should (eq (selected-window) window))
          (should (= (length (pichat-job-records store 'runs)) 2))
          (pichat-jobs--show-detail executor 'runs id)
          (should (string-match-p "After this run: Review files · Completed" (buffer-string)))
          (pichat-test-job-goto-button "View follow-up run")
          (execute-kbd-macro (kbd "RET"))
          (should (equal pichat-jobs--detail (cons 'runs child)))
          (should (string-match-p "Triggered by:" (buffer-string)))
          (pichat-test-job-goto-button "Review files")
          (execute-kbd-macro (kbd "RET"))
          (should (equal pichat-jobs--detail (cons 'runs id))))))))

(ert-deftest pichat-integration-jobs-live-ui-execution-settings ()
  (pichat-test-with-job-executor ()
    (let ((pichat-jobs--executor executor)
          (transient-history nil)
          (transient-history-file (expand-file-name "transient-history.el" agent-dir))
          (pichat-jobs-file (pichat-job-store-file store)))
      (pichat-job--setup (pichat-test-job-spec project-dir) nil executor)
      (let ((setup (current-buffer))
            (before (pichat-presets--copy pichat-job--draft)))
        (unwind-protect
            (progn
              (pichat-test-job-goto-button "Execution settings…")
              (execute-kbd-macro (kbd "RET"))
              (should (eq (oref transient--prefix command) 'pichat-job-settings-menu))
              (cl-letf (((symbol-function 'completing-read)
                         (lambda (&rest _) "Read-only — wait for stable files")))
                (execute-kbd-macro (kbd "w")))
              (should (eq (oref transient--prefix command) 'pichat-job-settings-menu))
              (should (equal before pichat-job--draft))
              (execute-kbd-macro (kbd "q"))
              (should (equal before pichat-job--draft))
              (pichat-job-execution-settings)
              (cl-letf (((symbol-function 'completing-read)
                         (lambda (&rest _) "Read-only — wait for stable files")))
                (execute-kbd-macro (kbd "w")))
              (execute-kbd-macro (kbd "RET"))
              (should (eq (current-buffer) setup))
              (should (eq (button-get (button-at (point)) 'pichat-job-action)
                          'pichat-job-execution-settings))
              (should (equal (plist-get pichat-job--draft :access) "read"))
              ;; Exercise the actual nested Tools Transient and its return path.
              (pichat-job-execution-settings)
              (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t))
                        ((symbol-function 'pichat-tool-picker--discover) #'ignore)
                        ((symbol-function 'pichat-tool-picker--discover-extensions) #'ignore))
                (execute-kbd-macro (kbd "x")))
              (should (eq (oref transient--prefix command) 'pichat-tool-picker))
              (execute-kbd-macro (kbd "q"))
              (should (eq (oref transient--prefix command) 'pichat-job-settings-menu))
              (execute-kbd-macro (kbd "q"))
              ;; Quitting the entire nested picker must not strand :pending.
              (pichat-job-execution-settings)
              (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t))
                        ((symbol-function 'pichat-tool-picker--discover) #'ignore)
                        ((symbol-function 'pichat-tool-picker--discover-extensions) #'ignore))
                (execute-kbd-macro (kbd "x")))
              (execute-kbd-macro (kbd "C-g"))
              (pichat-job--editable)
              ;; A model-list callback arrives after its prefix exits.
              (pichat-job-execution-settings)
              (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t))
                        ((symbol-function 'pichat--list-models-async)
                         (lambda (_query callback &rest _)
                           (run-at-time 0.01 nil callback '("fixture")) nil))
                        ((symbol-function 'pichat--read-model-table-choice)
                         (lambda (&rest _) "fixture/selected")))
                (execute-kbd-macro (kbd "m"))
                (pichat-test-wait-until
                 (lambda () (and transient--prefix
                                 (eq (oref transient--prefix command) 'pichat-job-settings-menu)))
                 2 "model picker returned to execution settings"))
              (should (equal (plist-get (plist-get (plist-get (transient-scope) :draft) :profile)
                                       :model) "fixture/selected"))
              (execute-kbd-macro (kbd "RET"))
              (should (equal (plist-get (plist-get pichat-job--draft :profile) :model)
                             "fixture/selected"))
              (should (eq (button-get (button-at (point)) 'pichat-job-action)
                          'pichat-job-execution-settings))
              (should (equal (pichat-job-records store 'runs) []))
              (should-not (pichat-session-list)))
          (when transient--prefix (transient-quit-all))
          (when (buffer-live-p setup) (kill-buffer setup)))))))

(ert-deftest pichat-integration-jobs-live-ui-manual-flow ()
  (should (display-graphic-p))
  (pichat-test-with-job-executor
      (:script '(:turns [(:text "LIVE_JOB_RESULT" :delayMs 100)]))
    (let ((pichat-jobs--executor executor)
          (pichat-jobs-file (pichat-job-store-file store))
          (origin (window-buffer (selected-window))) setup job)
      (unwind-protect
          (progn
            (call-interactively #'pichat-job-new)
            (setq setup (current-buffer))
            (should (derived-mode-p 'pichat-job-setup-mode))
            (call-interactively (key-binding (kbd "<tab>")))
            (should (equal (button-label (button-at (point))) "Edit instructions…"))
            (call-interactively (key-binding (kbd "C-c C-e")))
            (insert "Inspect the supplied files.\nExplain the result briefly.")
            (call-interactively (key-binding (kbd "C-c C-c")))
            (should (eq (current-buffer) setup))
            (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "Live review")))
              (pichat-test-job-press "Save job…"))
            (setq job (plist-get (aref (pichat-job-records store 'jobs) 0) :id))
            (should (equal (pichat-job-records store 'runs) []))
            (pichat-test-job-press "Run once")
            (should (eq (current-buffer) origin))
            (let* ((id (plist-get (aref (pichat-job-records store 'runs) 0) :id))
                   (execution (gethash id (pichat-job-executor-contexts executor))))
              (pichat-test-job-wait store id "finished")
              (should (eq (current-buffer) origin))
              (should-not (get-buffer-window
                           (pichat-session-buffer (pichat-job-execution-session execution)) t))
              (call-interactively #'pichat-jobs)
              (call-interactively (key-binding (kbd "TAB")))
              (goto-char (point-min))
              (call-interactively (key-binding (kbd "RET")))
              (should (string-match-p "LIVE_JOB_RESULT" (buffer-string)))
              (should-not (string-match-p (regexp-quote pichat-test-fake-provider-extension) (buffer-string)))
              (should-not (string-match-p "Inspect raw settings" (buffer-string)))
              (should (string-match-p "Diagnostics" (buffer-string)))
              (pichat-test-job-goto-button "Execution details")
              (call-interactively (key-binding (kbd "<tab>")))
              (should-not (string-match-p "Instructions & settings" (buffer-string)))
              (should-not (string-match-p "Runtime ID:" (buffer-string)))
              (should (string-match-p "Explain the result briefly" (buffer-string)))
              (pichat-test-job-press "Inspect raw settings…")
              (should (string-match-p (regexp-quote pichat-test-fake-provider-extension) (buffer-string)))
              (should (string-match-p ":runtime-id" (buffer-string)))
              (call-interactively (key-binding (kbd "q")))
              (should (member 'execution pichat-jobs--expanded))
              (pichat-test-job-press "Execution details")
              (should-not (string-match-p "Runtime ID:" (buffer-string)))
              (pichat-test-job-press "Execution details")
              (should (string-match-p "Times (local):" (buffer-string)))
              (should-not (string-match-p "Runtime ID:" (buffer-string)))
              (pichat-jobs-detail-refresh)
              (should (member 'execution pichat-jobs--expanded))
              (pichat-test-job-press "Preview conversation")
              (should buffer-read-only)
              (should (string-match-p "LIVE_JOB_RESULT" (buffer-string)))
              (should-not (pichat-session-alive-p (pichat-job-execution-session execution)))
              (pichat-view-quit)
              (should (derived-mode-p 'pichat-jobs-detail-mode)))
            (pichat-test-assert-provider-script-consumed status-file)
            (with-temp-file script-file (insert "{\"turns\":[{\"text\":\"SAVED_JOB_RESULT\",\"delayMs\":100}]}"))
            ;; The saved definition is distinct from the unsaved Run once.
            (call-interactively #'pichat-jobs)
            (call-interactively (key-binding (kbd "TAB")))
            (goto-char (point-min))
            (call-interactively (key-binding (kbd "RET")))
            (should (string-match-p "Never run" (buffer-string)))
            (should-not (string-match-p (regexp-quote job) (buffer-string)))
            (should-not (string-match-p "Schedule:\\|Model:" (buffer-string)))
            (should (text-property-any (point-min) (point-max) 'pichat-job-section 'task))
            (pichat-test-job-goto-button "Job details")
            (call-interactively (key-binding (kbd "<tab>")))
            (should (string-match-p "Model:" (buffer-string)))
            (should-not (string-match-p "Instructions & settings" (buffer-string)))
            (pichat-test-job-press "Inspect raw settings…")
            (should (string-match-p ":access[[:space:]]+\"write\"" (buffer-string)))
            (call-interactively (key-binding (kbd "q")))
            (should (member 'definition pichat-jobs--expanded))
            (let ((details (current-buffer)))
              (pichat-test-job-press "Run job")
              (let ((id (plist-get (pichat-jobs--latest store job) :id)))
                (pichat-test-job-wait store id "finished")
                (should (eq (current-buffer) details))
                (pichat-test-job-press "Open latest run")
                (should (equal pichat-jobs--detail (cons 'runs id)))
                (should (string-match-p "SAVED_JOB_RESULT" (buffer-string)))))
            (pichat-test-job-press "More actions")
            (pichat-test-job-press "Job history")
            (should (= (length tabulated-list-entries) 1))
            (should (equal pichat-jobs--filter job))
            (should (string-match-p "Live review" mode-line-process))
            ;; Real window sizes, not a mocked formatter width.
            (delete-other-windows)
            (dolist (width '(70 140))
              (set-frame-width (selected-frame) width)
              (pichat-test-wait-until
               (lambda () (if (< width 110) (< (window-body-width) 110)
                            (>= (window-body-width) 110)))
               3 "graphical Jobs window to resize")
              (pichat-jobs-refresh)
              (should (string-match-p "local" (buffer-string)))
              (should (string-match-p "Queued" (format-mode-line header-line-format)))
              (should (eq (not (null (assoc "Project / target" (append tabulated-list-format nil))))
                          (>= width 110))))
            (call-interactively (key-binding (kbd "TAB")))
            (should (equal (tabulated-list-get-id) job))
            (pichat-test-assert-provider-script-consumed status-file))
        (maphash (lambda (_id execution) (pichat-job-executor--retire execution))
                 (pichat-job-executor-contexts executor))
        (dolist (buffer (buffer-list))
          (when (and (buffer-live-p buffer)
                     (with-current-buffer buffer
                       (or (eq pichat-jobs--owner executor)
                           (bound-and-true-p pichat-job-executor--buffer-execution))))
            (kill-buffer buffer)))))))

(ert-deftest pichat-integration-jobs-live-ui-attention-and-uncertainty ()
  (should (display-graphic-p))
  ;; Cached attention states use an inert owned process, not a model/provider.
  (pichat-test-with-owned-job
    (let ((waiter (pichat-job-enqueue store (pichat-test-job-spec project-dir)))
          (chat (pichat-chat-ensure session)) confirmation)
      (pichat-jobs--show-detail executor 'runs waiter)
      (pichat-test-job-press "Open blocking run")
      (should (equal pichat-jobs--detail (cons 'runs id)))
      (cl-letf (((symbol-function 'yes-or-no-p)
                 (lambda (prompt) (setq confirmation prompt) nil)))
        (pichat-test-job-press "Cancel run…"))
      (should (string-match-p (regexp-quote project-dir) confirmation))
      (should (string-match-p "local" confirmation))
      (pichat-job-executor--advance execution "running")
      (with-current-buffer chat
        (pichat-chat--on-extension-ui-request
         session 'extension-ui-request
         '(:raw (:type "extension_ui_request" :id "live-input" :method "input"
                       :title "Review required"))))
      (pichat-jobs--render-detail)
      (should (string-match-p "Needs input" (buffer-string)))
      (should (string-match-p "Review required" (buffer-string)))
      (should-not (get-buffer-window chat t))
      (should-not (active-minibuffer-window))
      (setf (pichat-job-execution-cancelling execution) t)
      (pichat-job-executor--advance execution "settling")
      (should (string-match-p "Execution: Cancelling" (buffer-string)))
      (pichat-job-executor--advance execution "uncertain" '(:reason "Inspect descendants/workspace"))
      (should (string-match-p "Needs inspection" (buffer-string)))
      (should-not (string-match-p "Reservation: Held\\|recheck unavailable" (buffer-string)))
      (pichat-test-job-press "More actions")
      (should (string-match-p "Release reservation…" (buffer-string)))
      (pichat-test-job-press "Execution details")
      (should (string-match-p "Reservation: Held" (buffer-string)))
      (should-not (string-match-p "Recheck remote Pi exit" (buffer-string)))
      (should-not (eq (plist-get (pichat-job-admission store waiter) :ready) t)))))

(ert-deftest pichat-integration-jobs-live-ui-continuation ()
  ;; Also runnable in a separate terminal Emacs when no graphical display exists.
  (should-not noninteractive)
  (pichat-test-with-job-executor
      (:script '(:turns [(:error "Stopped fixture")]))
    (let* ((spec (pichat-test-job-spec project-dir "read"))
           (id (pichat-job-executor-submit executor spec)))
      (pichat-test-job-wait store id "finished")
      (pichat-test-assert-provider-script-consumed status-file)
      (let ((original (pichat-job-record store 'runs id)))
        (pichat-jobs--show-detail executor 'runs id)
        (should-not (string-match-p "Repeat…\\|Continue in chat…" (buffer-string)))
        (pichat-test-job-goto-button "More actions")
        (call-interactively (key-binding (kbd "TAB")))
        (should (string-match-p "Repeat…" (buffer-string)))
        (call-interactively (key-binding (kbd "TAB")))
        (should-not (string-match-p "Repeat…" (buffer-string)))
        (pichat-test-job-press "Continue work…")
        (let ((setup (current-buffer)))
          (pichat-test-job-press "Additional instructions…")
          (insert "Check the remaining work.")
          (call-interactively (key-binding (kbd "C-c C-c")))
          (should (eq setup (current-buffer)))
          (should (string-match-p "Check the remaining work" (buffer-string)))
          (with-temp-file script-file
            (insert "{\"turns\":[{\"text\":\"CONTINUED_RESULT\",\"expectContextIncludes\":[\"Check the remaining work\",\"Stopped fixture\"]}]}"))
          (pichat-test-job-press "Run once")
          (let* ((report (current-buffer)) (window (selected-window))
                 (next (plist-get (aref (pichat-job-records store 'runs) 1) :id)))
            (pichat-test-job-wait store next "finished")
            (should (eq report (current-buffer)))
            (should (eq window (selected-window)))
            (pichat-jobs--show-detail executor 'runs next)
            (should (string-match-p "CONTINUED_RESULT" (buffer-string)))
            (should (string-match-p "Repeat…" (buffer-string)))
            (should-not (string-match-p "Continue work…" (buffer-string)))
            (pichat-test-job-press "Execution details")
            (pichat-test-job-press "Previous run")
            (should (equal pichat-jobs--detail (cons 'runs id)))
            (should (equal original (pichat-job-record store 'runs id)))
            (pichat-test-assert-provider-script-consumed status-file)))))))

(provide 'pichat-test-jobs-live-ui)

        (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "Model"))
                  ((symbol-function 'yes-or-no-p) (lambda (&rest _) t))
                  ((symbol-function 'pichat--list-models-async)
                   (lambda (_query cb &rest _) (setq callback cb) nil)))
          (pichat-job-execution-settings)
          (pichat-job-settings-model))
        (cl-letf (((symbol-function 'pichat--read-model-table-choice)
                   (lambda (&rest _) "other-provider/other-model")))
          (funcall callback '("dummy")))
        (pichat-job-settings-apply)
        ;; Missing context uses plain language; rejecting it preserves the draft.
        (should (string-match-p "Previous run context is incomplete" (buffer-string)))
        (cl-letf (((symbol-function 'yes-or-no-p)
                   (lambda (prompt)
                     (should (string-match-p "Continue with incomplete previous run context" prompt))
                     (should-not (string-match-p "evidence" prompt))
                     nil)))
          (should-error (pichat-job-run-once) :type 'user-error))
        (should (= 1 (length (pichat-job-records store 'runs))))

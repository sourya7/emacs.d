(ert-deftest pichat-reconfigure-ssh-unwritten-restart-commits-new-source-only-after-exit ()
  (pichat-test-ssh-restart--run
   (lambda (fixture)
     (let* ((session (plist-get fixture :session))
            (runtime-id (pichat-session-runtime-id session))
            (old-source (pichat-session-id session)))
       (pichat-test-ssh-restart--begin fixture)
       (should (plist-get (pichat-session-restart-operation session) :empty-unwritten))
       (pichat-test-ssh-restart--watch fixture 0 'ready)
       (plist-put fixture :state
                  (plist-put (plist-put (copy-tree (plist-get fixture :state))
                                        :sessionId "new-empty")
                             :sessionFile "/runtime/new-empty.jsonl"))
       (pichat-test-ssh-restart--watch fixture 0 'done t)
       (pichat-test-wait-until (lambda () (plist-get fixture :results)) 2 "unwritten SSH restart")
       (should (equal '((t nil)) (plist-get fixture :results)))
       (should-not (member "switch_session" (plist-get fixture :rpc-calls)))
       (should (equal runtime-id (pichat-session-runtime-id session)))
       (should-not (equal old-source (pichat-session-id session)))
       (should (equal "new-empty" (pichat-session-id session)))
       (should-not (file-exists-p (plist-get fixture :host-file)))
       (with-current-buffer (plist-get fixture :buffer)
         (should-not pichat-chat--restart-staging)
         (should (equal "unsent SSH draft" (pichat-chat--input-text))))))
   t))

(ert-deftest pichat-reconfigure-ssh-reload-verification-failure-retains-original-source ()
  (dolist (failure '(source branch transcript settings))
    (pichat-test-ssh-restart--run
     (lambda (fixture)
       (let* ((session (plist-get fixture :session))
              (retained (pichat-chat-canonical-entry-cache session)))
         (pichat-test-ssh-restart--begin fixture)
         (pichat-test-ssh-restart--watch fixture 0 'ready)
         (pcase failure
           ('source (plist-put (plist-get fixture :state) :sessionId "unexpected-source"))
           ('branch (plist-put (plist-get fixture :entries) :leafId "entry-user"))
           ('transcript
            (let ((entries (copy-tree (plist-get fixture :entries) t)))
              (plist-put (plist-get (car (plist-get entries :entries)) :message)
                         :content '((:type "text" :text "external change")))
              (plist-put fixture :entries entries)))
           ('settings (plist-put (plist-get fixture :state) :model '(:provider "wrong" :id "model"))))
         (pichat-test-ssh-restart--watch fixture 0 'done t)
         (pichat-test-wait-until (lambda () (plist-get fixture :results)) 2 "reload validation refusal")
         (should-not (caar (plist-get fixture :results)))
         (should-not (pichat-session-alive-p session))
         (should (eq 'manual (pichat-session-preset-name session)))
         (should (eq retained (plist-get (pichat-session-restart-operation session) :retained)))
         (with-current-buffer (plist-get fixture :buffer)
           (should (eq retained pichat-chat--entry-cache))
           (should pichat-chat--restart-staging)
           (should (equal "unsent SSH draft" (pichat-chat--input-text)))
           (should (string-match-p "Final persisted answer" (buffer-string)))))))))

(ert-deftest pichat-reconfigure-ssh-startup-helper-failure-retains-unknown-writer ()
  (pichat-test-ssh-restart--run
   (lambda (fixture)
     (let ((session (plist-get fixture :session)) cleaned)
       (plist-put fixture :unknown-replacement t)
       (cl-letf (((symbol-function 'pichat-tool-runtime-prepare)
                  (lambda (_session _names &optional skill-file)
                    (setf (pichat-session-rpc-startup-control session)
                          (list :process nil :helper
                                (list :skill (and skill-file "/fixture/pichat-jobs/SKILL.md")
                                      :cleanup (lambda () (setq cleaned t)))))
                    "/fixture-helper.ts"))
                 ((symbol-function 'pichat-tool-runtime-begin)
                  (lambda (&rest _) (error "Identity helper failed before readiness"))))
         (pichat-test-ssh-restart--begin fixture)
         (pichat-test-ssh-restart--watch fixture 0 'ready)
         (pichat-test-ssh-restart--watch fixture 0 'done t)
         (pichat-test-wait-until (lambda () (plist-get fixture :results)) 2 "helper startup failure"))
       (let ((replacement (car (plist-get fixture :starts)))
             (failed (pichat-session-restart-operation session)))
         (should replacement)
         (should-not (pichat-session-process session))
         (should (memq replacement (plist-get failed :shutdown-obligations)))
         (should-not (pichat-process-lifetime-supported-p replacement))
         (should (process-get replacement 'pichat-helper-cleanup))
         (should-not cleaned)
         (pichat-test-ssh-restart--recover fixture 'restore)
         (should-not cleaned)
         (should (= 1 (length (plist-get fixture :starts))))
         (should-not (car (cadr (plist-get fixture :results)))))))))

(ert-deftest pichat-reconfigure-ssh-helper-cleanup-waits-for-confirmed-exit ()
  (dolist (success '(nil t))
    (pichat-test-ssh-restart--run
     (lambda (fixture)
       (let ((original (plist-get fixture :original)) (cleaned 0))
         (process-put original 'pichat-helper-cleanup
                      (lambda ()
                        (should (pichat-process-lifetime-confirmed-p original))
                        (cl-incf cleaned)))
         (pichat-test-ssh-restart--begin fixture)
         (pichat-test-ssh-restart--watch fixture 0 'ready)
         (should (= 0 cleaned))
         (pichat-test-ssh-restart--watch fixture 0 'done success "Probe failed")
         (pichat-test-wait-until (lambda () (plist-get fixture :results)) 2 "shutdown outcome")
         (if success
             (progn
               (pichat-test-wait-until (lambda () (= 1 cleaned)) 2 "deferred safe helper cleanup")
               (should-not (process-get original 'pichat-helper-cleanup)))
           (should (= 0 cleaned))
           (should (process-get original 'pichat-helper-cleanup))))))))


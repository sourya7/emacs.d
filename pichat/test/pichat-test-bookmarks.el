;;; pichat-test-bookmarks.el --- Durable bookmark tests -*- lexical-binding: t; -*-

;;; Code:

(require 'bookmark)
(require 'pichat-test-history-support)
(require 'pichat)
(require 'pichat-bookmark)

(defun pichat-test-bookmark--write-session (file id cwd)
  "Write a minimal saved session header to FILE for ID and CWD."
  (with-temp-file file
    (insert (json-serialize (list :type "session" :version 3 :id id :cwd cwd))
            "\n")))

(defmacro pichat-test-bookmark--with-store (&rest body)
  "Run BODY with isolated saved sessions and an ordinary Emacs bookmark store."
  (declare (indent 0))
  `(let* ((root (make-temp-file "pichat-bookmarks-" t))
          (bookmark-default-file (expand-file-name "bookmarks" root))
          (bookmark-alist nil)
          (bookmark-alist-modification-count 0)
          (bookmark-bookmarks-timestamp nil)
          (bookmark-current-bookmark nil)
          (bookmark-save-flag nil)
          (bookmark-history nil)
          (pichat-path-mappings nil)
          (pichat-targets nil)
          (pichat-project-target-alist nil)
          (pichat--sessions-by-id (make-hash-table :test #'equal))
          (pichat--sessions-by-scope (make-hash-table :test #'equal))
          (pichat--source-reservations (make-hash-table :test #'equal))
          (pichat--session-order nil)
          (pichat-current-session nil)
          (pichat-chat-stop-session-on-kill nil))
     (unwind-protect (progn ,@body)
       (delete-directory root t))))

(ert-deftest pichat-bookmark-chat-record-survives-source-rebinding-and-reload ()
  (pichat-test-bookmark--with-store
    (let* ((cwd (expand-file-name "my-project" root))
           (file (expand-file-name "a.jsonl" root))
           (session (pichat-session-make :id "12345678-source" :session-file file
                                         :runtime-id "ephemeral-runtime-number"
                                         :cwd root :owner-directory root)))
      (pichat-test-bookmark--write-session file "12345678-source" cwd)
      (with-temp-buffer
        (pichat-chat-mode)
        (setq pichat-chat-session session)
        (setf (pichat-session-buffer session) (current-buffer))
        (pichat-chat--refresh-source-identity session)
        (let ((pichat-chat--inhibit-edit-guard t))
          (insert (propertize "private draft" 'pichat-node-key "not-an-entry")))
        (should (string-match-p "my-project.*12345678" (car (bookmark-make-record))))
        (bookmark-set "Conversation")
        (pichat-chat--on-session-rebinding session 'session-rebinding nil)
        (setf (pichat-session-id session) "replacement"
              (pichat-session-session-file session) (expand-file-name "b.jsonl" root))
        (should-error (bookmark-set "Transitional chat") :type 'user-error))
      (bookmark-save)
      (setq bookmark-alist nil)
      (bookmark-load bookmark-default-file t)
      (let ((record (bookmark-get-bookmark "Conversation")))
        (should (eq 'pichat-bookmark-jump (bookmark-get-handler record)))
        (should (eql 1 (bookmark-prop-get record 'pichat-version)))
        (should (equal file (bookmark-get-filename record)))
        (should (equal "12345678-source" (bookmark-prop-get record 'pichat-session-id)))
        (should (equal cwd (bookmark-prop-get record 'pichat-runtime-cwd)))
        (should (equal cwd (bookmark-prop-get record 'pichat-host-cwd)))
        (should-not (bookmark-prop-get record 'pichat-entry-id))
        (should-not (bookmark-get-position record))
        (dolist (needle '("ephemeral-runtime-number" "private draft" "replacement"))
          (should-not (string-search needle (prin1-to-string record))))))))

(ert-deftest pichat-bookmark-history-captures-exact-inactive-row-not-old-tree ()
  (pichat-test-bookmark--with-store
    (let* ((file (expand-file-name "saved.jsonl" root))
           (session (pichat-session-make :id "saved" :session-file file))
           (replacement (pichat-session-make :id "different" :session-file file)))
      (pichat-test-bookmark--write-session file "saved" root)
      (pichat-test-with-history (session (pichat-test-sessions-preview--response))
        (pichat-sessions--goto-id "alternate-leaf")
        (bookmark-set "Alternate branch")
        (goto-char (point-min))
        ;; A header isn't the last selected row.
        (should-error (bookmark-set "Header") :type 'user-error)
        (pichat-sessions--goto-id "alternate-leaf")
        ;; A new request owns the view before its tree replaces the old rows.
        (pichat-sessions--install-request-owner replacement (current-buffer))
        (should-error (bookmark-set "Pending history") :type 'user-error)
        (pichat-sessions--refresh-from-response
         (pichat-test-sessions-preview--response) replacement (current-buffer))
        (pichat-sessions--on-session-rebinding replacement 'session-rebinding nil)
        (should-error (bookmark-set "Stale history") :type 'user-error))
      (bookmark-save)
      (setq bookmark-alist nil)
      (bookmark-load bookmark-default-file t)
      (should (equal "alternate-leaf"
                     (bookmark-prop-get "Alternate branch" 'pichat-entry-id)))
      (should (equal "saved"
                     (bookmark-prop-get "Alternate branch" 'pichat-session-id))))))

(ert-deftest pichat-bookmark-capture-rejects-unsaved-or-wrong-sources ()
  (pichat-test-bookmark--with-store
    (let* ((file (expand-file-name "unwritten.jsonl" root))
           (session (pichat-session-make :id "source" :session-file file)))
      (should-error (pichat-bookmark-make-record session) :type 'user-error)
      (pichat-test-bookmark--write-session file "other-source" root)
      (should-error (pichat-bookmark-make-record session) :type 'user-error)
      (pichat-test-bookmark--write-session file "source" root)
      (should (pichat-bookmark-make-record session))
      (setf (pichat-session-persistence session) 'ephemeral)
      (should-error (pichat-bookmark-make-record session) :type 'user-error)
      (setf (pichat-session-persistence session) 'persistent
            (pichat-session-backend session) 'unsupported)
      (should-error (pichat-bookmark-make-record session) :type 'user-error))))

(ert-deftest pichat-bookmark-capture-keeps-mapped-project-and-file-provenance ()
  (pichat-test-bookmark--with-store
    (let* ((pichat-path-mappings (list (cons root "/runtime")))
           (file (expand-file-name "saved.jsonl" root))
           (session (pichat-session-make :id "saved" :session-file "/runtime/saved.jsonl")))
      (pichat-test-bookmark--write-session file "saved" "/runtime/project")
      (let ((record (pichat-bookmark-make-record session)))
        (should (equal (bookmark-get-filename record) file))
        (should (equal (bookmark-prop-get record 'pichat-runtime-file) "/runtime/saved.jsonl"))
        (should (equal (bookmark-prop-get record 'pichat-runtime-cwd) "/runtime/project"))
        (should (equal (bookmark-prop-get record 'pichat-host-cwd)
                       (expand-file-name "project" root)))))))

(ert-deftest pichat-bookmark-jump-reuses-only-exact-live-host ()
  (pichat-test-bookmark--with-store
    (let* ((file (expand-file-name "saved.jsonl" root))
           (origin (pichat-session-make :id "saved" :session-file file))
           (host (pichat-session-make :id "saved" :session-file file))
           (scope (list "fixture" root "fixture")))
      (pichat-test-bookmark--write-session file "saved" root)
      (let ((record (pichat-bookmark-make-record origin)))
        (pichat-register-session origin scope)
        (pichat-register-session host scope)
        (setf (pichat-session-session-file origin) (expand-file-name "rebound.jsonl" root))
        (setq pichat-current-session origin)
        (puthash (pichat-backend-scope-key origin "fixture") origin pichat--sessions-by-scope)
        (with-temp-buffer
          (setf (pichat-session-buffer host) (current-buffer))
          (let ((destination (current-buffer)))
            (cl-letf (((symbol-function 'pichat-session-alive-p) (lambda (_) t))
                      ((symbol-function 'pichat-sessions-open-file-independently)
                       (lambda (&rest _) (ert-fail "Unexpected competing writer")))
                      ((symbol-function 'pichat-chat-ensure)
                       (lambda (session &optional sync)
                         (should (eq session host)) (should-not sync) destination)))
              (bookmark-jump record (lambda (buffer) (should (eq buffer destination))))
              (should (eq pichat-current-session origin))
              (should (pichat-session-default-p origin))
              (dolist (conflict (list
                                 (pichat-session-make :id "wrong-id" :session-file file)
                                 (pichat-session-make :id "saved" :session-file file)))
                (cl-letf (((symbol-function 'pichat-session-list)
                           (lambda () (list host conflict))))
                  (should-error (bookmark-jump record) :type 'user-error)))
              (setf (pichat-session-backend host) 'unsupported)
              (should-error (bookmark-jump record) :type 'user-error))))))))

(ert-deftest pichat-bookmark-jump-opens-with-captured-project-and-serializes-writers ()
  (pichat-test-bookmark--with-store
    (let* ((file (expand-file-name "saved.jsonl" root))
           (project (expand-file-name "project" root))
           (pichat-path-mappings (list (cons root "/runtime")))
           (origin (pichat-session-make :id "saved" :session-file "/runtime/saved.jsonl"))
           (host (pichat-session-make :id "saved" :session-file "/runtime/saved.jsonl"))
           (scope (list "fixture" root "fixture"))
           (calls 0))
      (make-directory project)
      (pichat-test-bookmark--write-session file "saved" "/runtime/project")
      (let ((record (pichat-bookmark-make-record origin)))
        (pichat-register-session origin scope)
        (with-temp-buffer
          (let ((destination (current-buffer)))
            (cl-letf (((symbol-function 'pichat-session-alive-p) (lambda (s) (eq s host)))
                      ((symbol-function 'pichat-chat-ensure) (lambda (&rest _) destination))
                      ((symbol-function 'pichat-sessions-open-file-independently)
                       (lambda (selected &rest options)
                         (cl-incf calls)
                         (should (equal selected file))
                         (should (equal (plist-get options :cwd) "/runtime/project"))
                         (should (equal (plist-get options :owner-directory) project))
                         (should (equal (plist-get options :expected-session-id) "saved"))
                         (should-not (plist-get options :source-session))
                         (should (eq (plist-get options :readiness) 'transcript-ready))
                         (should (eq (plist-get (plist-get options :launch-options) :transport)
                                     pichat-transport-local))
                         (should-error (bookmark-jump record) :type 'user-error)
                         (if (= calls 1)
                             (funcall (plist-get options :error-callback) '(:error "load failed") host)
                           (funcall (plist-get options :ready) host)))))
              (let ((key (pichat--selected-file-key pichat-transport-local "/runtime/saved.jsonl")))
                (cl-letf (((symbol-function 'pichat-reconfigure-source-claim)
                           (lambda (_) (list :key key :uncertain t))))
                  (should-error (bookmark-jump record) :type 'user-error)
                  (should (= calls 0))))
              (should-error (bookmark-jump record) :type 'user-error)
              (pichat-forget-session origin)
              (bookmark-jump record (lambda (buffer) (should (eq buffer destination))))
              (should (= calls 2))
              (should (= (hash-table-count pichat--source-reservations) 0)))))))))

(ert-deftest pichat-bookmark-jump-rejects-file-identity-and-mapping-drift ()
  (pichat-test-bookmark--with-store
    (let* ((file (expand-file-name "saved.jsonl" root))
           (pichat-path-mappings (list (cons root "/mapped")))
           (source (pichat-session-make :id "saved" :session-file "/mapped/saved.jsonl")))
      (pichat-test-bookmark--write-session file "saved" "/mapped")
      (let ((record (pichat-bookmark-make-record source)))
        (cl-letf (((symbol-function 'pichat-sessions-open-file-independently)
                   (lambda (&rest _) (ert-fail "Opened unverified saved file"))))
          (let ((pichat-path-mappings nil))
            (should-error (bookmark-jump record) :type 'user-error))
          (pichat-test-bookmark--write-session file "different" "/mapped")
          (should-error (bookmark-jump record) :type 'user-error)
          (pichat-test-bookmark--write-session file "saved" "/mapped/other")
          (should-error (bookmark-jump record) :type 'user-error)
          (delete-file file)
          (should-error (bookmark-jump record) :type 'user-error))))))

(ert-deftest pichat-bookmark-jump-resolves-ssh-provenance-before-remote-io ()
  (pichat-test-bookmark--with-store
    (let* ((pichat-targets `((fixture :kind ssh :tramp-prefix "/ssh:fixture:"
                                    :path-mappings ((,root . "/project")))))
           header-file
           (transport (pichat-transport-resolve root 'fixture))
           (source (pichat-session-make :id "saved" :session-file "/sessions/a.jsonl"
                                       :transport transport)))
      (cl-letf (((symbol-function 'pichat-bookmark--saved-header)
                 (lambda (file) (setq header-file file) '(:id "saved" :cwd "/project")))
                ((symbol-function 'pichat-transport-busy-p) #'ignore))
        (let ((record (pichat-bookmark-make-record source)))
          (setq header-file nil)
          (should (equal transport (car (pichat-bookmark--resolve record))))
          (should (equal header-file "/ssh:fixture:/sessions/a.jsonl"))
          (setq header-file nil)
          (dolist (pichat-targets '(nil ((fixture :kind ssh :tramp-prefix "/ssh:other:"))))
            (should-error (bookmark-jump record) :type 'user-error)
            (should-not header-file)))))))

(ert-deftest pichat-bookmark-jump-selects-inactive-entry-and-rejects-stale-or-hidden-rows ()
  (pichat-test-bookmark--with-store
    (let* ((file (expand-file-name "saved.jsonl" root))
           (session (pichat-session-make :id "saved" :session-file file))
           (tree (pichat-test-sessions-preview--response))
           (buffer (generate-new-buffer " *Bookmark History*"))
           (record nil) (stale nil))
      (unwind-protect
          (progn
            (pichat-test-bookmark--write-session file "saved" root)
            (setq record (pichat-bookmark-make-record session "alternate-leaf"))
            (pichat-register-session session (list "fixture" root "fixture"))
            (let ((get-buffer-create (symbol-function 'get-buffer-create)))
              (cl-letf (((symbol-function 'get-buffer-create)
                         (lambda (name &rest args)
                           (if (equal name "*PiChat Session History*") buffer
                             (apply get-buffer-create name args))))
                        ((symbol-function 'pichat-session-alive-p) (lambda (_) t))
                        ((symbol-function 'pichat-rpc-get-tree)
                         (lambda (s success &optional _failure)
                           (should (eq s session))
                           (when stale
                             (cl-incf (pichat-session-diagnostic-source-generation s)))
                           (funcall success tree s))))
                (bookmark-jump record
                               (lambda (b)
                                 (should (eq b buffer))
                                 (with-current-buffer b
                                   (should (equal (pichat-sessions--entry-id-at-point) "alternate-leaf"))
                                   (should (equal pichat-sessions--leaf-id
                                                  (plist-get (plist-get tree :data) :leafId))))))
                (with-current-buffer buffer (setq pichat-sessions--query "impossible-filter"))
                (should-error (bookmark-jump record) :type 'user-error)
                (with-current-buffer buffer (setq pichat-sessions--query nil))
                (should-error (bookmark-jump (pichat-bookmark-make-record session "missing"))
                              :type 'user-error)
                (setq stale t)
                (should-error (bookmark-jump record) :type 'user-error))))
        (kill-buffer buffer)))))

(ert-deftest pichat-bookmark-fresh-emacs-loads-handler-and-rechecks-configured-target ()
  (pichat-test-bookmark--with-store
    (let* ((autoloads (expand-file-name "pichat-autoloads.el" root))
           (pichat-targets '((fixture :kind ssh :tramp-prefix "/ssh:original:")))
           (source (pichat-session-make
                    :id "saved" :session-file "/project/saved.jsonl"
                    :transport (pichat-transport-resolve root 'fixture))))
      (cl-letf (((symbol-function 'pichat-bookmark--saved-header)
                 (lambda (file)
                   (should (equal file "/ssh:original:/project/saved.jsonl"))
                   '(:id "saved" :cwd "/project"))))
        (with-temp-buffer
          (let ((bookmark-make-record-function
                 (lambda () (pichat-bookmark-make-record source))))
            (bookmark-set "Configured target"))))
      (bookmark-save)
      ;; Generate beside the source, as a package build does.
      (copy-file (expand-file-name "pichat-bookmark.el" pichat-test-pichat-directory)
                 (expand-file-name "pichat-bookmark.el" root))
      (pichat-test-eval-in-fresh-emacs
       `(progn
          (require 'loaddefs-gen)
          (loaddefs-generate ,root ,autoloads)
          (load ,autoloads nil t)
          (require 'bookmark)
          (should (autoloadp (symbol-function 'pichat-bookmark-jump)))
          (should-not (featurep 'pichat))
          (should-not (featurep 'pichat-bookmark))
          (should-not (featurep 'pichat-chat))
          (let ((bookmark-default-file ,bookmark-default-file)
                (bookmark-alist nil))
            (bookmark-load bookmark-default-file t)
            (setq pichat-targets '((fixture :kind ssh :tramp-prefix "/ssh:changed:")))
            ;; The moved target must be rejected before any file access.
            (let ((original (symbol-function 'file-regular-p)))
              (cl-letf (((symbol-function 'file-regular-p)
                         (lambda (file)
                           (when (file-remote-p file)
                             (ert-fail "Attempted remote file access"))
                           (funcall original file))))
                (let ((failure (should-error (bookmark-jump "Configured target")
                                             :type 'user-error)))
                  (should (string-match-p "target or path mapping changed"
                                          (error-message-string failure)))))))
          (should (featurep 'pichat-bookmark)))))))

(provide 'pichat-test-bookmarks)

(ert-deftest pichat-job-uncertain-manual-release-retains-honest-evidence ()
  (pichat-test-with-job-executor ()
    (let* ((id (pichat-job-enqueue store (pichat-test-job-spec project-dir)))
           (claim (pichat-job-claim store id)))
      (pichat-job-advance store id (plist-get claim :attempt) "uncertain")
      (pichat-job-executor-resolve executor id "Inspected processes and workspace manually")

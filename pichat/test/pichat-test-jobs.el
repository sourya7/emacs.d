          (should (equal (pichat-job-import-review-action review) "refresh"))
          (should (equal (pichat-job-import-commit review) job))))
      (should-not (equal (plist-get original :spec) (plist-get (pichat-job-record store 'jobs job) :spec)))
      (should (= (length (pichat-job-records store 'jobs)) 1)))))


      (should (equal (plist-get (pichat-job-record store 'runs waiting) :state) "starting")))))

(ert-deftest pichat-ssh-test-probe-rechecks-disappearance-without-hiding-read-errors ()
  (pichat-test-with-temp-dir root
    (let ((default-directory root))
      (make-directory (expand-file-name "sys/kernel/random" root) t)
      (make-directory (expand-file-name "self" root))
      (make-directory (expand-file-name "123" root))
      (with-temp-file (expand-file-name "sys/kernel/random/boot_id" root) (insert "test-boot\n"))
      (with-temp-file (expand-file-name "self/stat" root) (insert "healthy\n"))
      (with-temp-buffer
        ;; A present lifetime with unreadable/missing stat is still an error.
        (should (= 2 (process-file "sh" nil t nil "-c"
                                   (pichat-test-real-ssh--probe-script 123 root)))))
      (with-temp-buffer
        ;; Reproduce the check/read race deterministically: the stat read fails
        ;; while the owned fake lifetime disappears.  Subsequent absence is
        ;; independently confirmed, not inferred from cat's failure.
        (should (= 0 (process-file
                      "sh" nil t nil "-c"
                      (concat
                       "cat() { case \"$1\" in */123/stat) rmdir "
                       (shell-quote-argument (expand-file-name "123" root))
                       "; return 1;; *) command cat \"$@\";; esac; };\n"
                       (pichat-test-real-ssh--probe-script 123 root)))))
        (should (equal (buffer-string) "test-boot\nABSENT\n")))
      ;; A broken baseline cannot turn even an absent PID into successful proof.
      (delete-file (expand-file-name "self/stat" root))
      (with-temp-buffer
        (should (= 2 (process-file "sh" nil t nil "-c"
                                   (pichat-test-real-ssh--probe-script 123 root))))))))


(defmacro pichat-test-with-job-views (&rest body)
  "Isolate job UI buffers/globals while running BODY."
  (declare (indent 0) (debug t))
  `(pichat-test-with-job-executor ()
     (let ((pichat-jobs--executor executor)
           (pichat-jobs-file (pichat-job-store-file store))
           (initial (buffer-list)))
       (unwind-protect
           (let (settings-scope)
             (cl-letf (((symbol-function 'transient-setup)
                        (lambda (prefix &rest args)
                          (should (eq prefix 'pichat-job-settings-menu))
                          (setq settings-scope (plist-get (nthcdr 2 args) :scope))))
                       ((symbol-function 'transient-scope) (lambda () settings-scope)))
               (save-window-excursion ,@body)))
         (dolist (buffer (buffer-list))
           (when (and (not (memq buffer initial))
                      (string-prefix-p "*PiChat" (buffer-name buffer)))
             (kill-buffer buffer)))))))


;;; pichat-test-evil.el --- Optional Evil key precedence tests -*- lexical-binding: t; -*-

;;; Commentary:

;; Run with Evil on `load-path' to check effective keys, not just map entries.
;; The normal Emacs-only suite does not need Evil installed.

;;; Code:

(require 'pichat-test-support)
(require 'pichat-test-job-support)

(ert-deftest pichat-evil-read-only-views-keep-vim-navigation-and-owned-quit ()
  (skip-unless (require 'evil nil t))
  (require 'pichat-evil)
  (require 'pichat-artifacts-embark)
  (require 'pichat-job-definition-ui)
  (let* ((was-active (bound-and-true-p evil-mode))
         (modes '(pichat-chat-mode pichat-chat-compose-mode
                  pichat-view-mode pichat-session-manager-mode pichat-jobs-mode
                  pichat-job-definitions-mode
                  pichat-artifact-result-mode pichat-artifact-elisp-result-mode
                  pichat-artifact-runner-result-mode))
         (open-inspectors (list (generate-new-buffer " *evil-existing-safe*")
                                (generate-new-buffer " *evil-existing-raw*")))
         (previous-preview-hook
          (copy-sequence pichat-artifacts-preview-mode-hook))
         (previous (mapcar (lambda (mode)
                             (cons mode (evil-initial-state mode)))
                           modes)))
    (unwind-protect
        (progn
          (evil-mode 1)
          (cl-mapc (lambda (buffer mode)
                     (with-current-buffer buffer
                       (funcall mode)
                       (evil-normal-state)))
                   open-inspectors
                   '(pichat-diagnostics-mode pichat-transport-diagnostics-mode))
          (pichat-evil-setup)
          (dolist (buffer open-inspectors)
            (with-current-buffer buffer
              (should (eq (key-binding (kbd "g r")) #'pichat-diagnostics-refresh))
              (should (eq (key-binding (kbd "q")) #'pichat-view-quit))))
          (with-temp-buffer
            (pichat-chat-mode)
            (should (eq evil-state 'normal))
            (should (eq (key-binding (kbd "RET")) #'evil-ret))
            (should (eq (key-binding (kbd "C-c C-c"))
                        #'pichat-chat-send-input))
            (dolist (binding '(("]]" . pichat-chat-next-user-turn)
                               ("[[" . pichat-chat-previous-user-turn)
                               ("]a" . pichat-chat-next-activity)
                               ("[a" . pichat-chat-previous-activity)
                               ("]t" . pichat-chat-next-tool)
                               ("[t" . pichat-chat-previous-tool)))
              (should (eq (key-binding (kbd (car binding))) (cdr binding))))
            (evil-insert-state)
            (should (eq (key-binding (kbd "RET")) #'pichat-chat-ret))
            (should (eq (key-binding (kbd "[")) #'self-insert-command)))
          (with-temp-buffer
            (pichat-chat-mode)
            (let* ((text "one\ntwo\nthree\nfour\nfive\nsix")
                   (node (pichat-transcript-node-create
                          :kind 'message :role 'user :key "submitted"
                          :content (list (pichat-transcript-content-create
                                          :kind 'prose :index 0 :text text)))))
              (let ((pichat-chat--inhibit-edit-guard t))
                (insert (pichat-render-fragment-propertized-string
                         (pichat-render--node-fragment node (pichat-render-default-context)))))
              (pichat-chat-user-ui-refresh (point-min) (point-max) 0)
              (goto-char (point-min))
              (dolist (key '("RET" "TAB" "<tab>"))
                (call-interactively (key-binding (kbd key))))
              (should (overlay-get (pichat-chat-user-ui--at-point) 'pichat-user-expanded))
              (should (eq (key-binding (kbd "w")) #'pichat-evil-chat-copy-or-motion))
              (let (moved)
                (cl-letf (((symbol-function 'evil-forward-word-begin)
                           (lambda () (interactive) (setq moved t))))
                  (call-interactively (key-binding (kbd "w"))))
                (should moved))
              (call-interactively (key-binding (kbd "g y")))
              (should (equal text (current-kill 0 t)))
              (goto-char (point-min))
              (forward-char 2)
              (evil-visual-char)
              (let ((before (point))
                    (kill-ring '("unchanged")))
                (call-interactively (key-binding (kbd "w")))
                (should (> (point) before))
                (should (eq evil-state 'visual))
                (should (equal kill-ring '("unchanged"))))
              (evil-normal-state)))
          (with-temp-buffer
            (pichat-job-definitions-mode)
            (should (eq evil-state 'normal))
            (should (eq (key-binding (kbd "RET")) #'pichat-job-definition-preview))
            (should (eq (key-binding (kbd "g D")) #'pichat-job-definition-diagnostics))
            (should (eq (key-binding (kbd "q")) #'pichat-view-quit))
            (should (eq (key-binding (kbd "g r")) #'pichat-job-definition-ui-refresh))
            (should (eq (key-binding (kbd "w")) #'evil-forward-word-begin)))
          (with-temp-buffer
            (pichat-job-definition-diagnostics-mode)
            (should (eq evil-state 'normal))
            (should (eq (key-binding (kbd "g r")) #'pichat-job-definition-ui--render-diagnostics))
            (should (eq (key-binding (kbd "q")) #'pichat-view-quit)))
          (with-temp-buffer
            (pichat-job-definition-inspector-mode)
            (should (eq evil-state 'normal))
            (should (eq (key-binding (kbd "q")) #'pichat-job-definition-inspector-quit))
            (should (eq (key-binding (kbd "g r")) #'pichat-job-definition-ui--render-inspector))
            (should (eq (key-binding (kbd "TAB")) #'pichat-jobs-detail-tab))
            (should (eq (key-binding (kbd "<tab>")) #'pichat-jobs-detail-tab))
            (should (eq (key-binding (kbd "w")) #'evil-forward-word-begin)))
          (with-temp-buffer
            (pichat-job-definition-ui-mode)
            (should (eq evil-state 'normal))
            (should (eq (key-binding (kbd "RET")) #'push-button))
            (should (eq (key-binding (kbd "TAB")) #'forward-button))
            (should (eq (key-binding (kbd "q")) #'pichat-view-quit))
            (should (eq (key-binding (kbd "g r")) #'pichat-job-definition-ui-refresh))
            (should (eq (key-binding (kbd "w")) #'evil-forward-word-begin)))
          (with-temp-buffer
            (pichat-sessions-mode)
            (should (pichat-view-evil-normal-p))
            (should (eq evil-state 'normal))
            (dolist (binding '(("q" . pichat-sessions-return-to-chat)
                               ("RET" . pichat-sessions-activate-at-point)
                               ("j" . pichat-sessions-next-entry)
                               ("k" . pichat-sessions-previous-entry)
                               ("z a" . pichat-sessions-toggle-fold-at-point)
                               ("z v" . pichat-sessions-preview-branch-at-point)
                               ("g r" . pichat-sessions-list-refresh)
                               ("/" . evil-search-forward)
                               ("v" . evil-visual-char)))
              (should (eq (key-binding (kbd (car binding))) (cdr binding)))))
          (with-temp-buffer
            (pichat-sessions-preview-mode)
            (should (eq (key-binding (kbd "q")) #'pichat-view-quit))
            (should (eq (key-binding (kbd "f")) #'evil-find-char)))
          (with-temp-buffer
            (pichat-session-manager-mode)
            (should (eq evil-state 'normal))
            (should (eq (key-binding (kbd "q")) #'pichat-session-manager-quit))
            (should (eq (key-binding (kbd "RET"))
                        #'pichat-session-manager-open-chat))
            (should (eq (key-binding (kbd "g r"))
                        #'pichat-session-manager-refresh))
            (should (eq (key-binding (kbd "z v"))
                        #'pichat-session-manager-toggle-preview))
            (dolist (binding
                     '(("g c" . pichat-session-manager-new)
                       ("g C" . pichat-session-manager-new-in-scope)
                       ("g L" . pichat-session-manager-launch)
                       ("g b" . pichat-session-manager-browse-saved)
                       ("g k" . pichat-session-manager-stop)
                       ("g d" . pichat-session-manager-forget)
                       ("g m" . pichat-session-manager-make-default)
                       ("g D" . pichat-session-manager-diagnostics)
                       ("r" . pichat-session-manager-name)))
              (should (eq (key-binding (kbd (car binding))) (cdr binding))))
            (should (eq (key-binding (kbd "C-o")) #'evil-jump-backward)))
          (with-temp-buffer
            (pichat-session-manager-preview-mode)
            (should (eq (key-binding (kbd "q"))
                        #'pichat-session-manager-preview-quit)))
          (dolist (mode '(pichat-diagnostics-mode pichat-transport-diagnostics-mode))
            (with-temp-buffer
              (funcall mode)
              (should (eq evil-state 'normal))
              (should (eq (key-binding (kbd "q")) #'pichat-view-quit))
              (should (eq (key-binding (kbd "g r")) #'pichat-diagnostics-refresh))
              (should (eq (key-binding (kbd "r"))
                          (if (eq mode 'pichat-diagnostics-mode)
                              #'pichat-diagnostics-show-raw #'undefined)))
              ;; Do not take over Vim's g prefix or unrelated navigation.
              (should (eq (key-binding (kbd "g g")) #'evil-goto-first-line))
              (should (eq (key-binding (kbd "/")) #'evil-search-forward))
              (should (eq (key-binding (kbd "w")) #'evil-forward-word-begin))
              (should (eq (key-binding (kbd "s"))
                          (if (eq mode 'pichat-diagnostics-mode)
                              #'pichat-diagnostics-setup #'undefined)))
              (evil-emacs-state)
              (should (eq (key-binding (kbd "g")) #'pichat-diagnostics-refresh))
              (should (eq (key-binding (kbd "q")) #'pichat-view-quit))))
          (with-temp-buffer
            (pichat-response-view-mode)
            (should (eq (key-binding (kbd "q")) #'pichat-view-quit))
            (should (eq (key-binding (kbd "g r"))
                        #'pichat-response-view-refresh))
            (should (eq (key-binding (kbd "]r"))
                        #'pichat-response-view-next))
            (should (eq (key-binding (kbd "[r"))
                        #'pichat-response-view-previous))
            (should (eq (key-binding (kbd "n")) #'evil-search-next))
            (should (eq (key-binding (kbd "N")) #'evil-search-previous)))
          (with-temp-buffer
            (require 'pichat-jobs)
            (pichat-jobs-detail-mode)
            (should (eq (key-binding (kbd "g r")) #'pichat-jobs-detail-refresh))
            (should (eq (key-binding (kbd "g a")) #'pichat-jobs-actions))
            (should (eq (key-binding (kbd "a")) #'evil-append))
            (should (eq (key-binding (kbd "TAB")) #'pichat-jobs-detail-tab))
            (let ((inhibit-read-only t)
                  (pichat-response-view-convert-function
                   (lambda (_) "<a href='https://example.test'>Safe link</a> <a href='javascript:bad()'>Unsafe link</a>")))
              (pichat-jobs--insert-instructions (make-string 800 ?x))
              (pichat-jobs--disclosure 'execution "Details")
              (insert (pichat-response-view-render-markdown "Links" 60)))
            (let (opened)
              (cl-letf (((symbol-function 'pichat-jobs--render-detail) #'ignore)
                        ((symbol-function 'browse-url) (lambda (url &rest _) (push url opened))))
                (dolist (control '(("xxx" . task) ("Details" . execution)))
                  (dolist (key '("TAB" "<tab>" "RET"))
                    (pichat-test-job-goto-button (car control))
                    (call-interactively (key-binding (kbd key)))
                    (should (member (cdr control) pichat-jobs--expanded))
                    (call-interactively (key-binding (kbd key)))
                    (should-not (member (cdr control) pichat-jobs--expanded))))
                (dolist (key '("TAB" "<tab>" "<backtab>" "S-TAB" "S-<tab>"))
                  (pichat-test-job-goto-button "Safe link")
                  (call-interactively (key-binding (kbd key)))
                  (should-not pichat-jobs--expanded)
                  (should-not opened))
                (pichat-test-job-goto-button "Safe link")
                (call-interactively (key-binding (kbd "RET")))
                (should (equal opened '("https://example.test")))
                (setq opened nil)
                (pichat-test-job-goto-button "Unsafe link")
                (should-error (call-interactively (key-binding (kbd "RET"))) :type 'user-error)
                (should-not opened)))
            (goto-char (point-min))
            (should (eq (key-binding (kbd "g y")) #'pichat-jobs-copy-response))
            (should (eq (key-binding (kbd "w")) #'evil-forward-word-begin))
            (should (eq (key-binding (kbd "n")) #'evil-search-next))
            (should (eq (key-binding (kbd "q")) #'pichat-view-quit)))
          (with-temp-buffer
            (pichat-job-composer-review-mode)
            (should (eq (key-binding (kbd "q")) #'pichat-job-composer-inspection-return))
            (should (eq (key-binding (kbd "w")) #'evil-forward-word-begin)))
          (pichat-test-with-job-executor ()
            (with-temp-buffer
              (pichat-jobs-mode)
              (should (eq (key-binding (kbd "g i")) #'pichat-job-definitions))
              (setq pichat-jobs--owner executor)
              (pichat-jobs-refresh)
              (should (string-match-p "attention (g a)" mode-line-process))
              (call-interactively (key-binding (kbd "g a")))
              (should pichat-jobs--attention-only)
              (call-interactively (key-binding (kbd "g a")))
              (should-not pichat-jobs--attention-only)
              (call-interactively (key-binding (kbd "<tab>")))
              (should (eq pichat-jobs--kind 'jobs))
              (evil-emacs-state)
              (pichat-jobs-refresh)
              (should (string-match-p "attention (a)" mode-line-process))))
          (with-temp-buffer
            (pichat-artifact-elisp-result-mode)
            (should (eq evil-state 'normal))
            (should (eq (key-binding (kbd "s")) #'pichat-artifact-result-share))
            (should (eq (key-binding (kbd "g y"))
                        #'pichat-artifact-result-copy-report))
            (should (eq (key-binding (kbd "w")) #'evil-forward-word-begin))
            (should (eq (key-binding (kbd "q")) #'pichat-view-quit)))
          (with-temp-buffer
            (pichat-artifact-runner-result-mode)
            (should (eq evil-state 'normal))
            (should (eq (key-binding (kbd "s")) #'pichat-artifact-result-share))
            (should (eq (key-binding (kbd "g y"))
                        #'pichat-artifact-result-copy-report))
            (should (eq (key-binding (kbd "w")) #'evil-forward-word-begin))
            (should (eq (key-binding (kbd "q")) #'pichat-view-quit)))
          (with-temp-buffer
            (pichat-response-view-mode)
            (let ((inhibit-read-only t))
              (insert (propertize "one two" 'keymap
                                  pichat-response-view-link-map)))
            (goto-char (point-min))
            (should (eq (key-binding (kbd "w"))
                        #'pichat-response-view-link-word-or-copy))
            (call-interactively (key-binding (kbd "w")))
            (should (> (point) (point-min)))
            (let (searched)
              (cl-letf (((symbol-function 'evil-search-backward)
                         (lambda () (interactive) (setq searched t))))
                (call-interactively (key-binding (kbd "?"))))
              (should searched)))
          (save-window-excursion
            (let ((origin (generate-new-buffer " *pichat-evil-origin*"))
                  (snapshot (generate-new-buffer " *pichat-evil-snapshot*")))
              (unwind-protect
                  (progn
                    (switch-to-buffer origin)
                    (with-current-buffer snapshot (pichat-view-mode))
                    (pichat-view-display snapshot nil 'kill)
                    (call-interactively (key-binding (kbd "q")))
                    (should-not (buffer-live-p snapshot))
                    (should (eq origin (window-buffer (selected-window)))))
                (dolist (buffer (list origin snapshot))
                  (when (buffer-live-p buffer) (kill-buffer buffer))))))
          (with-temp-buffer
            (if (require 'markdown-mode nil t)
                (markdown-mode)
              (text-mode))
            (pichat-artifacts-preview-mode 1)
            (should (eq evil-state 'normal))
            (should (eq (key-binding (kbd "q")) #'pichat-view-quit))))
      (dolist (entry previous)
        (evil-set-initial-state (car entry) (cdr entry)))
      (mapc #'kill-buffer open-inspectors)
      (setq pichat-artifacts-preview-mode-hook previous-preview-hook)
      (unless was-active (evil-mode -1)))))

(provide 'pichat-test-evil)
;;; pichat-test-evil.el ends here

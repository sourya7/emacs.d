        (pichat-job--render-setup)
        (should-not (string-match-p "ORIGINAL_END\\|GUIDANCE_END" (buffer-string)))
        ;; Setup TAB navigates; it does not toggle a block or submit anything.
        (goto-char (text-property-any (point-min) (point-max) 'pichat-job-section 'task))
        (call-interactively (key-binding (kbd "TAB")))
        (should-not pichat-jobs--expanded)
        (dolist (key '(guidance task))
          (goto-char (text-property-any (point-min) (point-max) 'pichat-job-section key))
          (call-interactively (key-binding (kbd "RET")))
          (should (member key pichat-jobs--expanded))
          (should (string-match-p "GUIDANCE_END" (buffer-string)))
          (when (eq key 'guidance)
            (should-not (string-match-p "ORIGINAL_END" (buffer-string)))))

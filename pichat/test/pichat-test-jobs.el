(ert-deftest pichat-job-import-updates-preserve-timing-followup-queued-history-and-evidence ()
  (pichat-test-with-job-executor ()
    (let* ((record (pichat-test-job-author project-dir))
           (job (pichat-job-import-commit (pichat-job-import-prepare store record)))
           (native (pichat-job-save store (pichat-test-job-spec project-dir)))
           (native-before (pichat-job-record store 'jobs native))
           (history (pichat-job-enqueue store nil job))
           (claim (pichat-job-claim store history))
           (evidence (pichat-job-evidence-save store '(:version 1 :response "Original λ" :transcript "Original tools"))))
      (pichat-job-advance store history (plist-get claim :attempt) "finished"
                          (list :result "failed" :safe-to-release t :evidence evidence))
      (let ((spec (plist-get (pichat-job-record store 'jobs job) :spec)))
        (setf (plist-get spec :after-job-id) native
              (plist-get spec :resources) [(:key "legacy" :access "write")])
        (pichat-job-save store spec job))
      (pichat-job-schedule-set store job (list :kind "once" :start (+ (float-time) 3600)))
      (pichat-job-schedule-enable store job t)
      (pichat-job-enqueue store nil job)
      (let ((runs (pichat-job-records store 'runs))
            (schedule (plist-get (pichat-job-record store 'jobs job) :schedule))
            (captured (pichat-job-evidence-read store evidence)))
        (setq record (pichat-test-job-author project-dir :instructions "Updated instructions λ"))
        (let ((review (pichat-job-import-prepare store record)))
          (should-not (pichat-job-import-review-diverged review))
          (should (equal (pichat-job-import-commit review) job)))
        (let ((saved (pichat-job-record store 'jobs job)))
          (should (equal (plist-get saved :schedule) schedule))
          (should (equal (plist-get (plist-get saved :spec) :after-job-id) native))
          (should (equal (plist-get (plist-get saved :spec) :resources) [(:key "legacy" :access "write")])))
        (should (equal runs (pichat-job-records store 'runs)))
        (should (equal captured (pichat-job-evidence-read store evidence)))
        (should (equal native-before (pichat-job-record store 'jobs native)))))))


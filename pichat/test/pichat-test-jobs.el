(ert-deftest pichat-job-captured-ssh-cleanup-keeps-claims-until-exit-proof ()
  (pichat-test-with-owned-job
    (setf (pichat-session-transport session)
          (pichat-transport--create :id "test" :kind 'ssh :label "test"
                                    :tramp-prefix "/ssh:invalid.example:"))
    (let* ((cache (pichat-pi-entry-cache-full
                   "pi-source" "/example/session.jsonl"
                   '((:type "message" :id "final" :parentId nil
                      :message (:role "assistant" :content ((:type "text" :text "Captured response"))
                                :stopReason "stop"))) "final"))
           (payload (list :cache cache :settlement-sequence 1 :process-generation 1
                          :session-id "pi-source" :session-file "/example/session.jsonl"))
           (observers 0) callbacks ready receipt stopped)
      (setf (pichat-session-state session) 'idle
            (pichat-job-execution-settled execution) t
            (pichat-job-execution-settlement execution) 1)
      (pichat-job-executor--advance execution "running")
      (pichat-job-executor--advance execution "settling")
      (cl-letf (((symbol-function 'pichat-process-lifetime-supported-p) (lambda (_) t))
                ((symbol-function 'pichat-process-lifetime-watch)
                 (lambda (_transport _cwd _process _seconds _live r callback)
                   (cl-incf observers) (setq ready r receipt callback) #'ignore))
                ((symbol-function 'pichat-job-executor--call)
                 (lambda (_execution _type _payload callback) (push callback callbacks)))
                ((symbol-function 'pichat-backend-stop-session) (lambda (_) (setq stopped t))))
        ;; Both sync notifications qualify before either idle-state reply arrives.
        (pichat-job-executor--synchronized execution payload)
        (pichat-job-executor--synchronized execution payload)
        (dolist (callback (reverse callbacks)) (funcall callback nil))
        (should (= observers 1))
        (should-not stopped)
        (should (equal (plist-get (pichat-job-executor--run execution) :state) "settling"))
        (should-error (pichat-job-executor-cancel executor id) :type 'user-error)
        (funcall ready)
        (should stopped)
        (funcall receipt nil "Remote exit not confirmed")
        (let ((run (pichat-job-executor--run execution)))
          (should (equal (plist-get run :state) "uncertain"))
          (should (equal (plist-get (pichat-job-evidence-read store (plist-get run :evidence)) :response)
                         "Captured response"))
          (should-not (plist-get run :result)))))))

(ert-deftest pichat-jobs-disclosure-and-action-keys-stay-local-without-executing-navigation ()
  (pichat-test-with-job-views
    (let* ((spec (pichat-test-job-spec project-dir))
           (_ (setf (plist-get spec :instructions)
                    "First instruction\nsecond\nthird\nfourth\nfifth\nsixth\nseventh"))
           (job (pichat-job-save store spec))
           (run (pichat-job-enqueue store nil job))
           (token (plist-get (pichat-job-claim store run) :attempt))
           (digest (pichat-job-evidence-save
                    store '(:version 1 :response "Links" :transcript "Captured conversation")))
           (pichat-response-view-convert-function
            (lambda (_) "<p><a href='https://example.test'>Safe link</a> <a href='javascript:bad()'>Unsafe link</a></p>"))
           opened)
      (pichat-job-advance store run token "running" '(:session-file "/captured/session.jsonl"))
      (pichat-job-advance store run token "settling" (list :evidence digest))
      (pichat-job-advance store run token "finished"
                          '(:result "completed" :safe-to-release t :synchronized t))
      (let ((before (list (pichat-job-records store 'jobs) (pichat-job-records store 'runs))))
        (cl-letf (((symbol-function 'pichat-rpc-send) (lambda (&rest _) (ert-fail "Sent RPC")))
                  ((symbol-function 'pichat-start-prepared-session) (lambda (&rest _) (ert-fail "Started Pi")))
                  ((symbol-function 'pichat-job-executor-submit) (lambda (&rest _) (ert-fail "Submitted work")))
                  ((symbol-function 'browse-url) (lambda (url &rest _) (push url opened))))
          (dolist (case (list (list 'jobs job 'definition "Details"
                                    '("Completed ·"))
                             (list 'runs run 'execution "Details"
                                   '("Safe link" "Unsafe link"))))
            (cl-destructuring-bind (kind id section label actions) case
              (pichat-jobs--show-detail executor kind id)
              (when (eq kind 'runs) (pichat-test-job-press label))
              (dolist (control (list (cons "First instruction" 'task) (cons label section)))
                (dolist (key '("TAB" "<tab>" "RET"))
                  (pichat-test-job-goto-button (car control))
                  (call-interactively (key-binding (kbd key)))
                  (should (member (cdr control) pichat-jobs--expanded))
                  (when (eq (cdr control) section)
                    (should-not (member 'task pichat-jobs--expanded)))
                  ;; Repeated TAB must operate on the same control, not wrap.
                  (call-interactively (key-binding (kbd key)))
                  (should-not (member (cdr control) pichat-jobs--expanded)))
                (dolist (key '("<backtab>" "S-TAB" "S-<tab>"))
                  (pichat-test-job-goto-button (car control))
                  (call-interactively (key-binding (kbd key)))
                  (should-not (member (cdr control) pichat-jobs--expanded)))
                (when (and (eq kind 'runs) (eq (cdr control) 'task))
                  (pichat-test-job-press label)))
              (pichat-test-job-press label)
              (let (original-actions)
                (dolist (action actions)
                  (let ((button (pichat-test-job-goto-button action)))
                    (push (cons button (button-get button 'action)) original-actions)
                    (let ((inhibit-read-only t))
                      (button-put button 'action (lambda (_) (ert-fail "Navigation activated a button"))))))
                (dolist (action actions)
                  (dolist (key '("TAB" "<tab>" "<backtab>" "S-TAB" "S-<tab>"))
                    (dolist (at-end '(nil t))
                      (let ((button (pichat-test-job-goto-button action))
                            (expanded (copy-sequence pichat-jobs--expanded)))
                        (when at-end (goto-char (button-end button)))
                        (call-interactively (key-binding (kbd key)))
                        (should (equal expanded pichat-jobs--expanded))))))
                (let ((inhibit-read-only t))
                  (dolist (original original-actions)
                    (button-put (car original) 'action (cdr original)))))
              (should-not opened)
              (when (eq kind 'runs)
                (pichat-test-job-goto-button "Safe link")
                (call-interactively (key-binding (kbd "RET")))
                (should (equal opened '("https://example.test")))
                (setq opened nil)
                (pichat-test-job-goto-button "Unsafe link")
                (should-error (call-interactively (key-binding (kbd "RET"))) :type 'user-error)
                (should-not opened))))
          (should (equal before (list (pichat-job-records store 'jobs) (pichat-job-records store 'runs)))))))))

(ert-deftest pichat-jobs-setup-tab-navigation-does-not-edit-submit-or-save ()
  (pichat-test-with-job-views
    (pichat-job--setup (pichat-test-job-spec project-dir) nil executor)
    (let ((setup (current-buffer)) (before (pichat-presets--copy pichat-job--draft))
          (labels '("Edit instructions…" "Change project…" "Execution settings…" "Change…" "Run once" "Save job…" "Cancel")))
      (cl-letf (((symbol-function 'pichat-rpc-send) (lambda (&rest _) (ert-fail "Sent RPC")))
                ((symbol-function 'pichat-start-prepared-session) (lambda (&rest _) (ert-fail "Started Pi")))
                ((symbol-function 'pichat-job-executor-submit) (lambda (&rest _) (ert-fail "Submitted work"))))
        (dolist (key '("TAB" "<tab>" "<backtab>" "S-TAB" "S-<tab>"))
          (let ((backward (not (member key '("TAB" "<tab>")))) seen)
            (goto-char (if backward (point-max) (point-min)))
            (dotimes (_ (length labels))
              (call-interactively (key-binding (kbd key)))
              (push (button-label (button-at (point))) seen))
            (should (equal (nreverse seen) (if backward (reverse labels) labels)))))
        (should (eq setup (current-buffer)))
        (should (equal before pichat-job--draft))
        (should (equal (pichat-job-records store 'jobs) []))
        (should (equal (pichat-job-records store 'runs) []))
        ;; The plain instruction editor keeps ordinary text editing, not folds.
        (pichat-job-edit-instructions)
        (should (derived-mode-p 'text-mode))
        (should-not (eq (key-binding (kbd "TAB")) #'pichat-jobs-detail-tab))
        (goto-char (point-max))
        (call-interactively (key-binding (kbd "RET")))
        (call-interactively (key-binding (kbd "TAB")))
        (call-interactively (key-binding (kbd "C-c C-k")))
        (should (eq setup (current-buffer)))
        (should (equal before pichat-job--draft))))))

(ert-deftest pichat-jobs-instructions-fold-at-five-visual-lines-and-toggle-with-tab ()

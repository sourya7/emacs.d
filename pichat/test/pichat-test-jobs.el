  (ert-deftest pichat-integration-job-pre-settlement-snapshot-cannot-complete-run ()
    (pichat-test-with-job-executor
        (:script '(:turns [(:text "POST_SETTLEMENT_RESULT" :delayMs 200)]))
      (let ((original (symbol-function 'pichat-backend-get-transcript))
            held intercept id execution)
        (cl-letf (((symbol-function 'pichat-backend-get-transcript)
                   (lambda (session cursor success &optional failure)
                     (if intercept (funcall original session cursor success failure)
                       (setq intercept t)
                       (funcall original session cursor
                                (lambda (response session)
                                  (setq held (lambda () (funcall success response session))))
                                failure)))))
          (setq id (pichat-job-executor-submit executor (pichat-test-job-spec project-dir "read"))
                execution (gethash id (pichat-job-executor-contexts executor)))
          (pichat-test-wait-until (lambda () (and held (pichat-job-execution-settled execution))))
          (should (equal (plist-get (pichat-job-record store 'runs id) :state) "settling"))
          (funcall held)
          (pichat-test-job-wait store id "finished")
          (should (string-match-p "POST_SETTLEMENT_RESULT"
                                  (plist-get (pichat-job-record store 'runs id) :summary)))
          (pichat-test-assert-provider-script-consumed status-file)))))


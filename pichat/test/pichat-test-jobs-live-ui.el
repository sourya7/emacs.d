(ert-deftest pichat-integration-jobs-live-ui-date-picker ()
  (should-not noninteractive)
  (let* ((process-environment (cons "TZ=UTC" process-environment))
         (org-read-date-popup-calendar t)
         (today (decode-time))
         (expected (float-time (encode-time 0 0 9 (1+ (nth 3 today))
                                            (nth 4 today) (nth 5 today)))))
    (save-window-excursion
      (minibuffer-with-setup-hook
          (lambda ()
            (should (get-buffer-window calendar-buffer))
            (setq unread-command-events
                  (append (listify-key-sequence "+1d 09:00\r") unread-command-events)))
        (should (= expected (pichat-job-schedule-ui-read-time))))
      (minibuffer-with-setup-hook
          (lambda ()
            (setq unread-command-events
                  (append (listify-key-sequence (kbd "S-<right>"))
                          (listify-key-sequence "09:00\r") unread-command-events)))
        (should (= expected
                   (pichat-job-schedule-ui-read-time
                    (float-time (encode-time 0 0 12 (nth 3 today)
                                             (nth 4 today) (nth 5 today)))))))
      (minibuffer-with-setup-hook
          (lambda ()
            (setq unread-command-events
                  (append (listify-key-sequence (kbd "C-g")) unread-command-events)))
        (should (eq 'cancelled
                    (condition-case nil (pichat-job-schedule-ui-read-time)
                      (quit 'cancelled)))))
      (should-not (get-buffer-window calendar-buffer)))))

(ert-deftest pichat-integration-jobs-live-ui-conversation-schedule ()
  (should-not noninteractive)
  (pichat-test-with-job-executor (:script '(:turns [(:text "LIVE_CONVERSATION_RESULT")]))
    (let* ((session (pichat-test-job-conversation-start project-dir))
           (chat (pichat-session-buffer session))
           (process (pichat-session-process session))
           (pichat-jobs--executor executor) (pichat-jobs-file (pichat-job-store-file store))
           (transient-history nil)
           (transient-history-file (expand-file-name "transient-history.el" agent-dir)))
      (unwind-protect
          (progn
            (pop-to-buffer chat)
            (pichat-chat-draft-replace (pichat-chat-draft-capture) "Keep this draft")
            (setq pichat-chat--pending-attachments '(fixture-image))
            (execute-kbd-macro (kbd "M-x pichat-job-schedule-continuation RET"))
            (should (eq (oref transient--prefix command) 'pichat-job-edit-menu))
            (let ((menu (with-current-buffer (get-buffer " *transient*") (buffer-string))))
              (should (string-match-p "This conversation" menu))
              (should (string-match-p "Choose a time" menu))
              (should-not (string-match-p "Run once\\|Save job\\|Preset:" menu)))
            (execute-kbd-macro (kbd "i"))
            (erase-buffer) (insert "Discard this staged text")
            (execute-kbd-macro (kbd "C-c C-k"))
            (should (equal "continue" (plist-get (plist-get (transient-scope) :draft) :instructions)))
            (execute-kbd-macro (kbd "q"))
            (should (equal [] (pichat-job-records store 'runs)))
            (execute-kbd-macro (kbd "M-x pichat-job-schedule-continuation RET"))
            (execute-kbd-macro (kbd "i"))
            (erase-buffer) (insert "continue reviewed")
            (execute-kbd-macro (kbd "C-c C-c"))
            (cl-letf (((symbol-function 'read-string)
                       (lambda (&rest _) (format-time-string "%Y-%m-%d %H:%M" (seconds-to-time (+ (float-time) 3600))))))
              (execute-kbd-macro (kbd "w")))
            (let ((scope (transient-scope)))
              (execute-kbd-macro (kbd "s"))
              (pichat-test-wait-until (lambda () (plist-get scope :submitted-run-id)) 5 "live schedule authorization")
              (set-buffer (window-buffer (selected-window)))
              (should (equal pichat-jobs--detail (cons 'runs (plist-get scope :submitted-run-id))))
              (should (string-match-p "Scheduled for:" (buffer-string)))
              (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
                (pichat-test-job-press "Cancel run…"))
              (should (equal "cancelled" (plist-get (pichat-job-record store 'runs (plist-get scope :submitted-run-id)) :result))))
            (pop-to-buffer chat)
            (execute-kbd-macro (kbd "M-x pichat-job-schedule-continuation RET"))
            ;; Use real When/Schedule keys with a short fixture instant, avoiding
            ;; a wall-clock minute wait after testing the actual parser above.
            (cl-letf (((symbol-function 'pichat-job-schedule-ui-read-time) (lambda (&rest _) (+ (float-time) 0.6))))
              (execute-kbd-macro (kbd "w")))
            (let ((scope (transient-scope)))
              (execute-kbd-macro (kbd "s"))
              (pichat-test-wait-until (lambda () (plist-get scope :submitted-run-id)) 5 "live second schedule")
              (pichat-test-job-wait store (plist-get scope :submitted-run-id) "finished")
              (set-buffer (window-buffer (selected-window)))
              (should (string-match-p "LIVE_CONVERSATION_RESULT" (buffer-string)))
              (dolist (label '("Repeat…" "Continue work…" "Save as job…"))
                (should-not (member label (pichat-test-job-actions)))))
            (with-current-buffer chat
              (should (equal "Keep this draft" (pichat-chat-draft-text (pichat-chat-draft-capture))))
              (should (equal '(fixture-image) pichat-chat--pending-attachments)))
            (should (eq process (pichat-session-process session)))
            (should (pichat-session-alive-p session))
            (should-not (pichat-session-input-guard session))
            (pichat-test-assert-provider-script-consumed status-file))
        (when transient--prefix (transient-quit-all))))))


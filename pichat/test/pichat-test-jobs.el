					 (should (string-match-p "▌" (get-text-property start 'wrap-prefix)))
					 (should-not (get-text-property start 'pichat-live-prompt))
					 ;; Click/RET and TAB address the same block, not a separate disclosure.
					 (button-activate button))
				       (should (string-match-p (regexp-quote instructions) (buffer-string)))

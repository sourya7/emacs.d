(ert-deftest pichat-job-launch-capture-never-starts-or-selects-runtime ()
  (pichat-test-with-job-executor ()
    (let* ((current (pichat-session-make))
           (pichat-current-session current)
           (before (window-list))
           (spec (pichat-test-job-spec project-dir)))
      (should (equal (pichat-session-list) nil))
      (should (eq pichat-current-session current))
      (should (equal before (window-list)))
      (should (equal (plist-get (plist-get spec :configuration) :model)
                     "pichat-fake/pichat-fake")))))

(ert-deftest pichat-job-launch-roundtrip-does-not-resolve-changed-presets ()
  (pichat-test-with-job-executor ()
    (let* ((spec (pichat-test-job-spec project-dir))
           (job (pichat-job-save store spec))
           (spec (plist-get (pichat-job-record (pichat-job-store-open
                                               (pichat-job-store-file store))
                                              'jobs job) :spec))
           (pichat-presets nil)
           (pichat-targets nil)
           (pichat-pi-extra-args '("--something-new"))
           (prepared (pichat-job-launch-prepare spec))
           (runtime (car prepared))
           (command (cadr prepared)))
      (should-not (member "--something-new" command))
      (should (member "--session-dir" command))
      (should-not (member "--no-session" command))
      (should (equal (plist-get (pichat-session-preset-spec runtime) :name) 'review))
      (should (equal (plist-get (pichat-session-tool-selection runtime) :builtins)
                     '("read" "grep" "find" "ls"))))))

(ert-deftest pichat-job-launch-rejects-wrapper-and-rebinding-options ()

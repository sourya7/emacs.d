;;; pichat-test-chat-user-folding.el --- Submitted-message disclosure tests -*- lexical-binding: t; -*-

(require 'pichat-test-chat-support)

(defmacro pichat-test-user-fold-with-windows (&rest body)
  "Run BODY with isolated window and overriding-map state."
  (declare (indent 0))
  `(let ((overriding-terminal-local-map nil) (overriding-local-map nil))
     (save-window-excursion ,@body)))

(defun pichat-test-user-fold-transcript (texts &optional prefix)
  "Build user nodes from TEXTS with distinct PREFIX-qualified keys."
  (pichat-transcript-create
   :nodes (cl-loop for text in texts for index from 0
                   collect (pichat-transcript-node-create
                            :kind 'message :role 'user
                            :key (format "%s-%d" (or prefix "entry") index)
                            :content (list (pichat-transcript-content-create
                                            :kind 'prose :index 0 :text text))))))

(defun pichat-test-user-fold-project (transcript)
  "Project TRANSCRIPT through the real canonical transaction."
  (let ((context (pichat-chat--canonical-render-context transcript)))
    (pichat-chat--project-canonical
     nil transcript (pichat-render-canonical transcript context) context)
    (unless noninteractive (redisplay t))))

(defun pichat-test-user-fold-controls ()
  "Return submitted-message disclosure overlays in buffer order."
  (sort (cl-remove-if-not
         (lambda (overlay) (overlay-get overlay 'pichat-user-choice))
         pichat-chat-user-ui--overlays)
        (lambda (a b) (< (overlay-start a) (overlay-start b)))))

(ert-deftest pichat-user-fold-short-boundaries-and-full-copy-are-nondestructive ()
  (pichat-test-user-fold-with-windows
    (pichat-test-with-unit-session (session proc)
      (pichat-test-with-chat-buffer (buffer session)
        (switch-to-buffer buffer)
        (dolist (text '("short…" "one\ntwo\nthree\nfour\nfive"
                        "one\ntwo\nthree\nfour\nfive\nsix"))
          (pichat-test-user-fold-project (pichat-test-user-fold-transcript (list text)))
          (let ((controls (pichat-test-user-fold-controls)))
            (if (equal text "one\ntwo\nthree\nfour\nfive\nsix")
                (let* ((overlay (car controls))
                       (suffix (overlay-get overlay 'pichat-user-suffix))
                       (before (buffer-string)))
                  (should (= 1 (length controls)))
                  (should (equal "…" (overlay-get suffix 'display)))
                  (goto-char (overlay-start overlay))
                  (pichat-chat-user-ui-copy)
                  (should (equal text (current-kill 0 t)))
                  (dolist (key '("RET" "TAB" "<tab>"))
                    (let ((undo (copy-tree buffer-undo-list)))
                      (call-interactively (key-binding (kbd key)))
                      (should (equal undo buffer-undo-list)))
                    (should (equal-including-properties before (buffer-string))))
                  (should (overlay-get overlay 'pichat-user-expanded))
                  (should (equal "  Show less" (overlay-get overlay 'after-string)))
                  ;; Region copy includes the hidden projected source and bars.
                  (should (string-match-p "six" (buffer-substring-no-properties
                                                 (overlay-start overlay) (overlay-end overlay)))))
              (should-not controls))))))))

(ert-deftest pichat-user-fold-wrapping-resize-and-duplicate-choices ()
  (pichat-test-user-fold-with-windows
    (delete-other-windows)
    (pichat-test-with-unit-session (session proc)
      (pichat-test-with-chat-buffer (buffer session)
        (switch-to-buffer buffer)
        (let* ((text (mapconcat (lambda (_) "word") (number-sequence 1 40) " "))
               (transcript (pichat-test-user-fold-transcript (list text text))))
          (let ((narrow (split-window-right -30)))
            (set-window-buffer narrow buffer)
            (pichat-test-user-fold-project transcript)
            (let* ((controls (pichat-test-user-fold-controls)) (first (car controls)))
              (should (= 2 (length controls)))
              (goto-char (overlay-start first))
              (pichat-chat-user-ui-toggle)
              (let ((point-before (point))
                    (undo (copy-tree buffer-undo-list))
                    (draft (pichat-chat--input-text)))
                (pichat-chat--reproject-display-options)
                (should (overlay-get (car (pichat-test-user-fold-controls)) 'pichat-user-expanded))
                (should-not (overlay-get (cadr (pichat-test-user-fold-controls)) 'pichat-user-expanded))
                (delete-window narrow)
                (pichat-chat--resize-user-disclosures nil)
                (unless noninteractive (redisplay t))
                (should-not (pichat-test-user-fold-controls))
                (set-window-buffer (split-window-right -30) buffer)
                (pichat-chat--resize-user-disclosures nil)
                (unless noninteractive (redisplay t))
                (should (overlay-get (car (pichat-test-user-fold-controls)) 'pichat-user-expanded))
                (should (= point-before (point)))
                (should (equal draft (pichat-chat--input-text)))
                (should (equal undo buffer-undo-list))))))))))

(ert-deftest pichat-user-fold-live-choice-survives-settlement-and-resets-on-rebinding ()
  (pichat-test-user-fold-with-windows
    (pichat-test-with-unit-session (session proc)
      (pichat-test-with-chat-buffer (buffer session)
        (switch-to-buffer buffer)
        (let* ((text "one\ntwo\nthree\nfour\nfive\nsix")
               (event (list :type "message_end" :message
                            (list :role "user" :content (list (list :type "text" :text text))))))
          (pichat-test-apply-live-events pichat-chat--live-draft event)
          (goto-char (overlay-start (car (pichat-test-user-fold-controls))))
          (pichat-chat-user-ui-toggle)
          (pichat-chat--project-live-tail)
          (should (overlay-get (car (pichat-test-user-fold-controls)) 'pichat-user-expanded))
          (pichat-test-user-fold-project (pichat-test-user-fold-transcript (list text)))
          (should (overlay-get (car (pichat-test-user-fold-controls)) 'pichat-user-expanded))
          ;; Content validation prevents an ordinal from expanding changed text.
          (pichat-test-user-fold-project (pichat-test-user-fold-transcript (list (concat text " changed"))))
          (should-not (overlay-get (car (pichat-test-user-fold-controls)) 'pichat-user-expanded))
          (pichat-chat--reset-for-source "different" nil t)
          (should-not pichat-chat-user-ui--overlays)
          (pichat-test-user-fold-project (pichat-test-user-fold-transcript (list text)))
          (should-not (overlay-get (car (pichat-test-user-fold-controls)) 'pichat-user-expanded)))))))

(ert-deftest pichat-user-fold-keeps-attachments-and-skill-disclosures-independent ()
  (pichat-test-user-fold-with-windows
    (pichat-test-with-unit-session (session proc)
      (pichat-test-with-chat-buffer (buffer session)
        (switch-to-buffer buffer)
        (let* ((text "one\ntwo\nthree\nfour\nfive\nsix")
               (skill "<skill name=\"example\" location=\"/tmp/example\">\none\ntwo\nthree\nfour\nfive\nsix\n</skill>")
               (transcript (pichat-test-user-fold-transcript (list text skill))))
          (setf (pichat-transcript-node-content (car (pichat-transcript-nodes transcript)))
                (append (pichat-transcript-node-content (car (pichat-transcript-nodes transcript)))
                        (list (pichat-transcript-content-create :kind 'image :index 1 :text "[image]"))))
          (pichat-test-user-fold-project transcript)
          (should (= 1 (length (pichat-test-user-fold-controls))))
          (goto-char (point-min))
          (search-forward "[image]")
          (should-not (cl-some (lambda (o) (overlay-get o 'display)) (overlays-at (1- (point)))))
          (goto-char (point-min))
          (search-forward "[skill] example")
          (backward-char)
          (pichat-chat-toggle-skill-at-point)
          (should (= 1 (length (pichat-test-user-fold-controls)))))))))

(ert-deftest pichat-user-fold-draft-stays-expanded-and-projection-rollback-restores-disclosures ()
  (pichat-test-user-fold-with-windows
    (pichat-test-with-unit-session (session proc)
      (pichat-test-with-chat-buffer (buffer session)
        (switch-to-buffer buffer)
        (let* ((text "one\ntwo\nthree\nfour\nfive\nsix")
               (transcript (pichat-test-user-fold-transcript (list text))))
          (goto-char (point-max))
          (insert text)
          (pichat-test-user-fold-project transcript)
          (let ((overlay (car (pichat-test-user-fold-controls))))
            (goto-char (overlay-start overlay))
            (pichat-chat-user-ui-toggle))
          (let ((before (buffer-string)))
            (cl-letf (((symbol-function 'pichat-chat--index-canonical-tools)
                       (lambda (&rest _) (error "Injected projection failure"))))
              (should-error (pichat-test-user-fold-project transcript)))
            (should (equal-including-properties before (buffer-string))))
          (should (overlay-get (car (pichat-test-user-fold-controls)) 'pichat-user-expanded))
          (goto-char (point-max))
          (should (equal text (pichat-chat--input-text)))
          (should-not (pichat-chat-user-ui--at-point))
          (should (eq (key-binding (kbd "RET")) 'pichat-chat-ret))
          (should-not (cl-intersection (overlays-in pichat-chat--input-start (point-max))
                                      pichat-chat-user-ui--overlays)))))))

(ert-deftest pichat-user-fold-wide-text-tabs-and-source-ellipsis-fit-five-lines ()
  (pichat-test-user-fold-with-windows
    (delete-other-windows)
    (select-window (split-window-right -30))
    (pichat-test-with-unit-session (session proc)
      (pichat-test-with-chat-buffer (buffer session)
        (switch-to-buffer buffer)
        (delete-other-windows)
        (select-window (split-window-right -30))
        (dolist (text (list (make-string 200 ?界)
                           (concat (make-string 200 ?x) "\t" (make-string 200 ?y))
                           (concat (make-string 200 ?x) "…")
                           "one\ntwo\nthree\nfour\nfive\nsix\n"))
          (pichat-test-user-fold-project (pichat-test-user-fold-transcript (list text)))
          (let* ((overlay (car (pichat-test-user-fold-controls)))
                 (cut (overlay-start (overlay-get overlay 'pichat-user-suffix)))
                 (preview (concat (buffer-substring (overlay-start overlay) cut) "…")))
            (with-temp-buffer
              (visual-line-mode 1)
              (let ((inhibit-read-only t)) (insert preview))
              (should (<= (count-screen-lines (point-min) (point-max) nil (selected-window)) 5)))
            (should (string-match-p (regexp-quote text)
                                   (pichat-chat-navigation-transcript-markdown
                                    pichat-chat--canonical-transcript)))))))))

(ert-deftest pichat-user-fold-click-on-show-less-controls-the-original-message ()
  (pichat-test-user-fold-with-windows
    (pichat-test-with-unit-session (session proc)
      (pichat-test-with-chat-buffer (buffer session)
        (switch-to-buffer buffer)
        (pichat-test-user-fold-project
         (pichat-test-user-fold-transcript '("one\ntwo\nthree\nfour\nfive\nsix")))
        (let ((overlay (car (pichat-test-user-fold-controls))))
          (goto-char (overlay-start overlay))
          (pichat-chat-user-ui-toggle)
          (let ((control (overlay-get overlay 'after-string)))
            (pichat-chat-user-ui-toggle
             (list 'mouse-1 (list (selected-window) (overlay-end overlay)
                                 '(0 . 0) 0 (cons control 2)))))
          (should-not (overlay-get overlay 'pichat-user-expanded))
          (should (<= (point) (overlay-start (overlay-get overlay 'pichat-user-suffix)))))))))

(ert-deftest pichat-user-fold-rejected-long-draft-never-fabricates-a-user-message ()
  (pichat-test-user-fold-with-windows
    (pichat-test-with-unit-session (session proc)
      (pichat-test-with-chat-buffer (buffer session)
        (switch-to-buffer buffer)
        (let ((text "one\ntwo\nthree\nfour\nfive\nsix") reject)
          (cl-letf (((symbol-function 'pichat-rpc-prompt)
                     (lambda (_session message &optional _images _behavior _success error)
                       (should (equal text message))
                       (setq reject error)
                       "rejected-long-draft")))
            (goto-char (point-max))
            (insert text)
            (pichat-chat-send-input))
          (should-not (pichat-test-user-fold-controls))
          (should-not (text-property-any (point-min) (point-max) 'pichat-node-role 'user))
          (funcall reject '(:id "rejected-long-draft" :success nil :error "rejected") session)
          (should (equal text (pichat-chat--input-text)))
          (should-not (pichat-test-user-fold-controls))
          (pichat-chat--set-input-text "")
          (pichat-chat-history-previous)
          (should (equal text (pichat-chat--input-text)))
          (pichat-chat--set-input-text "")
          (pichat-chat-input-restore-fork-text text)
          (should (equal text (pichat-chat--input-text)))
          (should-not (pichat-test-user-fold-controls)))))))

(ert-deftest pichat-user-fold-compose-and-draft-undo-selection-survive-resize ()
  (pichat-test-user-fold-with-windows
    (pichat-test-with-unit-session (session proc)
      (pichat-test-with-chat-buffer (buffer session)
        (switch-to-buffer buffer)
        (delete-other-windows)
        (let ((text "one\ntwo\nthree\nfour\nfive\nsix") compose)
          (unwind-protect
              (progn
                (pichat-test-user-fold-project (pichat-test-user-fold-transcript (list text)))
                (goto-char (point-max))
                (insert text)
                (setq buffer-undo-list nil)
                (undo-boundary)
                (insert " edited")
                (undo-boundary)
                (push-mark (- (point) 3) t t)
                (let ((before-point (point)) (before-mark (mark))
                      (before-undo (copy-tree buffer-undo-list)))
                  (set-window-buffer (split-window-right -30) buffer)
                  (pichat-chat--resize-user-disclosures nil)
                  (should (= before-point (point)))
                  (should (= before-mark (mark)))
                  (should (equal before-undo buffer-undo-list))
                  (should-not (pichat-chat-user-ui--at-point)))
                (let ((transient-mark-mode nil)) (undo 1))
                (should (equal text (pichat-chat--input-text)))
                (pichat-chat-open-compose-buffer)
                (setq compose (window-buffer (selected-window)))
                (with-current-buffer compose
                  (should (derived-mode-p 'pichat-chat-compose-mode))
                  (should (equal text (buffer-string)))
                  (goto-char (point-max))
                  (insert "\nfrom compose")
                  (pichat-chat-compose-apply))
                (with-current-buffer buffer
                  (should (equal (concat text "\nfrom compose") (pichat-chat--input-text)))
                  (goto-char (point-max))
                  (should-not (pichat-chat-user-ui--at-point))))
            (when (buffer-live-p compose) (kill-buffer compose))))))))


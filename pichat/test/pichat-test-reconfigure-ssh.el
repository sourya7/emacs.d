(ert-deftest pichat-reconfigure-ssh-recovery-confirms-original-and-failed-replacement ()
  (dolist (choice '(retry restore))
    (pichat-test-ssh-restart--run
     (lambda (fixture)
       (let* ((session (plist-get fixture :session))
              (original (plist-get fixture :original)))
         (plist-put fixture :rpc-error "switch_session")
         (pichat-test-ssh-restart--begin fixture)
         (pichat-test-ssh-restart--watch fixture 0 'ready)
         (pichat-test-ssh-restart--watch fixture 0 'done t)
         (pichat-test-wait-until (lambda () (plist-get fixture :results)) 2 "failed replacement reload")
         (let* ((replacement (car (plist-get fixture :starts)))
                (failed (pichat-session-restart-operation session)))
           (should-not (process-live-p replacement))
           (should (memq replacement (plist-get failed :shutdown-obligations)))
           (should (memq original (plist-get failed :shutdown-obligations)))
           (should (pichat-process-lifetime-confirmed-p original))
           (should-not (pichat-process-lifetime-confirmed-p replacement))
           ;; Retain two unresolved obligations to exercise the whole barrier,
           ;; rather than letting an absent endpoint bypass either one.
           (process-put original 'pichat-exit-confirmed nil)
           (plist-put fixture :rpc-error nil)
           (pichat-test-ssh-restart--recover fixture choice)
           (should (= 3 (length (plist-get fixture :watches))))
           (pichat-test-ssh-restart--watch fixture 1 'ready)
           (should-not (plist-get (pichat-session-restart-operation session) :shutdown-ready))
           (pichat-test-ssh-restart--watch fixture 2 'ready)
           (pichat-test-ssh-restart--watch fixture 1 'done t)
           (should (= 1 (length (plist-get fixture :starts))))
           (should-error (pichat-reconfigure--start-replacement
                          (pichat-session-restart-operation session)) :type 'user-error)
           (pichat-test-ssh-restart--watch fixture 2 'done t)
           (pichat-test-wait-until (lambda () (= 2 (length (plist-get fixture :results))))
                                   2 "all writer obligations discharged")
           (should (equal '(t nil) (cadr (plist-get fixture :results))))
           (should (eq (if (eq choice 'retry) 'coding 'manual)
                       (pichat-session-preset-name session)))))))))

(ert-deftest pichat-reconfigure-ssh-unknown-failed-replacement-blocks-recovery ()

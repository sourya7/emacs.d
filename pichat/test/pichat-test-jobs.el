(ert-deftest pichat-job-final-response-excludes-commentary-and-abandoned-branches ()
  (dolist (ending '((:type "text" :text "Final answer") (:type "thinking" :thinking "No prose")))
    (let* ((cache (pichat-pi-entry-cache-full
                   "source" "/saved.jsonl"
                   (list '(:type "message" :id "first" :parentId nil
                           :message (:role "assistant" :content ((:type "text" :text "Commentary"))
                                     :stopReason "toolUse"))
                         '(:type "message" :id "abandoned" :parentId "first"
                           :message (:role "assistant" :content ((:type "text" :text "Abandoned"))
                                     :stopReason "error" :errorMessage "Old error"))
                         (list :type "message" :id "final" :parentId "first"
                               :message (list :role "assistant" :content (list ending) :stopReason "stop")))
                   "final"))
           (outcome (pichat-job-executor--cache-result cache))
           (capture (plist-get outcome :capture)))
      (should (equal (plist-get outcome :result) "completed"))
      (should (equal (plist-get capture :response) (or (plist-get ending :text) "")))
      (should (equal (plist-get capture :response-entry) "final"))
      (should (equal (mapcar (lambda (entry) (plist-get entry :id))
                             (append (plist-get capture :entries) nil))
                     '("first" "final")))
      (should-not (string-match-p "Abandoned" (json-serialize (plist-get capture :entries)))))))

(ert-deftest pichat-jobs-conversation-preview-reuses-shared-renderer-offline ()
  (pichat-test-with-job-executor ()
    (let* ((entries '((:type "message" :id "user" :parentId nil
                      :message (:role "user" :content ((:type "text" :text "Inspect files"))))
                     (:type "message" :id "call" :parentId "user"
                      :message (:role "assistant" :stopReason "toolUse"
                                :content ((:type "toolCall" :id "tool" :name "read"
                                           :arguments (:paths ("one" "two") :dryRun :json-false)))))
                     (:type "message" :id "result" :parentId "call"
                      :message (:role "toolResult" :toolCallId "tool" :toolName "read"
                                :isError :json-false
                                :content ((:type "text" :text "Captured tool output"))))
                     (:type "message" :id "final" :parentId "result"
                      :message (:role "assistant" :stopReason "stop"
                                :content ((:type "text" :text "Captured answer"))))))
           (cache (pichat-pi-entry-cache-full "source" "/missing/session.jsonl" entries "final"))
           (capture (plist-get (pichat-job-executor--cache-result cache) :capture))
           (digest (pichat-job-evidence-save store capture))
           (id (pichat-job-enqueue store (pichat-test-job-spec project-dir)))
           (token (plist-get (pichat-job-claim store id) :attempt)))
      (pichat-job-advance store id token "running")
      (pichat-job-advance store id token "settling")
      (pichat-job-advance store id token "finished"
                          (list :evidence digest :session-file "/missing/session.jsonl"
                                :synchronized t :safe-to-release t :result "completed"))
      (let* ((offline (pichat-job-executor-open (pichat-job-store-open (pichat-job-store-file store))))
             (before (pichat-job-record store 'runs id))
             (renderer (symbol-function 'pichat-sessions-insert-preview-path))
             rendered)
        (cl-letf (((symbol-function 'pichat-rpc-send) (lambda (&rest _) (ert-fail "Sent RPC")))
                  ((symbol-function 'pichat-start-prepared-session) (lambda (&rest _) (ert-fail "Started Pi")))
                  ((symbol-function 'pichat-sessions-insert-preview-path)
                   (lambda (path &optional selected)
                     (setq rendered t) (funcall renderer path selected))))
          (pichat-jobs--show-detail offline 'runs id)
          (let ((report (current-buffer)))
            (pichat-test-job-press "Preview conversation")
            (should rendered)
            (should buffer-read-only)
            (should-not (derived-mode-p 'pichat-sessions-preview-mode))
            (should (string-match-p "USER\nInspect files" (buffer-string)))
            (should (string-match-p "TOOL CALL: read" (buffer-string)))
            (should (string-match-p "TOOL RESULT: read\nCaptured tool output" (buffer-string)))
            (should (string-match-p "\\\"dryRun\\\"[[:space:]]*:[[:space:]]*false" (buffer-string)))
            (goto-char (point-min))
            (search-forward "Captured answer")
            (should (equal (get-text-property (1- (point)) 'pichat-preview-entry-id) "final"))
            (should-not (string-match-p "Structured preview unavailable" (buffer-string)))
            (call-interactively (key-binding (kbd "q")))
            (should (eq report (current-buffer)))))
        (should (equal before (pichat-job-record store 'runs id)))
        (should-not (pichat-session-list))))))


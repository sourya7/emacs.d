(ert-deftest pichat-reconfigure-ssh-claim-survives-repeated-replacement-recovery ()
  (pichat-test-ssh-restart--run
   (lambda (fixture)
     (let* ((session (plist-get fixture :session))
            (key (pichat--selected-file-key (plist-get fixture :transport)
                                           (pichat-session-session-file session))))
       (plist-put fixture :rpc-error "switch_session")
       (pichat-test-ssh-restart--begin fixture)

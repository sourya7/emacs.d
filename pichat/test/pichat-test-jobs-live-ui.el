(ert-deftest pichat-integration-jobs-live-ui-actions ()
  (should-not noninteractive)
  (pichat-test-with-job-executor ()
    (let* ((spec (pichat-test-job-spec project-dir))
           (_duplicate (pichat-job-save store spec))
           (job (pichat-job-save store spec))
           (before (pichat-job-records store 'jobs)) submitted)
      (unwind-protect
          (progn
            (pichat-jobs--show-detail executor 'jobs job)
            ;; Programmatic rendering runs outside command-loop mark cleanup.
            (deactivate-mark)
            (should (string-prefix-p "Review files" header-line-format))
            (should-not (string-match-p "Actions…" (buffer-string)))
            (pichat-test-job-goto-button "Details")
            (should (looking-at "▸ Details"))
            (should-not transient--prefix)
            (execute-kbd-macro (kbd (if (pichat-view-evil-normal-p) "g a" "a")))
            (should (eq (oref transient--prefix command) 'pichat-jobs-actions-menu))
            (should (equal (plist-get (transient-scope) :detail) (cons 'jobs job)))
            (execute-kbd-macro (kbd "q"))
            (should (plist-get pichat-jobs--actions :closed))
            (should-not transient--prefix)
            (should (equal before (pichat-job-records store 'jobs)))
            (should (equal (pichat-job-records store 'runs) []))
            ;; Exercise Normal-state entry, not a Visual text-object prefix.
            (when (bound-and-true-p evil-local-mode) (evil-normal-state))
            (execute-kbd-macro (kbd (if (pichat-view-evil-normal-p) "g a" "a")))
            (execute-kbd-macro (kbd "I"))
            (should (eq pichat-jobs--section 'raw))
            (should (equal (buffer-string) (pp-to-string (pichat-job-record store 'jobs job))))
            (execute-kbd-macro (kbd "q"))
            (should-not pichat-jobs--section)
            (should-not (string-match-p "Inspect raw settings" (buffer-string)))
            (should (equal before (pichat-job-records store 'jobs)))
            (execute-kbd-macro (kbd (if (pichat-view-evil-normal-p) "g a" "a")))
            (should (eq (oref transient--prefix command) 'pichat-jobs-actions-menu))
            (cl-letf (((symbol-function 'pichat-job-executor-submit)
                       (lambda (&rest args) (setq submitted args))))
              (execute-kbd-macro (kbd "r")))
            (should (equal submitted (list executor nil job)))
            (should-not transient--prefix)
            (should (equal pichat-jobs--detail (cons 'jobs job)))
            (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) nil)))
              (pichat-test-job-command "Delete job…"))
            (should (equal before (pichat-job-records store 'jobs)))
            (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
              (pichat-test-job-command "Delete job…"))
            (should-error (pichat-job-record store 'jobs job) :type 'pichat-job-error)
            (should (pichat-job-record store 'jobs _duplicate))
            (should (string-match-p "Job deleted" (buffer-string))))
        (when transient--prefix (transient-quit-all))))))

(ert-deftest pichat-integration-jobs-live-ui-saved-editor ()
  (should-not noninteractive)
  (pichat-test-with-job-executor ()
    (let* ((pichat-jobs--executor executor) (pichat-jobs-file (pichat-job-store-file store))
           (transient-history nil)
           (transient-history-file (expand-file-name "transient-history.el" agent-dir))
           (spec (pichat-test-job-spec project-dir))
           (handler (pichat-job-save store spec)) (job (pichat-job-save store spec))
           (original (pichat-job-record store 'jobs job))
           (other (expand-file-name "other/" project-dir)))
      (make-directory other)
      (unwind-protect
          (cl-labels
              ((stage ()
                 (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "Edited live job")))
                   (execute-kbd-macro (kbd "n")))
                 (execute-kbd-macro (kbd "i"))
                 (should-not transient--prefix)
                 (should (derived-mode-p 'text-mode))
                 (erase-buffer) (insert "Discard this instruction edit")
                 (execute-kbd-macro (kbd "C-c C-k"))
                 (should (eq (oref transient--prefix command) 'pichat-job-edit-menu))
                 (execute-kbd-macro (kbd "i"))
                 (erase-buffer) (insert "Live multiline\ninstructions.")
                 (execute-kbd-macro (kbd "C-c C-c"))
                 (should (eq (oref transient--prefix command) 'pichat-job-edit-menu))
                 (cl-letf (((symbol-function 'completing-read)
                            (lambda (_prompt choices &rest _)
                              (car (seq-find (lambda (entry) (equal (cdr entry) handler)) choices)))))
                   (execute-kbd-macro (kbd "a")))
                 (cl-letf (((symbol-function 'read-directory-name) (lambda (&rest _) other))
                           ((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
                   (execute-kbd-macro (kbd "d")))
                 (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "review")))
                   (execute-kbd-macro (kbd "p")))
                 (cl-letf (((symbol-function 'pichat--list-models-async)
                            (lambda (_query callback &rest _)
                              (run-at-time 0.01 nil callback '("fixture")) nil))
                           ((symbol-function 'pichat--read-model-table-choice)
                            (lambda (&rest _) "pichat-fake/pichat-fake")))
                   (execute-kbd-macro (kbd "m"))
                   (pichat-test-wait-until
                    (lambda () (and transient--prefix
                                    (eq (oref transient--prefix command) 'pichat-job-edit-menu)))
                    2 "model returned to saved-job editor"))
                 (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "local")))
                   (execute-kbd-macro (kbd "t")))
                 (should-not (string-match-p "coordination" (format "%S" (get 'pichat-job-edit-menu 'transient--layout))))
                 (dolist (key '("q" "RET"))
                   (cl-letf (((symbol-function 'pichat-tool-picker--discover) #'ignore)
                             ((symbol-function 'pichat-tool-picker--discover-extensions) #'ignore))
                     (execute-kbd-macro (kbd "x")))

(ert-deftest pichat-jobs-saved-editor-stages-text-name-after-and-saves-once ()
  (pichat-test-with-job-views
    (let* ((spec (pichat-test-job-spec project-dir))
           (handler (pichat-job-save store spec)) (job (pichat-job-save store spec))
           (run (pichat-job-enqueue store nil job))
           (original (pichat-job-record store 'jobs job)))
      (pichat-job-cancel-queued store run)
      (let ((history (pichat-job-records store 'runs)))
        (pichat-jobs--show-detail executor 'jobs job)
        (cl-labels ((stage ()
                      (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "Changed name")))
                        (pichat-job-edit-name))
                      (cl-letf (((symbol-function 'completing-read)
                                 (lambda (_prompt choices &rest _)
                                   (car (seq-find (lambda (entry) (equal (cdr entry) handler)) choices)))))
                        (pichat-job-edit-after))
                      (pichat-job-edit-text)
                      (erase-buffer)
                      (insert (propertize "Changed multiline\ninstructions."
                                          'face 'bold 'fixture-editor (current-buffer)))
                      (call-interactively (key-binding (kbd "C-c C-c")))
                      (should-not (text-properties-at
                                   0 (plist-get (plist-get settings-scope :draft) :instructions)))))
          (pichat-test-job-press "Edit…")
          (pichat-job-edit-text)
          (erase-buffer) (insert "Discard just this editor")
          (call-interactively (key-binding (kbd "C-c C-k")))
          (should (equal (plist-get (plist-get settings-scope :draft) :instructions)
                         (plist-get spec :instructions)))
          (stage)
          (should (equal original (pichat-job-record store 'jobs job)))
          (pichat-job-settings-cancel)
          (pichat-test-job-press "Edit…")
          (should (equal spec (plist-get (plist-get settings-scope :draft) :spec)))
          (stage)
          (let ((save (symbol-function 'pichat-job-save)) (writes 0))
            (cl-letf (((symbol-function 'pichat-job-save)
                       (lambda (&rest args) (cl-incf writes) (apply save args)))
                      ((symbol-function 'read-string) (lambda (&rest _) (ert-fail "Save re-prompted name")))
                      ((symbol-function 'pichat-job-executor-schedule-refresh)
                       (lambda (&rest _) (ert-fail "Edit touched timers"))))
              (pichat-job-edit-save)
              (should (= writes 1))
              (should-error (pichat-job-edit-save) :type 'user-error)
              (should (= writes 1))))
          (let ((saved (plist-get (pichat-job-record store 'jobs job) :spec)))
            (should (equal (plist-get saved :title) "Changed name"))
            (should (equal (plist-get saved :instructions) "Changed multiline\ninstructions."))
            (should (equal (plist-get saved :after-job-id) handler))
            (should (equal (plist-get saved :configuration) (plist-get spec :configuration))))
          (should (equal history (pichat-job-records store 'runs)))
          (should (equal (plist-get (pichat-job-record store 'jobs handler) :spec) spec))
          (should-not (pichat-session-list)))))))


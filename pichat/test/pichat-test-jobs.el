(ert-deftest pichat-jobs-model-and-workspace-edits-preserve-selected-tools ()
  (pichat-test-with-job-views
    (let* ((spec (pichat-job-launch-capture
                  "Custom review" "Keep these instructions." project-dir
                  '(:preset review :model "pichat-fake/pichat-fake" :target local
                    :tools (:builtins ("read") :mcp nil)) "read"))
           (other (expand-file-name "subdirectory/" project-dir)) callback)
      (make-directory other)
      (pichat-job--setup spec nil executor)
      (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "Model"))
                ((symbol-function 'yes-or-no-p) (lambda (&rest _) t))
                ((symbol-function 'pichat--list-models-async)
                 (lambda (_query cb &rest _) (setq callback cb) nil)))
        (pichat-job-execution-settings))
      (cl-letf (((symbol-function 'pichat--read-model-table-choice)
                 (lambda (&rest _) "other/model")))
        (funcall callback '("dummy")))
      (cl-letf (((symbol-function 'read-directory-name) (lambda (&rest _) other)))
        (pichat-job-change-project))
      ;; Assert the resulting launch contract, not the shape of the draft.
      (let* ((result (pichat-job--submission-spec))
             (config (plist-get result :configuration))
             (command (append (plist-get config :command) nil)))
        (should (equal (cadr (member "--tools" command)) "read"))
        (should (equal (plist-get config :model) "other/model"))
        (should (equal (plist-get result :instructions) "Keep these instructions."))
        (should (equal (plist-get result :directory) other))
        (should (equal (plist-get (aref (plist-get result :resources) 0) :access) "read"))
        (should (equal pichat-default-model "pichat-fake/pichat-fake")))
      (let (selection)
        (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "Tools"))
                  ((symbol-function 'pichat-tool-picker-open)
                   (lambda (_preset tools _dir _transport _exe cb &rest _)
                     (setq selection tools) (funcall cb :cancel))))
          (pichat-job-execution-settings))
        (should (equal (plist-get selection :builtins) '("read")))))))

(ert-deftest pichat-jobs-default-overlap-policy-is-quiet-but-inspectable ()
  (pichat-test-with-job-views
    (let* ((spec (pichat-test-job-spec project-dir))
           (job (pichat-job-save store spec)))
      (pichat-job--setup spec job executor)
      (should-not (string-match-p "Overlap policy:\\|Coordination:\\|sandbox" (buffer-string)))
      (let ((choices '("Workspace coordination" "Read-only — wait for stable files")))
        (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) (pop choices))))
          (pichat-job-execution-settings)))
      (should (string-match-p "stable files" (buffer-string)))
      (should (equal (plist-get (aref (plist-get (pichat-job--submission-spec) :resources) 0)
                               :access) "read"))
      ;; The saved definition is unchanged; its default stays out of the summary
      ;; but remains available when explicitly inspecting captured settings.
      (pichat-jobs--show-detail executor 'jobs job)
      (should-not (string-match-p "Overlap policy:\\|Coordination:\\|sandbox" (buffer-string)))
      (pichat-test-job-press "Captured settings")
      (should (string-match-p "Overlap policy:" (buffer-string)))
      (should (equal (plist-get (aref (plist-get (plist-get (pichat-job-record store 'jobs job)
                                                         :spec) :resources) 0) :access) "write"))
      (should (equal (pichat-job-records store 'runs) []))
      (should-not (pichat-session-list)))))

(ert-deftest pichat-jobs-details-disclose-sensitive-capture-only-on-request ()
  (pichat-test-with-job-views
    (let* ((spec (pichat-job-launch-capture
                  "Defaults" "Read the supplied material." project-dir
                  '(:preset standard :model "pichat-fake/pichat-fake" :target local) "observe"))
           (config (plist-get spec :configuration)))
      (setf (plist-get config :command)
            (vconcat (plist-get config :command) ["SENSITIVE_CAPTURED_ARGUMENT"]))
      (let ((job (pichat-job-save store spec)))
        (cl-letf (((symbol-function 'pichat-job-executor-submit)
                   (lambda (&rest _) (ert-fail "Inspection submitted work")))
                  ((symbol-function 'pichat-backend-get-state)
                   (lambda (&rest _) (ert-fail "Inspection contacted Pi"))))
          (pichat-job--setup spec job executor)
          (should (string-match-p "Pi defaults" (buffer-string)))
          (should (string-match-p "accepts changing files" (buffer-string)))
          (pichat-jobs--show-detail executor 'jobs job)
          (should (string-match-p "Never run" (buffer-string)))
          (should-not (string-match-p "SENSITIVE_CAPTURED_ARGUMENT" (buffer-string)))
          (pichat-test-job-press "Captured settings")
          (should (string-match-p (plist-get spec :instructions) (buffer-string)))
          (should-not (string-match-p "SENSITIVE_CAPTURED_ARGUMENT" (buffer-string)))
          (pichat-test-job-press "Inspect raw settings (sensitive)…")
          (should (string-match-p "SENSITIVE_CAPTURED_ARGUMENT" (buffer-string)))
          (call-interactively (key-binding (kbd "q")))
          (should-not (string-match-p "SENSITIVE_CAPTURED_ARGUMENT" (buffer-string)))
          (should-not (pichat-session-list))
          (should (equal (pichat-job-records store 'runs) [])))))))

(ert-deftest pichat-jobs-latest-history-and-return-use-exact-identities ()
  (pichat-test-with-job-views
    (let* ((spec (pichat-test-job-spec project-dir))
           (_first (pichat-job-save store spec))
           (job (pichat-job-save store spec))
           (older (pichat-job-enqueue store nil job)))
      (pichat-job-cancel-queued store older)
      (let ((latest (pichat-job-enqueue store nil job)))
        (pichat-jobs)
        (forward-line 1)
        (should (equal (tabulated-list-get-id) job))
        (pichat-jobs-details)
        (pichat-test-job-press "Open latest run")
        (should (equal pichat-jobs--detail (cons 'runs latest)))
        (pichat-test-job-press "Job history")
        (should (string-match-p job mode-line-process))
        (should (equal (mapcar #'car tabulated-list-entries) (list latest older)))
        (pichat-jobs-toggle)
        (should (equal (tabulated-list-get-id) job))
        (should (equal (plist-get (pichat-job-record store 'runs latest) :state) "queued"))
        (should-not (pichat-session-list))))))

(ert-deftest pichat-jobs-blocker-navigation-and-local-uncertainty-actions ()
  (pichat-test-with-owned-job
    (let ((waiter (pichat-job-enqueue store (pichat-test-job-spec project-dir))))
      (pichat-jobs--show-detail executor 'runs waiter)
      (pichat-test-job-press "Open blocking run")
      (should (equal pichat-jobs--detail (cons 'runs id)))
      (pichat-job-executor--advance execution "uncertain" '(:reason "Inspect modifying work"))
      (pichat-jobs--render-detail)
      (should (string-match-p "Held resource:" (buffer-string)))
      (should (string-match-p "recheck unavailable" (buffer-string)))
      (should-not (string-match-p "Recheck remote Pi exit" (buffer-string)))
      (should-not (string-match-p "Open saved session independently" (buffer-string)))
      (should-not (eq (plist-get (pichat-job-admission store waiter) :ready) t))
      (should-error (pichat-job-executor-recheck-exit executor id #'ignore) :type 'user-error)
      (should-not (plist-get (pichat-job-record store 'runs id) :result)))))

(ert-deftest pichat-jobs-attention-and-narrow-lists-retain-work-context ()
  (pichat-test-with-job-views
    (let* ((job (pichat-job-save store (pichat-test-job-spec project-dir)))
           (run (pichat-job-enqueue store nil job))
           (claim (pichat-job-claim store run)))
      (pichat-job-advance store run (plist-get claim :attempt) "uncertain")
      (pichat-job-enqueue store (pichat-test-job-spec project-dir))
      (pichat-jobs)
      (should (string-match-p "1/3 active" mode-line-process))
      (should (string-match-p "1 attention" mode-line-process))
      (call-interactively (key-binding (kbd "a")))
      (should (equal (mapcar #'car tabulated-list-entries) (list run)))
      (let ((ids (mapcar #'car tabulated-list-entries)))
        (dolist (width '(60 140))
          (cl-letf (((symbol-function 'window-body-width) (lambda (&rest _) width)))
            (pichat-jobs-refresh))
          (should (equal ids (mapcar #'car tabulated-list-entries)))
          (should (string-match-p "local" (buffer-string)))
          (should (string-match-p (file-name-nondirectory (directory-file-name project-dir))
                                  (buffer-string)))))
      (should-not (pichat-session-list)))))


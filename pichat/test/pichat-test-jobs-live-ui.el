(ert-deftest pichat-integration-jobs-live-ui-continuation-invalidation-feedback ()
  (should-not noninteractive)
  (pichat-test-with-job-executor
      (:script '(:turns [(:text "Intervening reply") (:text "RESCHEDULED_CURRENT_MODEL")]))
    (let* ((session (pichat-test-job-conversation-start project-dir))
           (chat (pichat-session-buffer session))
           (pichat-jobs--executor executor) (pichat-jobs-file (pichat-job-store-file store))
           (transient-history nil)
           (transient-history-file (expand-file-name "transient-history.el" agent-dir)) id)
      (unwind-protect
          (progn
            (pop-to-buffer chat)
            (execute-kbd-macro (kbd "M-x pichat-job-schedule-continuation RET"))
            (cl-letf (((symbol-function 'pichat-job-schedule-ui-read-time)
                       (lambda (&rest _) (+ (float-time) 3600))))
              (execute-kbd-macro (kbd "w")))
            (let ((scope (transient-scope)))
              (execute-kbd-macro (kbd "s"))
              (pichat-test-wait-until (lambda () (plist-get scope :submitted-run-id)) 5 "schedule")
              (setq id (plist-get scope :submitted-run-id)))
            ;; Competing real input cancels immediately, without selecting chat.
            (let ((selected (selected-window)) (shown (window-buffer)))
              (pichat-test-prompt-and-wait session "Intervening work")
              (should (eq selected (selected-window)))
              (should (eq shown (window-buffer))))
            (pichat-test-job-conversation-ready session)
            (pop-to-buffer chat)
            (should (string-match-p "Intervening submitted input" (buffer-string)))
            (pichat-chat-repaint)
            (should (string-match-p "Intervening submitted input" (buffer-string)))
            (pichat-test-job-conversation-ready session)
            (execute-kbd-macro (kbd "M-x pichat-job-review-continuation RET"))
            (should (equal (cons 'runs id) pichat-jobs--detail))
            (should (string-match-p "Not sent: Intervening submitted input" (buffer-string)))
            (execute-kbd-macro (kbd "q"))
            (should (eq (window-buffer) chat))
            (execute-kbd-macro (kbd "M-x pichat-job-reschedule-continuation RET"))
            (should-not (plist-get (transient-scope) :due))
            (execute-kbd-macro (kbd "q"))
            (execute-kbd-macro (kbd "M-x pichat-job-review-continuation RET"))
            (pichat-test-job-command "Reschedule…")
            (should-not (plist-get (transient-scope) :due))
            (execute-kbd-macro (kbd "q"))
            (should (equal (cons 'runs id) pichat-jobs--detail))
            (should (= 1 (length (pichat-job-records store 'runs))))
            (pichat-test-job-command "Reschedule…")
            (should-not (plist-get (transient-scope) :due))
            (should (equal "continue" (plist-get (plist-get (transient-scope) :draft) :instructions)))
            (should (= 1 (length (pichat-job-records store 'runs))))
            (cl-letf (((symbol-function 'pichat-job-schedule-ui-read-time)
                       (lambda (&rest _) (+ (float-time) 2))))
              (execute-kbd-macro (kbd "w")))
            (let ((scope (transient-scope)))
              (execute-kbd-macro (kbd "s"))
              (pichat-test-wait-until (lambda () (plist-get scope :submitted-run-id)) 5 "reschedule")
              (setq id (plist-get scope :submitted-run-id)))
            (pop-to-buffer chat)
            (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "UI fixture renamed")))
              (execute-kbd-macro (kbd "C-c C-e")))
            (pichat-test-rpc-call session "set_model"
                                 '(:provider "pichat-fake" :modelId "pichat-fake-reasoning"))
            (pichat-test-job-wait store id "finished")
            (should (eq (window-buffer) chat))
            (let ((run (pichat-job-record store 'runs id)))
              (should (equal "completed" (plist-get run :result)))
              (should (equal "pichat-fake/pichat-fake-reasoning" (plist-get run :execution-model))))
            (pichat-test-assert-provider-script-consumed status-file))
        (when transient--prefix (transient-quit-all))))))

(ert-deftest pichat-integration-jobs-live-ui-schedule ()
  (pichat-test-with-job-executor (:script '(:turns [(:text "LIVE_SCHEDULE_RESULT")]))
    (let* ((job (pichat-job-save store (pichat-test-job-spec project-dir)))
           (future (+ (float-time) 3600))
           (transient-history nil)
           (transient-history-file (expand-file-name "transient-history.el" agent-dir)))
      (unwind-protect
          (progn
            (pichat-jobs--show-detail executor 'jobs job)
            (let ((details (current-buffer)))
              (pichat-test-job-command "Set schedule…")
              (should (eq (oref transient--prefix command) 'pichat-job-schedule-menu))
              (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "Every")))
                (execute-kbd-macro (kbd "k")))
              (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "hours"))
                        ((symbol-function 'read-number) (lambda (&rest _) 2)))
                (execute-kbd-macro (kbd "i")))
              (cl-letf (((symbol-function 'read-string)
                         (lambda (&rest _) (format-time-string "%Y-%m-%d %H:%M" (seconds-to-time future)))))
                (execute-kbd-macro (kbd "s")))
              (should-not (plist-get (pichat-job-record store 'jobs job) :schedule))
              (execute-kbd-macro (kbd "q"))
              (should (eq (current-buffer) details))
              (should-not (plist-get (pichat-job-record store 'jobs job) :schedule))
              (pichat-test-job-command "Set schedule…")
              (cl-letf (((symbol-function 'read-string)
                         (lambda (&rest _) (format-time-string "%Y-%m-%d %H:%M" (seconds-to-time future)))))
                (execute-kbd-macro (kbd "s")))
              (execute-kbd-macro (kbd "RET"))
              (should (eq (current-buffer) details))
              (should (string-match-p "Schedule: Once · Disabled" (buffer-string)))
              (should (equal (pichat-job-records store 'runs) []))
              (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
                (pichat-test-job-command "Enable…"))
              (should (string-match-p "Schedule: Once · Enabled" (buffer-string)))
              (pichat-test-job-command "Disable")
              (should (string-match-p "Schedule: Once · Disabled" (buffer-string)))
              ;; Test an actual short timer without depending on minute-picker timing.
              (pichat-job-executor-schedule-change executor job
                                                   (list :kind "once" :start (+ (float-time) 0.3)))
              (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
                (pichat-test-job-command "Enable…"))
              (pichat-test-wait-until (lambda () (> (length (pichat-job-records store 'runs)) 0)) 5 "live scheduled run")
              (let ((id (plist-get (aref (pichat-job-records store 'runs) 0) :id)))
                (pichat-test-job-wait store id "finished")
                (should (eq (current-buffer) details))
                (should (equal pichat-jobs--detail (cons 'jobs job)))
                (should (string-match-p "Once · Dispatched" (buffer-string)))
                (pichat-test-job-press "Details")
                (should-not (string-match-p "View scheduled run" (buffer-string)))
                (pichat-test-job-goto-button "Last occurrence: Submitted")
                (execute-kbd-macro (kbd "RET"))
                (should (equal pichat-jobs--detail (cons 'runs id)))
                (should (string-match-p "LIVE_SCHEDULE_RESULT" (buffer-string))))
              (pichat-test-assert-provider-script-consumed status-file)))
        (when transient--prefix (transient-quit-all))))))


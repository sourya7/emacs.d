(ert-deftest pichat-job-definition-after-job-scope-rules-at-discovery ()
  (pichat-test-job-definition--require)
  (pichat-test-with-temp-dir root
    (let* ((agent (expand-file-name "agent/" root))
           (project (expand-file-name "project/" root))
           (data (json-parse-string
                  (pichat-test-job-definition--fixture "global-review.json")
                  :object-type 'plist))
           (write (lambda (file changes)
                    (let ((copy (copy-tree data)))
                      (while changes (setq copy (plist-put copy (pop changes) (pop changes))))
                      (make-directory (file-name-directory file) t)
                      (with-temp-file file
                        (insert (decode-coding-string (json-serialize copy) 'utf-8)))))))
      (funcall write (expand-file-name "jobs/global-to-project.json" agent)
               '(:id "a" :after_job (:scope "project" :id "b")))
      (funcall write (expand-file-name "jobs/global-self.json" agent)
               '(:id "c" :after_job (:scope "global" :id "c")))
      (funcall write (expand-file-name "jobs/global-ok.json" agent)
               '(:id "d" :after_job (:scope "global" :id "e")))
      (funcall write (expand-file-name ".pi/jobs/project-self.json" project)
               '(:id "f" :after_job (:scope "project" :id "f")))
      ;; The same ID in the other scope is a different job, not itself.
      (funcall write (expand-file-name ".pi/jobs/project-global.json" project)
               '(:id "g" :after_job (:scope "global" :id "g")))
      (let* ((result (pichat-job-definition-discover agent project))
             (ids (mapcar (lambda (record) (plist-get (plist-get record :definition) :id))
                          (plist-get result :definitions)))
             (messages (mapconcat (lambda (item) (plist-get item :message))
                                  (plist-get result :diagnostics) "\n")))
        (should (equal (sort ids #'string<) '("d" "g")))
        (should (= 3 (length (plist-get result :diagnostics))))
        (should (string-match-p "Global jobs can only name a global after_job" messages))
        (should (string-match-p "cannot name this job itself" messages))))))


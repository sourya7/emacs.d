(ert-deftest pichat-jobs-continuation-instruction-blocks-fold-independently-without-editing ()
  (pichat-test-with-job-views
    (let* ((original (concat (mapconcat (lambda (n) (format "Original line %d" n))
                                      (number-sequence 1 10) "\n") "\nORIGINAL_END"))
           (guidance (concat (mapconcat (lambda (n) (format "Guidance line %d" n))
                                      (number-sequence 1 10) "\n") "\nGUIDANCE_END"))
           (spec (pichat-test-job-spec project-dir)))
      (setf (plist-get spec :instructions) original)
      (let ((id (pichat-job-enqueue store spec)))
        (pichat-job-cancel-queued store id)
        (pichat-jobs--continue executor id)
        (setf (plist-get pichat-job--draft :guidance) guidance)
        (pichat-job--render-setup)
        (should-not (string-match-p "ORIGINAL_END\\|GUIDANCE_END" (buffer-string)))
        ;; Setup TAB navigates; it does not toggle a block or submit anything.
        (goto-char (text-property-any (point-min) (point-max) 'pichat-job-section 'task))
        (call-interactively (key-binding (kbd "TAB")))
        (should-not pichat-jobs--expanded)
        (dolist (key '(guidance task))
          (goto-char (text-property-any (point-min) (point-max) 'pichat-job-section key))
          (call-interactively (key-binding (kbd "RET")))
          (should (member key pichat-jobs--expanded))
          (should (string-match-p "GUIDANCE_END" (buffer-string)))
          (when (eq key 'guidance)
            (should-not (string-match-p "ORIGINAL_END" (buffer-string)))))
        (should (string-match-p "ORIGINAL_END" (buffer-string)))
        (pichat-job--render-setup)
        (should (equal (plist-get pichat-job--draft :instructions) original))
        (should (equal (plist-get pichat-job--draft :guidance) guidance))
        (should-not (plist-get pichat-job--draft :dirty))
        (should (= 1 (length (pichat-job-records store 'runs))))))))

(ert-deftest pichat-job-schedule-owned-timers-fire-once-and-retire-on-disable-delete ()
  (pichat-test-with-job-executor ()
    (let ((job (pichat-job-save store (pichat-test-job-spec project-dir)))
          (now (float-time)) callbacks cancelled (pumps 0))
      (cl-letf (((symbol-function 'run-at-time)
                 (lambda (_time repeat callback)
                   (should-not repeat)
                   (push callback callbacks) callback))
                ((symbol-function 'cancel-timer) (lambda (timer) (push timer cancelled)))
                ((symbol-function 'pichat-job-executor-pump) (lambda (_) (cl-incf pumps))))
        (pichat-job-executor-schedule-change executor job
                                             (list :kind "interval" :start (+ now 10) :seconds 60))
        (pichat-job-schedule-enable store job t now)
        (pichat-job-executor-schedule-refresh executor)
        (should (= (length callbacks) 1))
        (let ((first (car callbacks)))
          (pichat-job-executor-schedule-refresh executor)
          (should (= (length callbacks) 1))
          (cl-letf (((symbol-function 'float-time) (lambda (&optional _) (+ now 190))))
            (funcall first))
          (should (= (length (pichat-job-records store 'runs)) 1))
          (should (= pumps 1))
          (should (= (length callbacks) 2))
          (funcall first)
          (should (= pumps 1))
          (pichat-job-executor-schedule-enable executor job nil)
          (should cancelled)
          (funcall (car callbacks))
          (should (= pumps 1))
          (pichat-job-cancel-queued store (plist-get (aref (pichat-job-records store 'runs) 0) :id))
          (pichat-job-delete store job)
          (pichat-job-executor-schedule-refresh executor)
          (should (= (hash-table-count (pichat-job-executor-schedules executor)) 0)))))))


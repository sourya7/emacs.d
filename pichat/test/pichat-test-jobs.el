      (cl-letf (((symbol-function 'pichat-job-executor-pump) #'ignore)
                ((symbol-function 'pichat-process-lifetime-supported-p) (lambda (_) supported))
                ((symbol-function 'pichat-job-executor-recheck-exit)
                 (lambda (owner run callback)
                   (push (list owner run) calls)
                   (funcall callback t nil))))

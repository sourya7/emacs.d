;;; explorer-live-smoke.el --- Isolated terminal explorer walkthrough -*- lexical-binding: t; -*-

;; Run from the repository root: ELPACA_BUILDS=/path/to/builds \
;;   emacs -Q -nw -l user/test/explorer-live-smoke.el
;; Repeat with EXPLORER_OVERRIDE=1. EXPLORER_PLAN names a valid plan in
;; this project (default json-data-explorer). Only read-only CLI calls run.

(require 'cl-lib)
(require 'ert)

(defun explorer-smoke--load ()
  (let* ((builds (or (getenv "ELPACA_BUILDS") ".local/elpaca/builds"))
         (vui (expand-file-name "vui" builds)))
    (dolist (dir (directory-files builds t "\\`[^.]"))
      (when (and (file-directory-p dir) (not (equal dir vui)))
        (push dir load-path)))
    (require 'use-package)
    (setq use-package-always-defer t use-package-expand-minimally t
          use-package-ensure-function #'ignore
          evil-want-keybinding nil evil-undo-system 'undo-redo
          user-emacs-directory default-directory)
    (require 'general)
    (require 'evil)
    (require 'evil-collection)
    (evil-collection-init '(special-mode))
    (when (getenv "EXPLORER_OVERRIDE")
      (setq evil-collection-binding-overrides
            '((action :key "<f8>") (next-button :key "gN")
              (refresh :key "gR") (find-file :key "gF"))))
    (evil-mode 1)
    (autoload 'doom-modeline-mode "doom-modeline")
    (setq my/theme 'tango)
    (load (expand-file-name "core/visual-config.el") nil t)
    (load (expand-file-name "core/utils.el") nil t)
    (require 'load-relative)
    ;; Use the real module loader and registration; skip unrelated modules
    ;; and simulate Elpaca activation without installing anything.
    (with-temp-buffer
      (insert-file-contents "core/package.el")
      (cl-loop for form = (read (current-buffer))
               when (and (eq (car-safe form) 'defun)
                         (eq (cadr form) 'my/load-packages))
               return (eval form t)))
    (let ((skip (lambda (original modules &optional isolate)
                  (unless (eq (car modules) 'keybindings)
                    (funcall original modules isolate)))))
      (advice-add 'my/load-packages :around skip)
      (unwind-protect (load (my/emacs-main-dir "user/package.el") nil t)
        (advice-remove 'my/load-packages skip)))
    (should-not (featurep 'json-explore))
    (should-not (featurep 'plans-explore))
    (push vui load-path)
    (run-hooks 'elpaca-after-init-hook)
    (dolist (command '(json-explore-buffer json-explore-run-command
                       plans-explore-list plans-explore-show
                       plans-explore-check plans-explore-workspaces))
      (should (commandp command)))))

(defvar explorer-smoke--last-keys nil)

(defun explorer-smoke--press (keys)
  (setq explorer-smoke--last-keys keys)
  (execute-kbd-macro (kbd keys)))

(defun explorer-smoke--wait ()
  (let ((end (+ (float-time) 5)))
    (while (and json-explore--request (< (float-time) end))
      (accept-process-output nil 0.05)))
  (should-not json-explore--request))

(defun explorer-smoke--keys (action next override)
  (let* ((value (json-explore-parse
                 "[{\"n\":1000,\"obj\":{\"needle\":1}},{\"n\":2,\"obj\":{\"other\":2}}]"))
         (explorer (json-explore-show-value value "*Explorer smoke keys*")))
    (dolist (pair `((,action . json-explore-open) (,next . json-explore-next-cell)
                    ("<backtab>" . json-explore-previous-cell)
                    ("<S-tab>" . json-explore-previous-cell)
                    ("g]" . json-explore-next-cell) ("g[" . json-explore-previous-cell)
                    ("S-<return>" . json-explore-open-other-window)
                    ("S-RET" . json-explore-open-other-window)
                    ("M-<return>" . json-explore-display-other-window)
                    ("M-RET" . json-explore-display-other-window)
                    ("h" . evil-backward-char) ("l" . evil-forward-char)
                    ("w" . evil-forward-word-begin) ("b" . evil-backward-word-begin)
                    ("gg" . evil-goto-first-line) ("G" . evil-goto-line)
                    ("y" . evil-yank) ("ZQ" . json-explore-evil-quit)))
      (should (equal (cons (car pair) (key-binding (kbd (car pair)))) pair)))
    (if override
        (progn (should-not (eq (key-binding (kbd "RET")) 'json-explore-open))
               (should-not (eq (key-binding (kbd "<tab>")) 'json-explore-next-cell)))
      ;; Raw TAB is C-i in a terminal; test the distinct <tab> event above.
      (should (eq (key-binding (kbd "RET")) 'json-explore-open)))
    (should (eq (window-buffer) explorer))
    (vui-flush-sync)
    (should (vui-goto-key '(0 . index)))
    (explorer-smoke--press next)
    (should (equal (vui-key-at) '(0 . "n")))
    (explorer-smoke--press "<backtab>")
    (should (equal (vui-key-at) '(0 . index)))
    (explorer-smoke--press "g] g[")
    (should (equal (vui-key-at) '(0 . index)))
    (explorer-smoke--press "gl gh gl l j")
    (should (equal (vui-key-at) '(1 . "n")))
    (explorer-smoke--press "k o")
    (should (equal (vui-key-at) '(0 . "n")))
    (should (equal (json-explore--visible-rows json-explore--view) '(1 0)))
    (explorer-smoke--press "O gl")
    (should (equal (json-explore--visible-rows json-explore--view) '(0 1)))
    (explorer-smoke--press action)
    (should (equal (vui-key-at) '("needle" . key)))
    (explorer-smoke--press "C-o")
    (should (equal (vui-key-at) '(0 . "obj")))
    (should (json-explore--view-descending json-explore--view))
    (explorer-smoke--press "C-i")
    (should (equal (vui-key-at) '("needle" . key)))
    (goto-char (point-min))
    (explorer-smoke--press "/ n e e d l e RET")
    (should (equal (vui-key-at) '("needle" . key)))
    (goto-char (point-max))
    (explorer-smoke--press "? n e e d l e RET")
    (should (equal (vui-key-at) '("needle" . key)))
    (explorer-smoke--press "Y gO")
    (should (equal (car kill-ring) ".[0][\"obj\"][\"needle\"]"))
    (should (eq (window-buffer) explorer))
    (let ((inspection json-explore--inspection))
      (should (get-buffer-window inspection))
      (explorer-smoke--press "go")
      (should (eq (current-buffer) inspection))
      (select-window (get-buffer-window explorer))
      (explorer-smoke--press "K")
      (should (eq (current-buffer) inspection))
      (should (equal (buffer-string) "1"))
      (should buffer-read-only))
    (select-window (get-buffer-window explorer))
    (save-window-excursion
      (explorer-smoke--press "g?")
      (should (get-buffer-window "*Help*")))
    (dolist (key '("q" "ZZ" "ZQ"))
      (delete-other-windows)
      (switch-to-buffer "*scratch*")
      ;; Test each quit in a secondary window so even Evil's ZQ is isolated.
      (select-window (split-window-below))
      (switch-to-buffer explorer)
      (explorer-smoke--press key)
      (should-not (get-buffer-window explorer))
      (switch-to-buffer "*scratch*"))))

(defun explorer-smoke--sticky (action)
  (delete-other-windows)
  (json-explore-show-value
   (json-explore-parse
    (concat "{\"rows\":[" (mapconcat (lambda (n) (format "{\"n\":%d}" n))
                                    (number-sequence 0 99) ",") "]}"))
   "*Explorer smoke sticky*")
  (should (vui-goto-key '("rows" . key)))
  (explorer-smoke--press action)
  (should (vui-goto-key '(0 . "n")))
  (explorer-smoke--press "o")
  (let ((window (selected-window))
        (annotation (save-excursion
                      (goto-char (point-min))
                      (forward-line 1)
                      (should (looking-at-p "Sorted by"))
                      (point))))
    (set-window-start window annotation)
    (redisplay t)
    (should (window-parameter window 'header-line-format))
    (should (string-match-p (regexp-quote ".[\"rows\"]") (vui--sticky-header)))
    (should (vui-goto-key '(40 . "n")))
    (let ((start (line-beginning-position)))
      (set-window-start window start)
      (redisplay t)
      (should (= (window-start window) start))
      (should (window-parameter window 'header-line-format))
      (should (string-match-p "Index +\"n\"" (vui--sticky-header)))
      (explorer-smoke--press action)
      (explorer-smoke--press "C-o")
      (redisplay t)
      (should (equal (vui-key-at) '(40 . "n")))
      (should (= (window-start window) start)))))

(defun explorer-smoke--command (refresh override)
  (let ((file (make-temp-file "explorer-smoke-")))
    (unwind-protect
        (progn
          (write-region "echo '{\"x\":42}'; echo initial-warning >&2" nil file nil 'silent)
          (json-explore-run-command "sh" (list file))
          (when override
            (should-not (eq (key-binding (kbd "gr")) 'json-explore-refresh)))
          (explorer-smoke--wait)
          (should (= (json-explore--value-at-point) 42))
          (should (string-match-p "stderr: initial-warning" (buffer-string)))
          (write-region "echo invalid; echo failed >&2" nil file nil 'silent)
          (explorer-smoke--press refresh)
          (explorer-smoke--wait)
          (should (= (json-explore--value-at-point) 42))
          (should (string-match-p "Exit status 0:.*\nstderr: failed" (buffer-string)))
          (write-region "echo '{\"x\":43}'" nil file nil 'silent)
          (explorer-smoke--press refresh)
          (explorer-smoke--wait)
          (should (= (json-explore--value-at-point) 43))
          (should-not (json-explore--view-diagnostic json-explore--view)))
      (delete-file file))))

(defun explorer-smoke--plans (action visit refresh override)
  (let* ((id (or (getenv "EXPLORER_PLAN") "json-data-explorer"))
         (explorer (plans-explore-list)))
    (explorer-smoke--wait)
    (should (json-explore--view-value json-explore--view))
    (let* ((rows (json-explore--view-value json-explore--view))
           (index (cl-position id rows :test #'equal :key (lambda (row) (gethash "id" row)))))
      (should (natnump index))
      (should (vui-goto-key (cons index 'index))))
    (should-not (plans-explore--record))
    (explorer-smoke--press action)
    (explorer-smoke--wait)
    (let* ((record (plans-explore--record))
           (file (gethash "path" record))
           (line (gethash "line" (aref (gethash "tasks" record) 0))))
      (should (equal (gethash "id" record) id))
      (explorer-smoke--press refresh)
      (explorer-smoke--wait)
      (should (equal (gethash "id" (plans-explore--record)) id))
      (should (vui-goto-key '("org" . value)))
      (explorer-smoke--press action)
      (should (derived-mode-p 'org-mode))
      (should buffer-read-only)
      (should-not buffer-file-name)
      (select-window (get-buffer-window explorer))
      (when override
        (should-not (eq (key-binding (kbd "gf")) 'plans-explore-visit)))
      (explorer-smoke--press visit)
      (should (equal buffer-file-name file))
      (should (and view-mode buffer-read-only (not (buffer-modified-p))))
      (select-window (get-buffer-window explorer))
      (should (vui-goto-key '("tasks" . key)))
      (explorer-smoke--press action)
      (should (vui-goto-key '(0 . "title")))
      (explorer-smoke--press visit)
      (should (equal buffer-file-name file))
      (should (and view-mode buffer-read-only (= (line-number-at-pos) line)
                   (not (buffer-modified-p))))
      (select-window (get-buffer-window explorer)))
    (explorer-smoke--press "C-o C-o")
    (should-not (plans-explore--record))
    (explorer-smoke--press "C-i")
    (should (equal (gethash "id" (plans-explore--record)) id))
    (plans-explore-show id)
    (explorer-smoke--wait)
    (should (equal (gethash "id" (plans-explore--record)) id))
    (plans-explore-check)
    (explorer-smoke--wait)
    (should (cl-some (lambda (row) (and (equal (gethash "id" row) id)
                                       (eq (gethash "valid" row) t)))
                     (json-explore--view-value json-explore--view)))
    (plans-explore-workspaces)
    (explorer-smoke--wait)
    (should (vectorp (gethash "workspaces" (json-explore--view-value json-explore--view))))
    (should (vui-goto-key '("workspaces" . key)))
    (explorer-smoke--press action)
    (should (vectorp (json-explore--view-value json-explore--view)))))

(defun explorer-smoke--main ()
  (let* ((override (getenv "EXPLORER_OVERRIDE"))
         (action (if override "<f8>" "<return>"))
         (next (if override "gN" "<tab>"))
         (refresh (if override "gR" "gr"))
         (visit (if override "gF" "gf"))
         (stage 'load))
    (condition-case err
        (progn
          (explorer-smoke--load)
          (setq stage 'keys) (explorer-smoke--keys action next override)
          (setq stage 'sticky) (explorer-smoke--sticky action)
          (setq stage 'command) (explorer-smoke--command refresh override)
          (setq stage 'plans) (explorer-smoke--plans action visit refresh override)
          (send-string-to-terminal (format "\r\nPASS: explorer smoke (%s)\r\n" (if override "overrides" "defaults")))
          (kill-emacs 0))
      (error
       (send-string-to-terminal (format "\r\nFAIL: %s (last keys %S): %S\r\n"
                                       stage explorer-smoke--last-keys err))
       (kill-emacs 1)))))

(add-hook 'emacs-startup-hook
          (lambda () (run-at-time 0 nil #'explorer-smoke--main)))
;;; explorer-live-smoke.el ends here

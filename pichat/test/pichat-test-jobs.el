(ert-deftest pichat-jobs-run-asks-for-input-only-when-declared ()
  (pichat-test-with-job-views
    (cl-letf (((symbol-function 'pichat-job-executor-pump) #'ignore))
      (let* ((plain (pichat-job-save store (pichat-test-job-spec project-dir)))
             (job (pichat-job-save store (plist-put (pichat-test-job-spec project-dir)
                                                    :input "Plan and scope")))
             prompts)
        (pichat-jobs)
        (pichat-jobs--select plain)
        (cl-letf (((symbol-function 'read-string) (lambda (&rest _) (ert-fail "Asked for input"))))
          (pichat-jobs-run))
        (should-not (plist-member (aref (pichat-job-records store 'runs) 0) :input))
        (pichat-jobs--select job)
        (cl-letf (((symbol-function 'read-string) (lambda (prompt &rest _) (push prompt prompts) "  ")))
          (should-error (pichat-jobs-run) :type 'user-error))
        (should (equal prompts '("Plan and scope: ")))
        (should (= 1 (length (pichat-job-records store 'runs))))
        (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "plan: a; scope: b")))
          (pichat-jobs-run))
        (let ((run (aref (pichat-job-records store 'runs) 1)))
          (should (equal (plist-get run :job-id) job))
          (should (equal (plist-get run :input) "plan: a; scope: b"))
          (pichat-jobs--show-detail executor 'runs (plist-get run :id))
          (should-not (string-match-p "Run input:" (buffer-string)))
          (pichat-test-job-press "Details")
          (should (string-match-p "Run input:\n" (buffer-string)))
          (should (string-match-p "plan: a; scope: b" (buffer-string))))
        (pichat-jobs--show-detail executor 'jobs job)
        (pichat-test-job-press "Details")
        (should (string-match-p "Run input: asked when run (Plan and scope)" (buffer-string)))))))


(when pichat-test-include-integration
  (ert-deftest pichat-integration-job-followup-independent-provider-and-fake-notification ()
    (pichat-test-with-job-executor
        (:script '(:turns [(:text "WORKER_RESULT café ✓")]))
      (let* ((extension (expand-file-name "review-provider.ts" agent-dir))
             (review-script (expand-file-name "review-script.json" agent-dir))
             (review-status (expand-file-name "review-status.json" agent-dir))
             (review-directory (expand-file-name "review/" project-dir))
             (process-environment
              (append (list (concat "PICHAT_REVIEW_PROVIDER_SCRIPT=" review-script)
                            (concat "PICHAT_REVIEW_PROVIDER_STATUS=" review-status))
                      process-environment))
             (original-buffer (current-buffer)) (original-window (selected-window))
             (current (pichat-session-make)) (pichat-current-session current)
             received connections
             (server
              (make-network-process
               :name "pichat-fake-notification" :server t :host "127.0.0.1" :service t
               :family 'ipv4 :noquery t :coding 'utf-8-unix
               :log (lambda (_server connection _message) (push connection connections))
               :filter (lambda (connection chunk)
                         (let ((request (concat (process-get connection 'request) chunk)))
                           (process-put connection 'request request)
                           (when (and (string-match "\r\n\r\n" request)
                                      (string-suffix-p "Worker completed" request))
                             (setq received (substring request (match-end 0)))
                             (process-send-string connection
                                                  "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nOK")
                             (delete-process connection)))))))
        (unwind-protect
            (progn
              ;; A second isolated provider uses the same tested fake-provider
              ;; mechanics, its own script/status and no real model endpoint.
              (with-temp-file extension
                (insert-file-contents pichat-test-fake-provider-extension)
                (goto-char (point-min))
                (while (search-forward "PICHAT_FAKE_PROVIDER" nil t)
                  (replace-match "PICHAT_REVIEW_PROVIDER" t t))
                (goto-char (point-min))
                (search-forward "const provider = \"pichat-fake\";")
                (replace-match "const provider = \"pichat-reviewer\";" t t))
              (make-directory review-directory)
              (let* ((url (format "http://127.0.0.1:%d/notify" (process-contact server :service)))
                     (command
                      (concat "node -e "
                              (shell-quote-argument
                               (format "fetch('%s',{method:'POST',body:'Worker completed'}).then(r=>{if(!r.ok)process.exit(1)})" url))))
                     (script (list :turns
                                   (vector (list :expectContextIncludes
                                                 ["WORKER_RESULT café ✓" "untrusted JSON data"]
                                                 :expectTool '(:name "bash")
                                                 :toolCall (list :name "bash" :arguments (list :command command)))
                                           '(:text "Notification delivered")))))
                (with-temp-file review-script
                  (insert (decode-coding-string
                           (json-serialize script :null-object nil :false-object :false) 'utf-8)))
                (let* ((handler-spec
                        (let ((pichat-pi-extra-args (list "-e" extension)))
                          (pichat-job-launch-capture
                           "Notify reviewer" (concat "Review supplied context and send only a concise outcome to " url
                                                     ". Do not send transcripts or credentials; report failure without retry.")
                           review-directory '(:preset coding :model "pichat-reviewer/pichat-fake" :target local))))
                       (handler (pichat-job-save store handler-spec))
                       (spec (plist-put (pichat-test-job-spec project-dir "read") :after-job-id handler))
                       (id (pichat-job-executor-submit executor spec)))
                  (pichat-test-job-wait store id "finished")
                  (let* ((origin (pichat-job-record store 'runs id))
                         (child-id (plist-get (plist-get origin :dispatch) :run-id)))
                    (pichat-test-job-wait store child-id "finished")
                    (let* ((child (pichat-job-record store 'runs child-id))
                           (runtime (pichat-job-execution-session
                                     (gethash child-id (pichat-job-executor-contexts executor)))))
                      (should (equal (plist-get child :result) "completed"))
                      (should (equal (plist-get (plist-get child :spec) :configuration)
                                     (plist-get handler-spec :configuration)))
                      (should (equal (plist-get (pichat-session-model runtime) :provider) "pichat-reviewer"))
                      (should-not (pichat-session-alive-p runtime))
                      (should-not (plist-get child :dispatch)))
                    (should (equal received "Worker completed"))
                    (should (equal origin (pichat-job-record store 'runs id)))
                    (should (= (length (pichat-job-records store 'runs)) 2))
                    (should (eq (current-buffer) original-buffer))
                    (should (eq (selected-window) original-window))
                    (should (eq pichat-current-session current))
                    (pichat-test-assert-provider-script-consumed status-file)
                    (pichat-test-assert-provider-script-consumed review-status)))))
          (dolist (connection connections) (when (process-live-p connection) (delete-process connection)))
          (delete-process server)))))

  (ert-deftest pichat-integration-job-followup-handles-agent-error-and-active-cancellation ()
    (dolist (outcome '(error cancel))
      (pichat-test-with-job-executor
          (:script (if (eq outcome 'error)
                       '(:turns [(:error "Fixture provider failure")])
                     '(:turns [(:text "Delayed result" :delayMs 800)])))
        (let* ((handler (pichat-job-save store (pichat-test-job-spec project-dir "observe")))
               (spec (plist-put (pichat-test-job-spec project-dir "read") :after-job-id handler))
               (id (pichat-job-executor-submit executor spec))
               (execution (gethash id (pichat-job-executor-contexts executor))))
          (when (eq outcome 'cancel)
            (pichat-test-wait-until
             (lambda () (and (pichat-job-execution-accepted execution)
                             (pichat-job-execution-started execution)))
             5 "worker accepted and started before active cancellation")
            (pichat-job-executor-cancel executor id))
          (pichat-test-job-wait store id "uncertain")
          (let* ((origin (pichat-job-record store 'runs id))
                 (child-id (plist-get (plist-get origin :dispatch) :run-id)))
            (should-not (plist-get origin :result))
            (pichat-test-job-wait store child-id (if (eq outcome 'error) "uncertain" "finished"))
            (let ((child (pichat-job-record store 'runs child-id)))
              (should (equal (plist-get child :result) (unless (eq outcome 'error) "completed")))
              (should (equal (plist-get (plist-get child :event) :result) (plist-get origin :result)))
              (should-not (plist-get child :dispatch)))
            (should (equal origin (pichat-job-record store 'runs id)))
            (should (= (length (pichat-job-records store 'runs)) 2))
            (pichat-test-assert-provider-script-consumed status-file))))))

  (ert-deftest pichat-integration-jobs-share-workspace-without-locking ()
    (pichat-test-with-job-executor
        (:script '(:turns [(:text "Independent job completed" :delayMs 1500)]))
      (let* ((pichat-jobs-max-concurrency 2)
             (spec (pichat-test-job-spec project-dir))
             (legacy (pichat-test-job-spec project-dir "write"))
             (first (pichat-job-executor-submit executor spec))
             (second (pichat-job-executor-submit executor legacy)))
        (pichat-test-wait-until
         (lambda () (seq-every-p
                     (lambda (id) (pichat-job-execution-started
                                   (gethash id (pichat-job-executor-contexts executor))))
                     (list first second)))
         5 "both same-workspace jobs started")
        (dolist (id (list first second))
          (should (equal (plist-get (pichat-job-record store 'runs id) :state) "running")))
        (let ((third (pichat-job-enqueue store spec)))
          (should (equal (plist-get (pichat-job-admission store third 2) :reason)
                         "Global concurrency limit"))
          (pichat-job-cancel-queued store third))
        (dolist (id (list first second))
          (pichat-test-job-wait store id "finished")
          (should (equal (plist-get (pichat-job-record store 'runs id) :result) "completed")))
        (should (equal spec (plist-get (pichat-job-record store 'runs first) :spec)))
        (should (equal legacy (plist-get (pichat-job-record store 'runs second) :spec))))))

  (ert-deftest pichat-integration-job-completes-only-after-canonical-sync-without-focus ()
    (pichat-test-with-job-executor
        (:script '(:turns [(:text "DEPENDENCY_RESULT" :delayMs 60)]))
      (let* ((current (pichat-session-make))
             (pichat-current-session current)
             (original-buffer (current-buffer))
             (original-window (selected-window))
             (id (pichat-job-executor-submit executor (pichat-test-job-spec project-dir "read")))
             (execution (gethash id (pichat-job-executor-contexts executor)))
             (runtime (pichat-job-execution-session execution)))
        (pichat-test-job-wait store id "finished")
        (let ((run (pichat-job-record store 'runs id)))
          (should (equal (plist-get run :result) "completed"))
          (should (string-match-p "DEPENDENCY_RESULT" (plist-get run :summary)))
          (should (file-exists-p (plist-get run :session-file))))
        (should (pichat-job-execution-accepted execution))
        (should (pichat-job-execution-settled execution))
        (should (pichat-chat-canonical-entry-cache runtime))
        (should (eq (current-buffer) original-buffer))
        (should (eq (selected-window) original-window))
        (should (eq pichat-current-session current))
        (should-not (pichat-session-default-p runtime))
        (should-not (get-buffer-window (pichat-session-buffer runtime) t))
        (should-error (pichat-rpc-prompt runtime "Do not send another turn") :type 'user-error)
        (should (member "This runtime is owned by a job; use its job actions"
                        (pichat-reconfigure--chat-blockers runtime)))
        (pichat-test-assert-provider-script-consumed status-file))))

  (ert-deftest pichat-integration-job-saved-session-open-never-reruns-or-duplicates-writer ()
    (pichat-test-with-job-executor
        (:script '(:turns [(:text "DEPENDENCY_RESULT" :delayMs 60)]))
      (let* ((id (pichat-job-executor-submit executor (pichat-test-job-spec project-dir "read")))
             (execution (gethash id (pichat-job-executor-contexts executor)))
             (runtime (pichat-job-execution-session execution)))
        (pichat-test-job-wait store id "finished")
        (pichat-test-assert-provider-script-consumed status-file)
        (should-not (pichat-session-alive-p runtime))
        (should (buffer-local-value 'buffer-read-only (pichat-session-buffer runtime)))
        (let ((record (pichat-job-record store 'runs id))
              (file (pichat-session-session-file runtime)) reopened)
          (pichat-jobs--show-detail executor 'runs id)
          (should-not (string-match-p "Continue in chat" (buffer-string)))
          (should (member "Continue in chat…" (pichat-test-job-actions)))
          (should-not (string-match-p "Finishing runtime cleanup\\|Stopping runtime" (buffer-string)))
          (pichat-test-job-press "Preview conversation")
          (should buffer-read-only)
          (should (string-match-p "DEPENDENCY_RESULT" (buffer-string)))
          (pichat-view-quit)
          (kill-buffer (pichat-session-buffer runtime))
          ;; A saved-session open must not consume another model turn.
          (with-temp-file script-file (insert "{\"turns\":[]}"))
          (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
            (pichat-jobs--open-saved executor id))
          (pichat-test-wait-until
           (lambda ()
             (cl-some (lambda (session)
                        (and (not (eq session runtime))
                             (equal (pichat-session-session-file session) file)
                             (pichat-chat-canonical-entry-cache session)
                             (setq reopened session)))
                      (pichat-session-list)))
           12 "saved job conversation to open independently without a model turn")
          (with-current-buffer (pichat-session-buffer reopened)
            (should (string-match-p "DEPENDENCY_RESULT" (buffer-string))))
          (should (equal (pichat-job-record store 'runs id) record))
          (should (= (hash-table-count pichat--source-reservations) 0))
          (should-error (pichat-jobs--open-saved executor id) :type 'user-error)
          (pichat-test-assert-provider-script-consumed status-file)
          ;; Continuing extends the saved conversation but not this run's evidence.
          (with-temp-file script-file (insert "{\"turns\":[{\"text\":\"LATER_REPLY\"}]}"))
          ;; The already running fixture loaded an empty script: replace it first.
          (pichat-stop-session reopened)
          (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
            (pichat-jobs--open-saved executor id))
          (pichat-test-wait-until
           (lambda ()
             (cl-some (lambda (session)
                        (and (not (eq session runtime)) (not (eq session reopened))
                             (equal (pichat-session-session-file session) file)
                             (pichat-chat-canonical-entry-cache session)
                             (setq reopened session)))
                      (pichat-session-list))) 12 "continuation ready")
          (pichat-rpc-prompt reopened "Follow up")
          (pichat-test-wait-until
           (lambda ()
             (with-current-buffer (pichat-session-buffer reopened)
               (string-match-p "LATER_REPLY" (buffer-string)))) 12 "continued response")
          (pichat-jobs--preview executor id)
          (goto-char (point-min))
          (search-forward "DEPENDENCY_RESULT")
          (should (equal (get-text-property (1- (point)) 'pichat-preview-entry-id)
                         (plist-get (pichat-job-evidence-read store
                                      (plist-get record :evidence)) :leaf)))
          (should-not (string-match-p "LATER_REPLY" (buffer-string)))
          (should (equal (pichat-job-record store 'runs id) record))))))

  (ert-deftest pichat-integration-job-acceptance-is-not-completion-or-kill-permission ()
    (pichat-test-with-job-executor
        (:script '(:turns [(:text "Delayed result" :delayMs 700)]))
      (let* ((id (pichat-job-executor-submit executor (pichat-test-job-spec project-dir "read")))
             (execution (gethash id (pichat-job-executor-contexts executor)))
             (runtime (pichat-job-execution-session execution)))
        (pichat-test-wait-until (lambda () (pichat-job-execution-accepted execution)))
        (should (equal (plist-get (pichat-job-record store 'runs id) :state) "running"))
        (should-not (kill-buffer (pichat-session-buffer runtime)))
        (should (buffer-live-p (pichat-session-buffer runtime)))
        ;; Explicitly selecting an active chat is allowed; completion leaves it
        ;; readable instead of closing its window or permitting new job input.
        (pop-to-buffer (pichat-session-buffer runtime))
        (let ((window (selected-window)))
          (pichat-test-job-wait store id "finished")
          (should (eq (selected-window) window))
          (should (eq (window-buffer window) (pichat-session-buffer runtime)))
          (should buffer-read-only)
          (should (string-match-p "Delayed result" (buffer-string)))
          (should-not (pichat-session-alive-p runtime)))
        (pichat-test-assert-provider-script-consumed status-file))))

  (ert-deftest pichat-integration-job-sync-failure-retains-slot-not-workspace-lock ()
    (pichat-test-with-job-executor
        (:script '(:turns [(:text "Unsynchronized result" :delayMs 50)]))
      (let* ((original (symbol-function 'pichat-chat--apply-sync-response))
             (id nil))
        (cl-letf (((symbol-function 'pichat-chat--apply-sync-response)
                   (lambda (response full base)
                     (if (and pichat-chat-session
                              (pichat-test-count-raw-events pichat-chat-session "agent_settled")
                              (> (pichat-test-count-raw-events pichat-chat-session "agent_settled") 0))
                         (error "Injected result-sync rejection")
                       (funcall original response full base)))))
          (setq id (pichat-job-executor-submit executor (pichat-test-job-spec project-dir)))
          (pichat-test-job-wait store id "uncertain"))
        (let ((next (pichat-job-enqueue store (pichat-test-job-spec project-dir))))
          (should (eq (plist-get (pichat-job-admission store next) :ready) t))
          (should-not (eq (plist-get (pichat-job-admission store next 1) :ready) t)))
        (should-not (plist-get (pichat-job-record store 'runs id) :result))
        (pichat-test-assert-provider-script-consumed status-file))))

  (ert-deftest pichat-integration-job-pre-settlement-snapshot-cannot-complete-run ()
    (pichat-test-with-job-executor
        (:script '(:turns [(:text "POST_SETTLEMENT_RESULT" :delayMs 200)]))
      (let ((original (symbol-function 'pichat-backend-get-transcript))
            held intercept id execution)
        (cl-letf (((symbol-function 'pichat-backend-get-transcript)
                   (lambda (session cursor success &optional failure)
                     (if intercept (funcall original session cursor success failure)
                       (setq intercept t)
                       (funcall original session cursor
                                (lambda (response session)
                                  (setq held (lambda () (funcall success response session))))
                                failure)))))
          (setq id (pichat-job-executor-submit executor (pichat-test-job-spec project-dir "read"))
                execution (gethash id (pichat-job-executor-contexts executor)))
          (pichat-test-wait-until (lambda () (and held (pichat-job-execution-settled execution))))
          (should (equal (plist-get (pichat-job-record store 'runs id) :state) "settling"))
          (funcall held)
          (pichat-test-job-wait store id "finished")
          (should (string-match-p "POST_SETTLEMENT_RESULT"
                                  (plist-get (pichat-job-record store 'runs id) :summary)))
          (pichat-test-assert-provider-script-consumed status-file)))))


(ert-deftest pichat-job-captured-ssh-cleanup-keeps-claims-until-exit-proof ()
  (pichat-test-with-owned-job
    (setf (pichat-session-transport session)
          (pichat-transport--create :id "test" :kind 'ssh :label "test"
                                    :tramp-prefix "/ssh:invalid.example:"))
    (let* ((cache (pichat-pi-entry-cache-full
                   "pi-source" "/example/session.jsonl"
                   '((:type "message" :id "final" :parentId nil
                      :message (:role "assistant" :content ((:type "text" :text "Captured response"))
                                :stopReason "stop"))) "final"))
           (payload (list :cache cache :settlement-sequence 1 :process-generation 1
                          :session-id "pi-source" :session-file "/example/session.jsonl"))
           (observers 0) callbacks ready receipt stopped)
      (setf (pichat-session-state session) 'idle
            (pichat-job-execution-settled execution) t
            (pichat-job-execution-settlement execution) 1)
      (pichat-job-executor--advance execution "running")
      (pichat-job-executor--advance execution "settling")
      (cl-letf (((symbol-function 'pichat-process-lifetime-supported-p) (lambda (_) t))
                ((symbol-function 'pichat-process-lifetime-watch)
                 (lambda (_transport _cwd _process _seconds _live r callback)
                   (cl-incf observers) (setq ready r receipt callback) #'ignore))
                ((symbol-function 'pichat-job-executor--call)
                 (lambda (_execution _type _payload callback) (push callback callbacks)))
                ((symbol-function 'pichat-backend-stop-session) (lambda (_) (setq stopped t))))
        ;; Both sync notifications qualify before either idle-state reply arrives.
        (pichat-job-executor--synchronized execution payload)
        (pichat-job-executor--synchronized execution payload)
        (dolist (callback (reverse callbacks)) (funcall callback nil))
        (should (= observers 1))
        (should-not stopped)
        (should (equal (plist-get (pichat-job-executor--run execution) :state) "settling"))
        (should-error (pichat-job-executor-cancel executor id) :type 'user-error)
        (funcall ready)
        (should stopped)
        (funcall receipt nil "Remote exit not confirmed")
        (let ((run (pichat-job-executor--run execution)))
          (should (equal (plist-get run :state) "uncertain"))
          (should (equal (plist-get (pichat-job-evidence-read store (plist-get run :evidence)) :response)
                         "Captured response"))
          (should-not (plist-get run :result)))))))


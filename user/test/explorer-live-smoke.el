;;; explorer-live-smoke.el --- Isolated terminal explorer walkthrough -*- lexical-binding: t; -*-

;; Run from the repository root: ELPACA_BUILDS=/path/to/builds \
;;   emacs -Q -nw -l user/test/explorer-live-smoke.el
;; Repeat with EXPLORER_OVERRIDE=1. EXPLORER_PLAN names a valid plan in
;; this project (default json-data-explorer). Only read-only CLI calls run.

(require 'cl-lib)
(require 'ert)

(defun explorer-smoke--load ()
  (let* ((builds (or (getenv "ELPACA_BUILDS") ".local/elpaca/builds"))
         (vui (expand-file-name "vui" builds)))
    (dolist (dir (directory-files builds t "\\`[^.]"))
      (when (and (file-directory-p dir) (not (equal dir vui)))
        (push dir load-path)))
    (require 'use-package)
    (setq use-package-always-defer t use-package-expand-minimally t
          use-package-ensure-function #'ignore
          evil-want-keybinding nil evil-undo-system 'undo-redo
          user-emacs-directory default-directory)
    (require 'general)
    (require 'evil)
    (require 'evil-collection)
    (evil-collection-init '(special-mode))
    (when (getenv "EXPLORER_OVERRIDE")
      (setq evil-collection-binding-overrides
            '((action :key "<f8>") (next-button :key "gN")
              (previous-button :key "gP")
              (history-previous :key ("C-o" "gH"))
              (history-next :key ("C-i" "gL"))
              (refresh :key "gR") (find-file :key "gF"))))
    (evil-mode 1)
    (autoload 'doom-modeline-mode "doom-modeline")
    (setq my/theme 'tango)
    (load (expand-file-name "core/visual-config.el") nil t)
    (load (expand-file-name "core/utils.el") nil t)
    (require 'load-relative)
    ;; Use the real module loader and registration; skip unrelated modules
    ;; and simulate Elpaca activation without installing anything.
    (with-temp-buffer
      (insert-file-contents "core/package.el")
      (cl-loop for form = (read (current-buffer))
               when (and (eq (car-safe form) 'defun)
                         (eq (cadr form) 'my/load-packages))
               return (eval form t)))
    (let ((skip (lambda (original modules &optional isolate)
                  (unless (eq (car modules) 'keybindings)
                    (funcall original modules isolate)))))
      (advice-add 'my/load-packages :around skip)
      (unwind-protect (load (my/emacs-main-dir "user/package.el") nil t)
        (advice-remove 'my/load-packages skip)))
    (should-not (featurep 'json-explore))
    (should-not (featurep 'plans-explore))
    (push vui load-path)
    (run-hooks 'elpaca-after-init-hook)
    (dolist (command '(json-explore-buffer json-explore-run-command
                       plans-explore-list plans-explore-show
                       plans-explore-check plans-explore-workspaces))
      (should (commandp command)))))

(defvar explorer-smoke--last-keys nil)

(defun explorer-smoke--press (keys)
  (setq explorer-smoke--last-keys keys)
  (execute-kbd-macro (kbd keys)))

(defun explorer-smoke--wait ()
  (let ((end (+ (float-time) 5)))
    (while (and json-explore--request (< (float-time) end))
      (accept-process-output nil 0.05)))
  (should-not json-explore--request))

(defun explorer-smoke--keys (action next previous override)
  (let* ((value (json-explore-parse
                 "[{\"n\":1000,\"obj\":{\"needle\":1}},{\"n\":2,\"obj\":{\"other\":2}}]"))
         (explorer (json-explore-show-value value "*Explorer smoke keys*"))
         (back (if override "gH" "H"))
         (forward (if override "gL" "L")))
    (dolist (pair `((,action . json-explore-open) (,next . json-explore-next-cell)
                    (,previous . json-explore-previous-cell)
                    (,back . json-explore-back) (,forward . json-explore-forward)
                    ("C-o" . json-explore-back) ("C-i" . json-explore-forward)
                    ("S-<return>" . json-explore-open-other-window)
                    ("S-RET" . json-explore-open-other-window)
                    ("M-<return>" . json-explore-display-other-window)
                    ("M-RET" . json-explore-display-other-window)
                    ("h" . evil-backward-char) ("l" . evil-forward-char)
                    ("w" . evil-forward-word-begin) ("b" . evil-backward-word-begin)
                    ("gg" . evil-goto-first-line) ("G" . evil-goto-line)
                    ("y" . evil-yank) ("ZQ" . json-explore-evil-quit)))
      (should (equal (cons (car pair) (key-binding (kbd (car pair)))) pair)))
    (if override
        (progn
          (should-not (eq (key-binding (kbd "RET")) 'json-explore-open))
          (should-not (eq (key-binding (kbd "<tab>")) 'json-explore-next-cell))
          (should-not (eq (key-binding (kbd "<backtab>")) 'json-explore-previous-cell))
          (should-not (memq (key-binding (kbd "g]")) '(json-explore-next-cell vui-forward)))
          (should-not (memq (key-binding (kbd "g[")) '(json-explore-previous-cell vui-backward)))
          (should-not (eq (key-binding (kbd "H")) 'json-explore-back))
          (should-not (eq (key-binding (kbd "L")) 'json-explore-forward)))
      ;; Raw TAB is C-i in a terminal; test the distinct <tab> event above.
      (should (eq (key-binding (kbd "RET")) 'json-explore-open))
      (should (eq (key-binding (kbd "<S-tab>")) 'json-explore-previous-cell))
      (should (eq (key-binding (kbd "g]")) 'json-explore-next-cell))
      (should (eq (key-binding (kbd "g[")) 'json-explore-previous-cell)))
    (should (eq (window-buffer) explorer))
    (vui-flush-sync)
    (should (vui-goto-key '(nil 0 index)))
    (explorer-smoke--press next)
    (should (equal (vui-key-at) '(nil 0 "n")))
    (explorer-smoke--press previous)
    (should (equal (vui-key-at) '(nil 0 index)))
    (unless override
      (explorer-smoke--press "g]")
      (should (equal (vui-key-at) '(nil 0 "n")))
      (explorer-smoke--press "g[")
      (should (equal (vui-key-at) '(nil 0 index))))
    (explorer-smoke--press "gl gh gl l j")
    (should (equal (vui-key-at) '(nil 1 "n")))
    (explorer-smoke--press "k o")
    (should (equal (vui-key-at) '(nil 0 "n")))
    (should (equal (json-explore--visible-rows json-explore--view (json-explore--sort-at nil)) '(1 0)))
    (explorer-smoke--press "O gl")
    (should (equal (json-explore--visible-rows json-explore--view (json-explore--sort-at nil)) '(0 1)))
    (explorer-smoke--press action)
    (should (equal (vui-key-at) '((0 "obj") "needle" key)))
    (dolist (keys (list (cons back forward) '("C-o" . "C-i")))
      (explorer-smoke--press (car keys))
      (should (equal (vui-key-at) '(nil 0 "obj")))
      (should (cdr (json-explore--sort-at nil)))
      (explorer-smoke--press (cdr keys))
      (should (equal (vui-key-at) '((0 "obj") "needle" key))))
    (goto-char (point-min))
    (explorer-smoke--press "/ n e e d l e RET")
    (should (equal (vui-key-at) '((0 "obj") "needle" key)))
    (goto-char (point-max))
    (explorer-smoke--press "? n e e d l e RET")
    (should (equal (vui-key-at) '((0 "obj") "needle" key)))
    (explorer-smoke--press "Y gO")
    (should (equal (car kill-ring) ".[0][\"obj\"][\"needle\"]"))
    (should (eq (window-buffer) explorer))
    (let ((inspection json-explore--inspection))
      (should (get-buffer-window inspection))
      (explorer-smoke--press "go")
      (should (eq (current-buffer) inspection))
      (select-window (get-buffer-window explorer))
      (explorer-smoke--press "K")
      (should (eq (current-buffer) inspection))
      (should (equal (buffer-string) "1"))
      (should buffer-read-only))
    (select-window (get-buffer-window explorer))
    (save-window-excursion
      (explorer-smoke--press "g?")
      (should (get-buffer-window "*Help*"))
      (with-current-buffer "*Help*"
        (goto-char (point-min))
        (should (search-forward "H/L (like Evil Collection" nil t))))
    (dolist (key '("q" "ZZ" "ZQ"))
      (delete-other-windows)
      (switch-to-buffer "*scratch*")
      ;; Test each quit in a secondary window so even Evil's ZQ is isolated.
      (select-window (split-window-below))
      (switch-to-buffer explorer)
      (explorer-smoke--press key)
      (should-not (get-buffer-window explorer))
      (switch-to-buffer "*scratch*"))))

(defun explorer-smoke--header ()
  (redisplay t)
  (format-mode-line (or (window-parameter nil 'header-line-format) header-line-format)
                    'header-line (selected-window)))

(defun explorer-smoke--sticky (action)
  (delete-other-windows)
  (let* ((name "*Explorer smoke sticky %b*")
         (breadcrumb (concat name " › rows"))
         (window (selected-window)))
    (json-explore-show-value
     (json-explore-parse
      (concat "{\"rows\":[" (mapconcat (lambda (n) (format "{\"n\":%d}" n))
                                      (number-sequence 0 99) ",") "]}"))
     name)
    (should (equal (explorer-smoke--header) name))
    (should-not (string-match-p "^\\.$" (buffer-string)))
    (should (vui-goto-key '(nil "rows" section)))
    (explorer-smoke--press action)
    (should (vui-goto-key '(("rows") 0 "n")))
    (explorer-smoke--press "o")
    (should (save-excursion (goto-char (point-min)) (looking-at-p "Sorted by")))
    (set-window-start window (point-min))
    (should (equal (explorer-smoke--header) breadcrumb))
    (should (vui-goto-key '(("rows") 40 "n")))
    (let ((start (line-beginning-position)))
      (set-window-start window start)
      (should (string-match-p "Index +n *$" (explorer-smoke--header)))
      (should (= (window-start window) start))
      (explorer-smoke--press action)
      (explorer-smoke--press "C-o")
      (should (string-match-p "Index +n *$" (explorer-smoke--header)))
      (should (equal (vui-key-at) '(("rows") 40 "n")))
      (should (= (window-start window) start)))
    (should (vui-goto-key '(("rows") 0 "n")))
    (set-window-start window (point-min))
    (should (equal (explorer-smoke--header) breadcrumb))))

(defun explorer-smoke--composite (action next previous)
  (delete-other-windows)
  (let ((name "*Explorer smoke composite*")
        (window (selected-window)))
    (json-explore-show-value
     (json-explore-parse
      (concat "{\"id\":42,\"name\":\"example\",\"literal\":\"null\",\"first\":["
              (mapconcat (lambda (n) (format "{\"a\":%d}" n)) (number-sequence 0 59) ",")
              "],\"second\":["
              (mapconcat (lambda (n) (format "{\"b\":%d}" n)) (number-sequence 0 59) ",")
              "]}")) name)
    (should (vui-goto-key '(nil "name" value)))
    (should (looking-at-p "example *$"))
    (should (eq (get-text-property (point) 'face) 'json-explore-string-face))
    (should (vui-goto-key '(nil "literal" value)))
    (should (looking-at-p "\"null\" *$"))
    (should (vui-goto-key '(nil "first" section)))
    (should (looking-at-p "▸ first +\\[60 items\\]"))
    (explorer-smoke--press "zo")
    (should (equal (json-explore--cell-at) '(nil "first" section)))
    (explorer-smoke--press next)
    (should (equal (json-explore--cell-at) '(("first") 0 index)))
    (explorer-smoke--press "gl j o")
    (should (equal (json-explore--cell-at) '(("first") 1 "a")))
    (explorer-smoke--press "zc")
    (should-not (vui-goto-key '(("first") 0 "a")))
    (explorer-smoke--press "za zR")
    (should (vui-goto-key '(("first") 59 "a")))
    (explorer-smoke--press next)
    (should (equal (json-explore--cell-at) '(nil "second" section)))
    (explorer-smoke--press previous)
    (should (equal (json-explore--cell-at) '(("first") 59 "a")))
    (dolist (case '((("first") 12 "a") (("second") 12 "b")))
      (should (vui-goto-key case))
      (set-window-start window (line-beginning-position))
      (should (string-match-p (format "Index +%s *$" (nth 2 case)) (explorer-smoke--header))))
    (explorer-smoke--press "Y")
    (should (equal (car kill-ring) ".[\"second\"][12][\"b\"]"))
    (let ((start (window-start window)))
      (explorer-smoke--press action)
      (should (equal (json-explore--view-path json-explore--view) '("second" 12 "b")))
      (explorer-smoke--press "C-o")
      (should (= (window-start window) start))
      (should (equal (json-explore--cell-at) '(("second") 12 "b")))
      (should (equal (json-explore--sort-at '("first")) '("a")))
      (should-not (json-explore--sort-at '("second"))))
    (explorer-smoke--press "zM")
    (should (equal (json-explore--cell-at) '(nil "second" section)))
    (should-not (string-match-p "Index" (buffer-string)))
    (set-window-start window (point-min))
    (should (equal (explorer-smoke--header) name))))

(defun explorer-smoke--command (refresh override)
  (let ((file (make-temp-file "explorer-smoke-")))
    (unwind-protect
        (progn
          (write-region "echo '{\"x\":42}'; echo initial-warning >&2" nil file nil 'silent)
          (json-explore-run-command "sh" (list file))
          (when override
            (should-not (eq (key-binding (kbd "gr")) 'json-explore-refresh)))
          (explorer-smoke--wait)
          (should (= (json-explore--value-at-point) 42))
          (should (string-match-p "stderr: initial-warning" (buffer-string)))
          (write-region "echo invalid; echo failed >&2" nil file nil 'silent)
          (explorer-smoke--press refresh)
          (explorer-smoke--wait)
          (should (= (json-explore--value-at-point) 42))
          (should (string-match-p "Exit status 0:.*\nstderr: failed" (buffer-string)))
          (write-region "echo '{\"x\":43}'" nil file nil 'silent)
          (explorer-smoke--press refresh)
          (explorer-smoke--wait)
          (should (= (json-explore--value-at-point) 43))
          (should-not (json-explore--view-diagnostic json-explore--view)))
      (delete-file file))))

(defun explorer-smoke--plans (action visit refresh override)
  (let* ((id (or (getenv "EXPLORER_PLAN") "json-data-explorer"))
         (explorer (plans-explore-list)))
    (explorer-smoke--wait)
    (should (json-explore--view-value json-explore--view))
    (should (equal (explorer-smoke--header) "Plans list"))
    (let* ((rows (json-explore--view-value json-explore--view))
           (index (cl-position id rows :test #'equal :key (lambda (row) (gethash "id" row)))))
      (should (natnump index))
      (should (vui-goto-key (list nil index 'index))))
    (should-not (plans-explore--record))
    (explorer-smoke--press action)
    (explorer-smoke--wait)
    (let* ((record (plans-explore--record))
           (file (gethash "path" record))
           (line (gethash "line" (aref (gethash "tasks" record) 0))))
      (should (equal (gethash "id" record) id))
      (explorer-smoke--press refresh)
      (explorer-smoke--wait)
      (should (equal (gethash "id" (plans-explore--record)) id))
      (should (equal (explorer-smoke--header) (concat "Plans show " id)))
      (should-not (vui-goto-key '(nil "org" section)))
      (should-not (string-match-p "Org text (" (buffer-string)))
      (should (stringp (gethash "org" (json-explore-current-snapshot))))
      (goto-char (point-min))
      (should-not (json-explore-thing-at-point))
      (when override
        (should-not (eq (key-binding (kbd "gf")) 'json-explore-visit)))
      (explorer-smoke--press visit)
      (should (equal buffer-file-name file))
      (should (and view-mode buffer-read-only (= (point) (point-min))
                   (not (buffer-modified-p))))
      (select-window (get-buffer-window explorer))
      (should (vui-goto-key '(("tasks") 0 "state")))
      (should (vui-goto-key '(nil "tasks" section)))
      (explorer-smoke--press "za")
      (should-not (vui-goto-key '(("tasks") 0 "title")))
      (explorer-smoke--press "za")
      (should (vui-goto-key '(nil "tasks" section)))
      (beginning-of-line)
      ;; The plain column header is between the disclosure and the task.
      (explorer-smoke--press "j")
      (should-not (json-explore-thing-at-point))
      (explorer-smoke--press "j")
      (should (bolp))
      (should (equal (vui-key-at) '(("tasks") 0 index)))
      (explorer-smoke--press visit)
      (should (equal buffer-file-name file))
      (should (and view-mode buffer-read-only (= (line-number-at-pos) line)
                   (not (buffer-modified-p))))
      (select-window (get-buffer-window explorer))
      (should (vui-goto-key '(nil "tasks" section)))
      (explorer-smoke--press action)
      (should (equal (json-explore--view-path json-explore--view) '("tasks"))))
    (explorer-smoke--press "C-o C-o")
    (should-not (plans-explore--record))
    (explorer-smoke--press "C-i")
    (should (equal (gethash "id" (plans-explore--record)) id))
    (plans-explore-show id)
    (explorer-smoke--wait)
    (should (equal (gethash "id" (plans-explore--record)) id))
    (plans-explore-check)
    (explorer-smoke--wait)
    (should (cl-some (lambda (row) (and (equal (gethash "id" row) id)
                                       (eq (gethash "valid" row) t)))
                     (json-explore--view-value json-explore--view)))
    (plans-explore-workspaces)
    (explorer-smoke--wait)
    (should (vectorp (gethash "workspaces" (json-explore--view-value json-explore--view))))
    (should (vui-goto-key '(nil "workspaces" section)))
    (explorer-smoke--press action)
    (should (vectorp (json-explore--view-value json-explore--view)))))

(defun explorer-smoke--narrow ()
  (delete-other-windows)
  (let* ((id (or (getenv "EXPLORER_PLAN") "json-data-explorer"))
         (explorer (plans-explore-show id)))
    (explorer-smoke--wait)
    (should (eq (window-buffer) explorer))
    ;; Start wide, then exercise VUI's actual resize hook in both directions.
    (redisplay t)
    (should (vui-goto-key '(nil "path" value)))
    (let* ((typed (json-explore--value-at-point))
           (start (point))
           (wide-lines (count-lines start (next-single-property-change start 'vui-key))))
      (split-window (selected-window) 40 'right)
      (should (= (window-total-width) 40))
      (redisplay t)
      (vui-flush-sync)
      (should (equal (vui-key-at) '(nil "path" value)))
      (should (vui-goto-key '(nil "path" value)))
      (let* ((indent (current-column))
             (end (next-single-property-change (point) 'vui-key))
             (lines (split-string (buffer-substring-no-properties (point) end) "\n")))
        (should (> (length lines) wide-lines))
        (should (<= (+ indent (string-width (car lines))) (window-body-width)))
        (should (cl-every (lambda (line)
                           (and (string-prefix-p (make-string indent ?\s) line)
                                (<= (string-width line) (window-body-width))))
                         (cdr lines)))
        (should (equal (concat (car lines)
                               (mapconcat (lambda (line) (substring line indent)) (cdr lines) ""))
                       typed)))
      (delete-other-windows)
      (redisplay t)
      (vui-flush-sync)
      (should (equal (vui-key-at) '(nil "path" value)))
      (should (= (count-lines (point) (next-single-property-change (point) 'vui-key)) wide-lines))))
  (let ((name "*Explorer smoke narrow %b*"))
    (json-explore-show-value
     (json-explore-parse "{\"long_preceding_segment\":{\"rows\":[{\"n\":1},{\"n\":2}]}}") name)
    (should (vui-goto-key '(nil "long_preceding_segment" section)))
    (json-explore-open)
    (should (vui-goto-key '(("long_preceding_segment") "rows" section)))
    (json-explore-open)
    (set-window-start nil (point-min))
    (should (equal (explorer-smoke--header) (concat name " › long_preceding_segment › rows")))
    (split-window (selected-window) 40 'right)
    (should (equal (explorer-smoke--header) "… › long_preceding_segment › rows"))
    (should (vui-goto-key '(("long_preceding_segment" "rows") 1 "n")))
    (set-window-start nil (line-beginning-position))
    (should (string-match-p "Index +n *$" (explorer-smoke--header)))
    (set-window-start nil (point-min))
    (delete-other-windows)
    (should (equal (explorer-smoke--header) (concat name " › long_preceding_segment › rows")))))

(defun explorer-smoke--main ()
  (let* ((override (getenv "EXPLORER_OVERRIDE"))
         (action (if override "<f8>" "<return>"))
         (next (if override "gN" "<tab>"))
         (previous (if override "gP" "<backtab>"))
         (refresh (if override "gR" "gr"))
         (visit (if override "gF" "gf"))
         (stage 'load))
    (condition-case err
        (progn
          (explorer-smoke--load)
          (setq stage 'keys) (explorer-smoke--keys action next previous override)
          (setq stage 'sticky) (explorer-smoke--sticky action)
          (setq stage 'composite) (explorer-smoke--composite action next previous)
          (setq stage 'command) (explorer-smoke--command refresh override)
          (setq stage 'plans) (explorer-smoke--plans action visit refresh override)
          (setq stage 'narrow) (explorer-smoke--narrow)
          (send-string-to-terminal (format "\r\nPASS: explorer smoke (%s)\r\n" (if override "overrides" "defaults")))
          (kill-emacs 0))
      (error
       (send-string-to-terminal (format "\r\nFAIL: %s (last keys %S): %S\r\n"
                                       stage explorer-smoke--last-keys err))
       (kill-emacs 1)))))

(add-hook 'emacs-startup-hook
          (lambda () (run-at-time 0 nil #'explorer-smoke--main)))
;;; explorer-live-smoke.el ends here

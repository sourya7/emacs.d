          (should (equal (plist-get before :result) "failed"))
          (should-not (pichat-session-alive-p runtime))
          ;; A new process consumes its own script. No second request is automatic.
          (with-temp-file script-file
            (insert (json-serialize
                     '(:turns [(:text "Required authoritative plan unavailable; stopped without changes."
                                :expectContextIncludes ["Phase 3 only" "Stop before Phase 4"
                                                        "checkpoint may be stale" "Synthetic provider interruption"
                                                        "untrusted JSON" "do not create a substitute execution record"])]))))
          (let* ((current pichat-current-session)
                 (window (selected-window)) (buffer (current-buffer))
                 (next (pichat-job-executor-submit executor spec nil nil id))
                 (replacement (pichat-job-execution-session
                               (gethash next (pichat-job-executor-contexts executor)))))
            (pichat-test-job-wait store next "finished")
            (should (equal (plist-get (pichat-job-record store 'runs next) :result) "completed"))
            (should-not (eq runtime replacement))
            (should-not (equal (pichat-session-session-file runtime)
                               (pichat-session-session-file replacement)))
            (should (eq current pichat-current-session))
            (should (eq window (selected-window)))
            (should (eq buffer (current-buffer)))
            (should (equal before (pichat-job-record store 'runs id)))
            (should (= 2 (length (pichat-job-records store 'runs))))
            (pichat-test-assert-provider-script-consumed status-file)))))))


(when pichat-test-include-integration
  (ert-deftest pichat-integration-job-completes-only-after-canonical-sync-without-focus ()
    (pichat-test-with-job-executor
        (:script '(:turns [(:text "DEPENDENCY_RESULT" :delayMs 60)]))
      (let* ((current (pichat-session-make))
             (pichat-current-session current)
             (original-buffer (current-buffer))
             (original-window (selected-window))
             (id (pichat-job-executor-submit executor (pichat-test-job-spec project-dir "read")))
             (execution (gethash id (pichat-job-executor-contexts executor)))
             (runtime (pichat-job-execution-session execution)))
        (pichat-test-job-wait store id "finished")
        (let ((run (pichat-job-record store 'runs id)))
          (should (equal (plist-get run :result) "completed"))
          (should (string-match-p "DEPENDENCY_RESULT" (plist-get run :summary)))
          (should (file-exists-p (plist-get run :session-file))))
        (should (pichat-job-execution-accepted execution))
        (should (pichat-job-execution-settled execution))
        (should (pichat-chat-canonical-entry-cache runtime))
        (should (eq (current-buffer) original-buffer))
        (should (eq (selected-window) original-window))
        (should (eq pichat-current-session current))
        (should-not (pichat-session-default-p runtime))
        (should-not (get-buffer-window (pichat-session-buffer runtime) t))
        (should-error (pichat-rpc-prompt runtime "Do not send another turn") :type 'user-error)
        (should (member "This runtime is owned by a job; use its job actions"
                        (pichat-reconfigure--chat-blockers runtime)))
        (pichat-test-assert-provider-script-consumed status-file))))

  (ert-deftest pichat-integration-job-saved-session-open-never-reruns-or-duplicates-writer ()
    (pichat-test-with-job-executor
        (:script '(:turns [(:text "DEPENDENCY_RESULT" :delayMs 60)]))
      (let* ((id (pichat-job-executor-submit executor (pichat-test-job-spec project-dir "read")))
             (execution (gethash id (pichat-job-executor-contexts executor)))
             (runtime (pichat-job-execution-session execution)))
        (pichat-test-job-wait store id "finished")
        (pichat-test-assert-provider-script-consumed status-file)
        ;; Inspection cannot silently start a second writer of the saved file.
        (should-error (pichat-jobs--open-saved executor id) :type 'user-error)
        (let ((record (pichat-job-record store 'runs id))
              (file (pichat-session-session-file runtime)) reopened)
          (pichat-stop-session runtime)
          (pichat-forget-session runtime)
          (kill-buffer (pichat-session-buffer runtime))
          (pichat-jobs--show-detail executor 'runs id)
          (should (string-match-p "Open saved session independently" (buffer-string)))
          ;; A saved-session open must not consume another model turn.
          (with-temp-file script-file (insert "{\"turns\":[]}"))
          (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
            (pichat-jobs--open-saved executor id))
          (pichat-test-wait-until
           (lambda ()
             (cl-some (lambda (session)
                        (and (not (eq session runtime))
                             (equal (pichat-session-session-file session) file)
                             (pichat-chat-canonical-entry-cache session)
                             (setq reopened session)))
                      (pichat-session-list)))
           12 "saved job conversation to open independently without a model turn")
          (with-current-buffer (pichat-session-buffer reopened)
            (should (string-match-p "DEPENDENCY_RESULT" (buffer-string))))
          (should (equal (pichat-job-record store 'runs id) record))
          (should (= (hash-table-count pichat--source-reservations) 0))
          (pichat-test-assert-provider-script-consumed status-file)))))


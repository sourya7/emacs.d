                                       (should (string-prefix-p "DUPLICATED_TITLE" header-line-format))
                                       (should-not (string-match-p "DUPLICATED_TITLE" (buffer-string)))
                                       (when (eq kind 'runs) (pichat-test-job-press "Details"))
				       (should-not (string-match-p "^Task$\\|^Instructions$\\|Full task" (buffer-string)))
				       (goto-char (text-property-any (point-min) (point-max) 'pichat-job-section 'task))
				       (let* ((start (point))
					      (end (next-single-property-change start 'pichat-job-section))

    (let* ((original (concat (mapconcat (lambda (n) (format "Original line %d" n))
                                      (number-sequence 1 10) "\n") "\nORIGINAL_END"))
           (guidance (concat (mapconcat (lambda (n) (format "Guidance line %d" n))
                                      (number-sequence 1 10) "\n") "\nGUIDANCE_END"))

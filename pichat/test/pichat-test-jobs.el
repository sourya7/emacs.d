(ert-deftest pichat-jobs-compact-execution-retains-exact-metadata-in-raw-inspection ()
  (pichat-test-with-job-executor ()
    (dolist (access '("write" "read"))
      (let* ((clock "2026-11-01T00:44:48.414546363Z")
             (spec (pichat-job-launch-capture
                    "Inspect" "Inspect the supplied files." project-dir
                    '(:preset standard :model "pichat-fake/pichat-fake" :target local)))
             (file "/captured/session.jsonl")
             origin id)
        ;; Persisted historical fields remain inspectable, but have no policy.
        (setf (plist-get spec :resources) (vector (list :key project-dir :access access)))
        (cl-letf (((symbol-function 'pichat-job--now) (lambda () clock)))
          (setq origin (pichat-job-enqueue store spec))
          (pichat-job-cancel-queued store origin)
          (setq id (pichat-job-enqueue store spec nil nil origin))
          (setq clock "2026-11-01T00:44:48.447431017Z")
          (let ((token (plist-get (pichat-job-claim store id) :attempt)))
            (pichat-job-advance store id token "running"
                                (list :runtime-id "captured-runtime" :session-file file))
            (pichat-job-advance store id token "settling")
            (setq clock "2026-11-01T00:45:29.224605175Z")
            (pichat-job-advance store id token "finished"
                                '(:result "completed" :safe-to-release t :synchronized t))))
        (let ((before (pichat-job-record store 'runs id)))
          (cl-letf (((symbol-function 'pichat-rpc-send) (lambda (&rest _) (ert-fail "Sent RPC")))
                    ((symbol-function 'pichat-start-prepared-session) (lambda (&rest _) (ert-fail "Started Pi"))))
            (pichat-jobs--show-detail executor 'runs id)
            (pichat-test-job-press "Details")
            (should (string-match-p "Preset: standard · Tools: Pi defaults" (buffer-string)))
            (dolist (timestamp '("2026-11-01T00:44:48Z" "2026-11-01T00:45:29Z"))
              (should (string-match-p
                       (regexp-quote (format-time-string "%Y-%m-%d %H:%M:%S %Z"
                                                         (date-to-time timestamp)))
                       (buffer-string))))
            (dolist (hidden (list "Project/workspace:" "Run ID:" "Saved session:" "Runtime ID:"
                                  "Repeated from:" ".414546363" ".447431017" ".224605175"))
              (should-not (string-match-p (regexp-quote hidden) (buffer-string))))
            (should-not (string-match-p "Overlap policy:" (buffer-string)))
            (should-not (string-match-p "Copy run ID\\|Copy saved-session path" (buffer-string)))
            (should (member "Copy saved-session path" (pichat-test-job-actions)))
            (pichat-test-job-press "Copy saved-session path")
            (should (equal (current-kill 0) file))
            (should-not (string-match-p "Instructions & settings" (buffer-string)))
            (should (string-match-p (regexp-quote id) (buffer-string)))
            (dolist (hidden (list origin "captured-runtime"))
              (should-not (string-match-p (regexp-quote hidden) (buffer-string))))
            (should (string-match-p "Repeated from an earlier run." (buffer-string)))
            (let ((report (current-buffer)))
              (pichat-test-job-press "Previous run")
              (should (equal pichat-jobs--detail (cons 'runs origin)))
              (pichat-view-quit)
              (should (eq (current-buffer) report))
              (should (member 'execution pichat-jobs--expanded)))
            (pichat-test-job-press "Inspect raw settings…")
            (dolist (exact (list id origin "captured-runtime" file project-dir
                                 "2026-11-01T00:44:48.414546363Z"
                                 "2026-11-01T00:44:48.447431017Z"
                                 "2026-11-01T00:45:29.224605175Z"))
              (should (string-match-p (regexp-quote exact) (buffer-string))))
            (should (string-match-p (format ":access[[:space:]]+%S" access) (buffer-string)))
            (should (equal before (pichat-job-record store 'runs id)))))))))

(ert-deftest pichat-jobs-local-times-handle-date-rollover-and-dst-with-chronological-sorting ()
  (let ((previous-zone (getenv "TZ")))
    (unwind-protect
        (pichat-test-with-job-views
          (set-time-zone-rule "EST5EDT,M3.2.0/2,M11.1.0/2")
          (let* ((spec (pichat-test-job-spec project-dir))
                 (job (pichat-job-save store spec))
                 ids)
            (dolist (scenario '(("2026-11-01T00:44:48.414546363Z" "2026-10-31 20:44:48 EDT")
                                ("2026-11-01T05:50:00Z" "2026-11-01 01:50:00 EDT")
                                ("2026-11-01T06:10:00Z" "2026-11-01 01:10:00 EST")))
              (cl-letf (((symbol-function 'pichat-job--now) (lambda () (car scenario))))
                (let* ((id (pichat-job-enqueue store nil job))
                       (token (plist-get (pichat-job-claim store id) :attempt)))
                  (push id ids)
                  (pichat-job-advance store id token "running")
                  (pichat-job-advance store id token "settling")
                  (pichat-job-advance store id token "finished"
                                      '(:result "completed" :safe-to-release t :synchronized t))
                  (pichat-jobs--show-detail executor 'runs id)
                  (should-not (string-match-p (regexp-quote (cadr scenario)) (buffer-string)))
                  (pichat-test-job-press "Details")
                  (should (string-match-p "Times (local):" (buffer-string)))
                  (should (string-match-p (regexp-quote (cadr scenario)) (buffer-string)))
                  (pichat-test-job-press "Inspect raw settings…")
                  (should (eq pichat-jobs--section 'raw))
                  (should (string-match-p (regexp-quote (car scenario)) (buffer-string)))
                  (should (equal (plist-get (pichat-job-record store 'runs id) :created-at)
                                 (car scenario))))))
            (pichat-jobs--show-detail executor 'jobs job)
            (should (string-match-p "Nov 1, 01:10 EST" (buffer-string)))
            (pichat-jobs)
            (pichat-jobs-toggle)
            ;; Local clocks go backwards at DST end; sorting must not.
            (dolist (width '(60 140))
              (cl-letf (((symbol-function 'window-body-width) (lambda (&rest _) width)))
                (dolist (descending '(nil t))
                  (setq tabulated-list-sort-key (cons "Queued" descending))
                  (pichat-jobs-refresh)
                  (should (assoc "Queued" (append tabulated-list-format nil)))
                  (let (displayed)
                    (goto-char (point-min))
                    (while (not (eobp))
                      (when-let* ((id (tabulated-list-get-id))) (push id displayed))
                      (forward-line 1))
                    (should (equal (nreverse displayed) (if descending ids (reverse ids))))))))))
      (set-time-zone-rule previous-zone))))


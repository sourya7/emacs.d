      (let ((copy (pichat-job--copy data)))
        (setf (plist-get (aref (plist-get copy :runs) 0) :trigger)
              '(:kind "once" :schedule-token "t" :due 1.0))
        (should-error (pichat-job--validate copy) :type 'pichat-job-error))

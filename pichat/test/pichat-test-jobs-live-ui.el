;;; pichat-test-jobs-live-ui.el --- Isolated live jobs checks -*- lexical-binding: t; -*-

;;; Commentary:
;; Opt-in separate Emacs only; not loaded by the regular suite.  No user state,
;; real provider, or user's live Emacs is used.  These drive controls/geometry;
;; they do not replace visible human layout review.  See TESTING_GUIDELINES.md.

;;; Code:
(require 'pichat-test-job-support)
(require 'pichat-jobs)

(ert-deftest pichat-integration-jobs-live-ui-schedule ()
  (pichat-test-with-job-executor (:script '(:turns [(:text "LIVE_SCHEDULE_RESULT")]))
    (let* ((job (pichat-job-save store (pichat-test-job-spec project-dir)))
           (future (+ (float-time) 3600))
           (transient-history nil)
           (transient-history-file (expand-file-name "transient-history.el" agent-dir)))
      (unwind-protect
          (progn
            (pichat-jobs--show-detail executor 'jobs job)
            (let ((details (current-buffer)))
              (pichat-test-job-command "Set schedule…")
              (should (eq (oref transient--prefix command) 'pichat-job-schedule-menu))
              (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "Every")))
                (execute-kbd-macro (kbd "k")))
              (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "hours"))
                        ((symbol-function 'read-number) (lambda (&rest _) 2)))
                (execute-kbd-macro (kbd "i")))
              (cl-letf (((symbol-function 'read-string)
                         (lambda (&rest _) (format-time-string "%Y-%m-%d %H:%M" (seconds-to-time future)))))
                (execute-kbd-macro (kbd "s")))
              (should-not (plist-get (pichat-job-record store 'jobs job) :schedule))
              (execute-kbd-macro (kbd "q"))
              (should (eq (current-buffer) details))
              (should-not (plist-get (pichat-job-record store 'jobs job) :schedule))
              (pichat-test-job-command "Set schedule…")
              (cl-letf (((symbol-function 'read-string)
                         (lambda (&rest _) (format-time-string "%Y-%m-%d %H:%M" (seconds-to-time future)))))
                (execute-kbd-macro (kbd "s")))
              (execute-kbd-macro (kbd "RET"))
              (should (eq (current-buffer) details))
              (should (string-match-p "Schedule: Once · Disabled" (buffer-string)))
              (should (equal (pichat-job-records store 'runs) []))
              (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
                (pichat-test-job-command "Enable…"))
              (should (string-match-p "Schedule: Once · Enabled" (buffer-string)))
              (pichat-test-job-command "Disable")
              (should (string-match-p "Schedule: Once · Disabled" (buffer-string)))
              ;; Test an actual short timer without depending on minute-picker timing.
              (pichat-job-executor-schedule-change executor job
                                                   (list :kind "once" :start (+ (float-time) 0.3)))
              (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
                (pichat-test-job-command "Enable…"))
              (pichat-test-wait-until (lambda () (> (length (pichat-job-records store 'runs)) 0)) 5 "live scheduled run")
              (let ((id (plist-get (aref (pichat-job-records store 'runs) 0) :id)))
                (pichat-test-job-wait store id "finished")
                (should (eq (current-buffer) details))
                (should (equal pichat-jobs--detail (cons 'jobs job)))
                (should (string-match-p "Once · Dispatched" (buffer-string)))
                (pichat-test-job-press "Details")
                (should-not (string-match-p "View scheduled run" (buffer-string)))
                (pichat-test-job-goto-button "Last occurrence: Submitted")
                (execute-kbd-macro (kbd "RET"))
                (should (equal pichat-jobs--detail (cons 'runs id)))
                (should (string-match-p "LIVE_SCHEDULE_RESULT" (buffer-string))))
              (pichat-test-assert-provider-script-consumed status-file)))
        (when transient--prefix (transient-quit-all))))))

(ert-deftest pichat-integration-jobs-live-ui-actions ()
  (should-not noninteractive)
  (pichat-test-with-job-executor ()
    (let* ((spec (pichat-test-job-spec project-dir))
           (_duplicate (pichat-job-save store spec))
           (job (pichat-job-save store spec))
           (before (pichat-job-records store 'jobs)) submitted)
      (unwind-protect
          (progn
            (pichat-jobs--show-detail executor 'jobs job)
            (should (string-prefix-p "Review files" header-line-format))
            (should-not (string-match-p "Actions…" (buffer-string)))
            (pichat-test-job-goto-button "Details")
            (should (looking-at "▸ Details"))
            (should-not transient--prefix)
            (execute-kbd-macro (kbd (if (pichat-view-evil-normal-p) "g a" "a")))
            (should (eq (oref transient--prefix command) 'pichat-jobs-actions-menu))
            (should (equal (plist-get (transient-scope) :detail) (cons 'jobs job)))
            (execute-kbd-macro (kbd "q"))
            (should (plist-get pichat-jobs--actions :closed))
            (should-not transient--prefix)
            (should (equal before (pichat-job-records store 'jobs)))
            (should (equal (pichat-job-records store 'runs) []))
            (execute-kbd-macro (kbd (if (pichat-view-evil-normal-p) "g a" "a")))
            (execute-kbd-macro (kbd "I"))
            (should (eq pichat-jobs--section 'raw))
            (should (equal (buffer-string) (pp-to-string (pichat-job-record store 'jobs job))))
            (execute-kbd-macro (kbd "q"))
            (should-not pichat-jobs--section)
            (should-not (string-match-p "Inspect raw settings" (buffer-string)))
            (should (equal before (pichat-job-records store 'jobs)))
            (execute-kbd-macro (kbd (if (pichat-view-evil-normal-p) "g a" "a")))
            (should (eq (oref transient--prefix command) 'pichat-jobs-actions-menu))
            (cl-letf (((symbol-function 'pichat-job-executor-submit)
                       (lambda (&rest args) (setq submitted args))))
              (execute-kbd-macro (kbd "r")))
            (should (equal submitted (list executor nil job)))
            (should-not transient--prefix)
            (should (equal pichat-jobs--detail (cons 'jobs job))))
        (when transient--prefix (transient-quit-all))))))

(ert-deftest pichat-integration-jobs-live-ui-saved-editor ()
  (should-not noninteractive)
  (pichat-test-with-job-executor ()
    (let* ((pichat-jobs--executor executor) (pichat-jobs-file (pichat-job-store-file store))
           (transient-history nil)
           (transient-history-file (expand-file-name "transient-history.el" agent-dir))
           (spec (pichat-test-job-spec project-dir))
           (handler (pichat-job-save store spec)) (job (pichat-job-save store spec))
           (original (pichat-job-record store 'jobs job))
           (other (expand-file-name "other/" project-dir)))
      (make-directory other)
      (unwind-protect
          (cl-labels
              ((stage ()
                 (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "Edited live job")))
                   (execute-kbd-macro (kbd "n")))
                 (execute-kbd-macro (kbd "i"))
                 (should-not transient--prefix)
                 (should (derived-mode-p 'text-mode))
                 (erase-buffer) (insert "Discard this instruction edit")
                 (execute-kbd-macro (kbd "C-c C-k"))
                 (should (eq (oref transient--prefix command) 'pichat-job-edit-menu))
                 (execute-kbd-macro (kbd "i"))
                 (erase-buffer) (insert "Live multiline\ninstructions.")
                 (execute-kbd-macro (kbd "C-c C-c"))
                 (should (eq (oref transient--prefix command) 'pichat-job-edit-menu))
                 (cl-letf (((symbol-function 'completing-read)
                            (lambda (_prompt choices &rest _)
                              (car (seq-find (lambda (entry) (equal (cdr entry) handler)) choices)))))
                   (execute-kbd-macro (kbd "a")))
                 (cl-letf (((symbol-function 'read-directory-name) (lambda (&rest _) other))
                           ((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
                   (execute-kbd-macro (kbd "d")))
                 (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "review")))
                   (execute-kbd-macro (kbd "p")))
                 (cl-letf (((symbol-function 'pichat--list-models-async)
                            (lambda (_query callback &rest _)
                              (run-at-time 0.01 nil callback '("fixture")) nil))
                           ((symbol-function 'pichat--read-model-table-choice)
                            (lambda (&rest _) "pichat-fake/pichat-fake")))
                   (execute-kbd-macro (kbd "m"))
                   (pichat-test-wait-until
                    (lambda () (and transient--prefix
                                    (eq (oref transient--prefix command) 'pichat-job-edit-menu)))
                    2 "model returned to saved-job editor"))
                 (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "local")))
                   (execute-kbd-macro (kbd "t")))
                 (should-not (string-match-p "coordination" (format "%S" (get 'pichat-job-edit-menu 'transient--layout))))
                 (dolist (key '("q" "RET"))
                   (cl-letf (((symbol-function 'pichat-tool-picker--discover) #'ignore)
                             ((symbol-function 'pichat-tool-picker--discover-extensions) #'ignore))
                     (execute-kbd-macro (kbd "x")))
                   (should (eq (oref transient--prefix command) 'pichat-tool-picker))
                   (execute-kbd-macro (kbd key))
                   (should (eq (oref transient--prefix command) 'pichat-job-edit-menu)))))
            (pichat-jobs)
            (pichat-jobs--select job)
            (let ((origin (current-buffer)))
              (execute-kbd-macro (kbd (if (pichat-view-evil-normal-p) "g e" "e")))
              (should (eq (oref transient--prefix command) 'pichat-job-edit-menu))
              (stage)
              (should (equal original (pichat-job-record store 'jobs job)))
              (execute-kbd-macro (kbd "q"))
              (should (eq origin (current-buffer)))
              (execute-kbd-macro (kbd (if (pichat-view-evil-normal-p) "g e" "e")))
              (should (equal spec (plist-get (plist-get (transient-scope) :draft) :spec)))
              (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "")))
                (execute-kbd-macro (kbd "n")))
              (should-error (execute-kbd-macro (kbd "RET")) :type 'user-error)
              (should (eq (oref transient--prefix command) 'pichat-job-edit-menu))
              (stage)
              (cl-letf (((symbol-function 'rename-file) (lambda (&rest _) (error "Fixture write failure"))))
                (should-error (execute-kbd-macro (kbd "RET"))))
              (should (eq (oref transient--prefix command) 'pichat-job-edit-menu))
              (should (equal original (pichat-job-record store 'jobs job)))
              (cl-letf (((symbol-function 'read-string) (lambda (&rest _) (ert-fail "Save prompted again"))))
                (execute-kbd-macro (kbd "RET")))
              (should-not transient--prefix)
              (should (eq origin (current-buffer)))
              (should (equal (tabulated-list-get-id) job)))
            (let ((saved (plist-get (pichat-job-record store 'jobs job) :spec)))
              (should (equal (plist-get saved :title) "Edited live job"))
              (should (equal (plist-get saved :instructions) "Live multiline\ninstructions."))
              (should (equal (plist-get saved :directory) other))
              (should (equal (plist-get saved :after-job-id) handler))
              (should-not (plist-member saved :resources)))
            (pichat-jobs--show-detail executor 'jobs job)
            (pichat-test-job-command "Edit…")
            (should (eq (oref transient--prefix command) 'pichat-job-edit-menu))
            (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "Discard by quit")))
              (execute-kbd-macro (kbd "n")))
            (execute-kbd-macro (kbd "C-g"))
            (should (plist-get pichat-job--settings :closed))
            (pichat-test-job-command "Edit…")
            (should (equal (plist-get (plist-get (transient-scope) :draft) :title) "Edited live job"))
            (execute-kbd-macro (kbd "q"))
            (should (equal (pichat-job-records store 'runs) []))
            (should-not (pichat-session-list))
            (garbage-collect)
            (should-not (seq-some (lambda (buffer)
                                   (with-current-buffer buffer (derived-mode-p 'pichat-job-setup-mode)))
                                 (buffer-list))))
        (when transient--prefix (transient-quit-all))))))

(ert-deftest pichat-integration-jobs-live-ui-interval ()
  (should-not noninteractive)
  (pichat-test-with-job-executor (:script '(:turns [(:text "LIVE_INTERVAL_RESULT")]))
    (let* ((job (pichat-job-save store (pichat-test-job-spec project-dir)))
           (start (+ (float-time) 0.3)))
      (pichat-jobs--show-detail executor 'jobs job)
      (pichat-job-executor-schedule-change
       executor job (list :kind "interval" :start start :seconds 3600))
      (pichat-job-executor-schedule-enable executor job t)
      (let ((details (current-buffer)) (window (selected-window)))
        (pichat-test-wait-until (lambda () (= (length (pichat-job-records store 'runs)) 1))
                                5 "first interval occurrence")
        (let ((id (plist-get (aref (pichat-job-records store 'runs) 0) :id)))
          (pichat-test-job-wait store id "finished")
          (should (equal (plist-get (pichat-job-record store 'runs id) :result) "completed"))
          (should (eq (current-buffer) details))
          (should (eq (selected-window) window))
          (should (string-match-p "Every 1 hour · Enabled" (buffer-string)))
          (let ((schedule (plist-get (pichat-job-record store 'jobs job) :schedule)))
            (should (= (plist-get schedule :next) (+ start 3600)))
            (should (equal (plist-get (plist-get schedule :last) :run-id) id)))
          (pichat-test-job-command "Disable")
          (should (string-match-p "Every 1 hour · Disabled" (buffer-string)))
          (should (= (hash-table-count (pichat-job-executor-schedules executor)) 0))
          (should (= (length (pichat-job-records store 'runs)) 1))
          (pichat-test-assert-provider-script-consumed status-file))))))

(ert-deftest pichat-integration-jobs-live-ui-selected-phase ()
  (should-not noninteractive)
  (let* ((skill (getenv "PICHAT_TEST_PLANS_SKILL"))
         (helper (and skill (expand-file-name "scripts/plans.py" skill))))
    (unless skill
      (ert-skip "Set PICHAT_TEST_PLANS_SKILL to the installed plans skill directory"))
    (unless (file-readable-p helper)
      (ert-fail "The explicitly configured plans helper is unreadable"))
    (pichat-test-with-job-executor (:script '(:turns []))
      (let* ((plan (expand-file-name ".plans/example/plan.org" project-dir))
             (result (expand-file-name "phase-one.txt" project-dir))
             (now (format-time-string "%Y-%m-%dT%H:%M:%SZ" nil t))
             (pichat-pi-extra-args (append pichat-pi-extra-args (list "--skill" skill))))
        (should (= 0 (process-file "python3" nil nil nil helper "--root" project-dir "--local"
                                  "new" "--id" "example" "--title" "Isolated example")))
        (with-temp-file plan
          (insert (format
                   (concat "#+TITLE: Isolated example\n"
                           "#+TODO: TODO IN-PROGRESS BLOCKED | DONE\n"
                           "#+PLAN_ID: example\n#+PLAN_STATUS: ready\n"
                           "#+PLAN_CREATED: %s\n#+PLAN_UPDATED: %s\n\n"
                           "* Goal\nExercise one selected phase.\n* Tasks\n"
                           "** Phase 1\n*** TODO Write phase-one.txt\nWrite phase-one, then stop.\n"
                           "** Phase 2\n*** TODO Do not execute\nAdjacent phase is unauthorized.\n"
                           "* Checkpoint\n- Plan status: ready\n- Next action: execute Phase 1 only.\n"
                           "* Verification\nInspect the artifact and check the plan.\n"
                           "* History\n- Isolated fixture.\n") now now)))
        ;; Deterministic tool choices verify ordinary dispatch and bookkeeping,
        ;; not autonomous reasoning or machine-enforced approval of prose gates.
        (with-temp-file script-file
          (insert (json-serialize
                   (list :turns
                         (vector
                          (list :toolCall (list :name "read" :arguments
                                                (list :path (expand-file-name "references/lifecycle.md" skill)))
                                :expectContextIncludes ["Project plans" "Phase 1 only"])
                          (list :toolCall (list :name "read" :arguments
                                                (list :path (expand-file-name "references/storage.md" skill))))
                          (list :toolCall (list :name "read" :arguments (list :path plan)))
                          (list :toolCall (list :name "write" :arguments
                                                (list :path result :content "phase-one\n")))
                          (list :toolCall (list :name "read" :arguments (list :path result)))
                          (list :toolCall
                                (list :name "edit" :arguments
                                      (list :path plan :edits
                                            [(:oldText "*** TODO Write phase-one.txt"
                                              :newText "*** DONE Write phase-one.txt")
                                             (:oldText "- Next action: execute Phase 1 only."
                                              :newText "- Next action: await Phase 2 authorization.")
                                             (:oldText "Inspect the artifact and check the plan."
                                              :newText "phase-one.txt verified; structural check passed.")])))
                          (list :toolCall
                                (list :name "bash" :arguments
                                      (list :command (mapconcat #'shell-quote-argument
                                                               (list "python3" helper "--root" project-dir
                                                                     "--local" "check" "example") " ")
                                            :timeout 10)))
                          '(:text "PHASE_ONE_RESULT: stopped before Phase 2."
                            :expectContextIncludes ["phase-one" "plan.org: OK"]))))))
        (let* ((prompt (format (concat "/skill:plans run example Phase 1 only. Authoritative plan: %s. "
                                      "Execution checkout: %s. Stop before Phase 2; do not commit or push.")
                               plan project-dir))
               (spec (pichat-job-launch-capture
                      "One selected phase" prompt project-dir
                      '(:preset coding :model "pichat-fake/pichat-fake" :target local))))
          (pichat-job--setup spec nil executor)
          (pichat-test-job-goto-button "Run once")
          (execute-kbd-macro (kbd "RET"))
          (let ((origin (current-buffer)) (window (selected-window))
                (id (plist-get (aref (pichat-job-records store 'runs) 0) :id)))
            (pichat-test-job-wait store id "finished")
            (should (equal (plist-get (pichat-job-record store 'runs id) :result) "completed"))
            (should (eq (current-buffer) origin))
            (should (eq (selected-window) window))
            (should (equal (pichat-job-records store 'jobs) []))
            (should (equal (with-temp-buffer (insert-file-contents result) (buffer-string)) "phase-one\n"))
            (with-temp-buffer
              (insert-file-contents plan)
              (should (string-match-p "DONE Write phase-one.txt" (buffer-string)))
              (should (string-match-p "TODO Do not execute" (buffer-string))))
            (should (= 0 (process-file "python3" nil nil nil helper "--root" project-dir
                                      "--local" "check" "example")))
            (pichat-jobs--show-detail executor 'runs id)
            (should (string-match-p "PHASE_ONE_RESULT" (buffer-string)))
            (pichat-test-job-press "Preview conversation")
            (should (string-match-p "Phase 1 only" (buffer-string)))
            (pichat-test-assert-provider-script-consumed status-file)))))))

(ert-deftest pichat-integration-jobs-live-ui-followup ()
  (pichat-test-with-job-executor
      (:script '(:turns [(:text "LIVE_FOLLOWUP_RESULT")]))
    (let* ((handler (pichat-job-save store (pichat-test-job-spec project-dir "observe")))
           (spec (plist-put (pichat-test-job-spec project-dir "read") :after-job-id handler)))
      (pichat-job--setup spec nil executor)
      (pichat-test-job-goto-button "Change…")
      (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "None")))
        (execute-kbd-macro (kbd "RET")))
      (should-not (plist-get (pichat-job--submission-spec) :after-job-id))
      (should (equal (pichat-job-records store 'runs) []))
      (pichat-test-job-goto-button "Change…")
      (cl-letf (((symbol-function 'completing-read)
                 (lambda (_prompt choices &rest _) (car (rassoc handler choices)))))
        (execute-kbd-macro (kbd "RET")))
      (pichat-test-job-goto-button "Run once")
      (execute-kbd-macro (kbd "RET"))
      (let* ((id (plist-get (aref (pichat-job-records store 'runs) 0) :id))
             (background (current-buffer)) (window (selected-window)))
        (pichat-test-job-wait store id "finished")
        (let ((child (plist-get (plist-get (pichat-job-record store 'runs id) :dispatch) :run-id)))
          (pichat-test-job-wait store child "finished")
          (should (eq (current-buffer) background))
          (should (eq (selected-window) window))
          (should (= (length (pichat-job-records store 'runs)) 2))
          (pichat-jobs--show-detail executor 'runs id)
          (pichat-test-job-press "Details")
          (should (string-match-p "After this run: Review files · Completed" (buffer-string)))
          (should-not (string-match-p "View follow-up run" (buffer-string)))
          (pichat-test-job-goto-button "After this run: Review files · Completed")
          (execute-kbd-macro (kbd "RET"))
          (should (equal pichat-jobs--detail (cons 'runs child)))
          (pichat-test-job-press "Details")
          (should (string-match-p "Triggered by:" (buffer-string)))
          (pichat-test-job-goto-button "Review files")
          (execute-kbd-macro (kbd "RET"))
          (should (equal pichat-jobs--detail (cons 'runs id))))))))

(ert-deftest pichat-integration-jobs-live-ui-execution-settings ()
  (pichat-test-with-job-executor ()
    (let ((pichat-jobs--executor executor)
          (transient-history nil)
          (transient-history-file (expand-file-name "transient-history.el" agent-dir))
          (pichat-jobs-file (pichat-job-store-file store)))
      (pichat-job--setup (pichat-test-job-spec project-dir) nil executor)
      (let ((setup (current-buffer))
            (before (pichat-presets--copy pichat-job--draft)))
        (unwind-protect
            (progn
              (pichat-test-job-goto-button "Execution settings…")
              (execute-kbd-macro (kbd "RET"))
              (should (eq (oref transient--prefix command) 'pichat-job-settings-menu))
              (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "coding"))
                        ((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
                (execute-kbd-macro (kbd "p")))
              (should (eq (oref transient--prefix command) 'pichat-job-settings-menu))
              (should (equal before pichat-job--draft))
              (execute-kbd-macro (kbd "q"))
              (should (equal before pichat-job--draft))
              (pichat-job-execution-settings)
              (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "coding"))
                        ((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
                (execute-kbd-macro (kbd "p")))
              (execute-kbd-macro (kbd "RET"))
              (should (eq (current-buffer) setup))
              (should (eq (button-get (button-at (point)) 'pichat-job-action)
                          'pichat-job-execution-settings))
              (should (eq (plist-get (plist-get pichat-job--draft :profile) :preset) 'coding))
              ;; Exercise the actual nested Tools Transient and its return path.
              (pichat-job-execution-settings)
              (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t))
                        ((symbol-function 'pichat-tool-picker--discover) #'ignore)
                        ((symbol-function 'pichat-tool-picker--discover-extensions) #'ignore))
                (execute-kbd-macro (kbd "x")))
              (should (eq (oref transient--prefix command) 'pichat-tool-picker))
              (execute-kbd-macro (kbd "q"))
              (should (eq (oref transient--prefix command) 'pichat-job-settings-menu))
              (execute-kbd-macro (kbd "q"))
              ;; Quitting the entire nested picker must not strand :pending.
              (pichat-job-execution-settings)
              (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t))
                        ((symbol-function 'pichat-tool-picker--discover) #'ignore)
                        ((symbol-function 'pichat-tool-picker--discover-extensions) #'ignore))
                (execute-kbd-macro (kbd "x")))
              (execute-kbd-macro (kbd "C-g"))
              (pichat-job--editable)
              ;; A model-list callback arrives after its prefix exits.
              (pichat-job-execution-settings)
              (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t))
                        ((symbol-function 'pichat--list-models-async)
                         (lambda (_query callback &rest _)
                           (run-at-time 0.01 nil callback '("fixture")) nil))
                        ((symbol-function 'pichat--read-model-table-choice)
                         (lambda (&rest _) "fixture/selected")))
                (execute-kbd-macro (kbd "m"))
                (pichat-test-wait-until
                 (lambda () (and transient--prefix
                                 (eq (oref transient--prefix command) 'pichat-job-settings-menu)))
                 2 "model picker returned to execution settings"))
              (should (equal (plist-get (plist-get (plist-get (transient-scope) :draft) :profile)
                                       :model) "fixture/selected"))
              (execute-kbd-macro (kbd "RET"))
              (should (equal (plist-get (plist-get pichat-job--draft :profile) :model)
                             "fixture/selected"))
              (should (eq (button-get (button-at (point)) 'pichat-job-action)
                          'pichat-job-execution-settings))
              (should (equal (pichat-job-records store 'runs) []))
              (should-not (pichat-session-list)))
          (when transient--prefix (transient-quit-all))
          (when (buffer-live-p setup) (kill-buffer setup)))))))

(ert-deftest pichat-integration-jobs-live-ui-manual-flow ()
  (should-not noninteractive)
  (pichat-test-with-job-executor
      (:script '(:turns [(:text "LIVE_JOB_RESULT" :delayMs 100)]))
    (let ((pichat-jobs--executor executor)
          (pichat-jobs-file (pichat-job-store-file store))
          (origin (window-buffer (selected-window))) setup job)
      (unwind-protect
          (progn
            (call-interactively #'pichat-job-new)
            (setq setup (current-buffer))
            (should (derived-mode-p 'pichat-job-setup-mode))
            (call-interactively (key-binding (kbd "<tab>")))
            (should (equal (button-label (button-at (point))) "Edit instructions…"))
            (call-interactively (key-binding (kbd "C-c C-e")))
            (insert "Inspect the supplied files.\nExplain the result briefly.")
            (call-interactively (key-binding (kbd "C-c C-c")))
            (should (eq (current-buffer) setup))
            (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "Live review")))
              (pichat-test-job-press "Save job…"))
            (setq job (plist-get (aref (pichat-job-records store 'jobs) 0) :id))
            (should (equal (pichat-job-records store 'runs) []))
            (pichat-test-job-press "Run once")
            (should (eq (current-buffer) origin))
            (let* ((id (plist-get (aref (pichat-job-records store 'runs) 0) :id))
                   (execution (gethash id (pichat-job-executor-contexts executor))))
              (pichat-test-job-wait store id "finished")
              (should (eq (current-buffer) origin))
              (should-not (get-buffer-window
                           (pichat-session-buffer (pichat-job-execution-session execution)) t))
              (call-interactively #'pichat-jobs)
              (call-interactively (key-binding (kbd "TAB")))
              (goto-char (point-min))
              (call-interactively (key-binding (kbd "RET")))
              (should (string-match-p "LIVE_JOB_RESULT" (buffer-string)))
              (should-not (string-match-p (regexp-quote pichat-test-fake-provider-extension) (buffer-string)))
              (should-not (string-match-p "Inspect raw settings" (buffer-string)))
              (should (member "Diagnostics" (pichat-test-job-actions)))
              (pichat-test-job-goto-button "Details")
              (call-interactively (key-binding (kbd "<tab>")))
              (should-not (string-match-p "Instructions & settings" (buffer-string)))
              (should-not (string-match-p "Runtime ID:" (buffer-string)))
              (should (string-match-p "Explain the result briefly" (buffer-string)))
              (should-not (string-match-p "Copy saved-session path" (buffer-string)))
              (let ((report (current-buffer)))
                (execute-kbd-macro (kbd (if (pichat-view-evil-normal-p) "g a" "a")))
                (execute-kbd-macro (kbd "f"))
                (should (equal (current-kill 0)
                               (plist-get (pichat-job-record store 'runs id) :session-file)))
                (should-not transient--prefix)
                (should (eq (current-buffer) report))
                (should (member 'execution pichat-jobs--expanded)))
              (should-not (string-match-p "Inspect raw settings" (buffer-string)))
              (pichat-test-job-press "Inspect raw settings…")
              (should (string-match-p (regexp-quote pichat-test-fake-provider-extension) (buffer-string)))
              (should (string-match-p ":runtime-id" (buffer-string)))
              (call-interactively (key-binding (kbd "q")))
              (should (member 'execution pichat-jobs--expanded))
              (pichat-test-job-press "Details")
              (should-not (string-match-p "Runtime ID:" (buffer-string)))
              (pichat-test-job-press "Details")
              (should (string-match-p "Times (local):" (buffer-string)))
              (should-not (string-match-p "Runtime ID:" (buffer-string)))
              (pichat-jobs-detail-refresh)
              (should (member 'execution pichat-jobs--expanded))
              (pichat-test-job-press "Preview conversation")
              (should buffer-read-only)
              (should (string-match-p "LIVE_JOB_RESULT" (buffer-string)))
              (should-not (pichat-session-alive-p (pichat-job-execution-session execution)))
              (pichat-view-quit)
              (should (derived-mode-p 'pichat-jobs-detail-mode)))
            (pichat-test-assert-provider-script-consumed status-file)
            (with-temp-file script-file (insert "{\"turns\":[{\"text\":\"SAVED_JOB_RESULT\",\"delayMs\":100}]}"))
            ;; The saved definition is distinct from the unsaved Run once.
            (call-interactively #'pichat-jobs)
            (call-interactively (key-binding (kbd "TAB")))
            (goto-char (point-min))
            (call-interactively (key-binding (kbd "RET")))
            (should (string-match-p "Never run" (buffer-string)))
            (should-not (string-match-p (regexp-quote job) (buffer-string)))
            (should (string-match-p "Schedule: None" (buffer-string)))
            (should-not (string-match-p "Model:" (buffer-string)))
            (should (text-property-any (point-min) (point-max) 'pichat-job-section 'task))
            (pichat-test-job-goto-button "Details")
            (call-interactively (key-binding (kbd "<tab>")))
            (should (string-match-p "Model:" (buffer-string)))
            (should-not (string-match-p "Instructions & settings" (buffer-string)))
            (should-not (string-match-p "Inspect raw settings" (buffer-string)))
            (pichat-test-job-press "Inspect raw settings…")
            (should-not (string-match-p ":resources\\|:access" (buffer-string)))
            (call-interactively (key-binding (kbd "q")))
            (should (member 'definition pichat-jobs--expanded))
            (let ((details (current-buffer)))
              (pichat-test-job-press "Run job")
              (let ((id (plist-get (pichat-jobs--latest store job) :id)))
                (pichat-test-job-wait store id "finished")
                (should (eq (current-buffer) details))
                (pichat-test-job-press "Completed ·")
                (should (equal pichat-jobs--detail (cons 'runs id)))
                (should (string-match-p "SAVED_JOB_RESULT" (buffer-string)))))
            (pichat-test-job-press "Run history")
            (should (= (length tabulated-list-entries) 1))
            (should (equal pichat-jobs--filter job))
            (should (string-match-p "Live review" mode-line-process))
            (call-interactively (key-binding (kbd "TAB")))
            (should (equal (tabulated-list-get-id) job))
            (pichat-test-assert-provider-script-consumed status-file))
        (maphash (lambda (_id execution) (pichat-job-executor--retire execution))
                 (pichat-job-executor-contexts executor))
        (dolist (buffer (buffer-list))
          (when (and (buffer-live-p buffer)
                     (with-current-buffer buffer
                       (or (eq pichat-jobs--owner executor)
                           (bound-and-true-p pichat-job-executor--buffer-execution))))
            (kill-buffer buffer)))))))

(ert-deftest pichat-integration-jobs-live-ui-graphical-resize ()
  (should (display-graphic-p))
  (pichat-test-with-job-executor ()
    (let* ((job (pichat-job-save store (pichat-test-job-spec project-dir)))
           (id (pichat-job-enqueue store nil job))
           (frame (selected-frame)) (original-width (frame-width)))
      (pichat-jobs--show-history executor job)
      (delete-other-windows)
      (unwind-protect
          ;; Real window sizes, not a mocked formatter width.
          (dolist (width '(70 140))
            (set-frame-width frame width)
            (pichat-test-wait-until
             (lambda () (if (< width 110) (< (window-body-width) 110)
                          (>= (window-body-width) 110)))
             3 "graphical Jobs window to resize")
            (pichat-jobs-refresh)
            (should (string-match-p "local" (buffer-string)))
            (should (string-match-p "Queued" (format-mode-line header-line-format)))
            (should (eq (not (null (assoc "Project / target" (append tabulated-list-format nil))))
                        (>= width 110))))
        (set-frame-width frame original-width))
      (should (equal (plist-get (pichat-job-record store 'runs id) :state) "queued"))
      (should-not (pichat-session-list)))))

(ert-deftest pichat-integration-jobs-live-ui-attention-and-uncertainty ()
  (should-not noninteractive)
  ;; Cached attention states use an inert owned process, not a model/provider.
  (pichat-test-with-owned-job
    (let ((waiter (pichat-job-enqueue store (pichat-test-job-spec project-dir)))
          (chat (pichat-chat-ensure session)) confirmation)
      (pichat-jobs--show-detail executor 'runs waiter)
      (should-not (member "Open blocking run" (pichat-test-job-actions)))
      (pichat-jobs--show-detail executor 'runs id)
      (cl-letf (((symbol-function 'yes-or-no-p)
                 (lambda (prompt) (setq confirmation prompt) nil)))
        (pichat-test-job-press "Cancel run…"))
      (should (string-match-p (regexp-quote project-dir) confirmation))
      (should (string-match-p "local" confirmation))
      (pichat-job-executor--advance execution "running")
      (with-current-buffer chat
        (pichat-chat--on-extension-ui-request
         session 'extension-ui-request
         '(:raw (:type "extension_ui_request" :id "live-input" :method "input"
                       :title "Review required"))))
      (pichat-jobs--render-detail)
      (should (string-match-p "Needs input" (buffer-string)))
      (should (string-match-p "Review required" (buffer-string)))
      (should-not (get-buffer-window chat t))
      (should-not (active-minibuffer-window))
      (setf (pichat-job-execution-cancelling execution) t)
      (pichat-job-executor--advance execution "settling")
      (should (string-prefix-p "Cancelling · " (buffer-string)))
      (cl-letf (((symbol-function 'pichat-job-executor-pump) #'ignore))
        (pichat-job-executor--advance execution "uncertain" '(:reason "Inspect descendants/workspace")))
      (should (string-match-p "Needs inspection" (buffer-string)))
      (should-not (string-match-p "Reservation: Held\\|recheck unavailable" (buffer-string)))
      (should (member "Release reservation…" (pichat-test-job-actions)))
      (pichat-test-job-press "Details")
      (should (string-match-p "Reservation: Held" (buffer-string)))
      (should-not (string-match-p "Recheck remote Pi exit" (buffer-string)))
      (should (equal (plist-get (pichat-job-admission store waiter 1) :reason)
                     "Global concurrency limit"))
      (should (eq (plist-get (pichat-job-admission store waiter 3) :ready) t)))))

(ert-deftest pichat-integration-jobs-live-ui-continuation ()
  ;; Also runnable in a separate terminal Emacs when no graphical display exists.
  (should-not noninteractive)
  (pichat-test-with-job-executor
      (:script '(:turns [(:error "Stopped fixture")]))
    (let* ((spec (pichat-test-job-spec project-dir "read"))
           (id (pichat-job-executor-submit executor spec)))
      (pichat-test-job-wait store id "uncertain")
      (pichat-test-assert-provider-script-consumed status-file)
      (pichat-rpc-stop (pichat-job-execution-session (gethash id (pichat-job-executor-contexts executor))))
      (pichat-job-executor-resolve executor id "Fixture inspected: no tool calls or descendants")
      (let ((original (pichat-job-record store 'runs id)))
        (pichat-jobs--show-detail executor 'runs id)
        (should-not (string-match-p "Repeat…\\|Continue in chat…" (buffer-string)))
        (should-not (string-match-p "Actions…" (buffer-string)))
        (pichat-test-job-goto-button "Details")
        (should (looking-at "▸ Details"))
        (should (member "Repeat…" (pichat-test-job-actions)))
        (should-not (string-match-p "Repeat…" (buffer-string)))
        (pichat-test-job-press "Continue work…")
        (let ((setup (current-buffer)))
          (pichat-test-job-press "Additional instructions…")
          (insert "Check the remaining work.")
          (call-interactively (key-binding (kbd "C-c C-c")))
          (should (eq setup (current-buffer)))
          (should (string-match-p "Check the remaining work" (buffer-string)))
          (with-temp-file script-file
            (insert "{\"turns\":[{\"text\":\"CONTINUED_RESULT\",\"expectContextIncludes\":[\"Check the remaining work\",\"Stopped fixture\"]}]}"))
          (pichat-test-job-press "Run once")
          (let* ((report (current-buffer)) (window (selected-window))
                 (next (plist-get (aref (pichat-job-records store 'runs) 1) :id)))
            (pichat-test-job-wait store next "finished")
            (should (eq report (current-buffer)))
            (should (eq window (selected-window)))
            (pichat-jobs--show-detail executor 'runs next)
            (should (string-match-p "CONTINUED_RESULT" (buffer-string)))
            (should-not (string-match-p "Repeat…\\|Continue work…" (buffer-string)))
            (should (member "Repeat…" (pichat-test-job-actions)))
            (should-not (member "Continue work…" (pichat-test-job-actions)))
            (pichat-test-job-press "Details")
            (pichat-test-job-press "Previous run")
            (should (equal pichat-jobs--detail (cons 'runs id)))
            (should (equal original (pichat-job-record store 'runs id)))
            (pichat-test-assert-provider-script-consumed status-file)))))))


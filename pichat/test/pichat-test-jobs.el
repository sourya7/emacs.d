        (pichat-job--render-setup)
        (should (equal (plist-get pichat-job--draft :instructions) original))
        (should (equal (plist-get pichat-job--draft :guidance) guidance))
        (should-not (plist-get pichat-job--draft :dirty))
        (should (= 1 (length (pichat-job-records store 'runs))))))))


        (pichat-test-job-press "Recheck remote Pi exit")
        (should (equal calls (list (list executor id))))
        (should (equal (plist-get (pichat-job-record store 'runs id) :state) "uncertain"))
        (pichat-test-job-actions)
        (let ((scope pichat-jobs--actions))
          (setq supported nil)
          (should-error (pichat-jobs--action scope 'recheck) :type 'user-error))
        (should-not (member "Recheck remote Pi exit" (pichat-test-job-actions)))
        (should (= (length calls) 1))))))


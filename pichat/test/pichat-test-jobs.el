      (let (callbacks)
        (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t))
                  ((symbol-function 'pichat--list-models-async)
                   (lambda (_query cb &rest _) (push cb callbacks) nil))
                  ((symbol-function 'pichat-tool-picker-open)
                   (lambda (_preset _selection _directory _transport _executable cb &rest _)
                     (push cb callbacks))))
          (if (eq picker 'model) (pichat-job-settings-model) (pichat-job-settings-tools))
          (let ((first (car callbacks)))
            (cl-letf (((symbol-function 'pichat--read-model-table-choice)
                       (lambda (&rest _) (signal 'quit nil))))
              (funcall first (if (eq picker 'model) '("fixture") :cancel)))
            (should-not (plist-get settings-scope :pending))
            (if (eq picker 'model) (pichat-job-settings-model) (pichat-job-settings-tools))
            (let ((token (plist-get settings-scope :pending))
                  (before (copy-tree (plist-get settings-scope :draft) t)))
              (cl-letf (((symbol-function 'pichat--read-model-table-choice)
                         (lambda (&rest _) (ert-fail "Old picker stole a later picker"))))
                (funcall first (if (eq picker 'model) '("fixture") :cancel)))
              (should (eq token (plist-get settings-scope :pending)))
              (should (equal before (plist-get settings-scope :draft))))
            (cl-letf (((symbol-function 'pichat--read-model-table-choice)
                       (lambda (&rest _) "fixture/selected")))
              (funcall (car callbacks) (if (eq picker 'model) '("fixture") :cancel)))
            (should-not (plist-get settings-scope :pending))))))))


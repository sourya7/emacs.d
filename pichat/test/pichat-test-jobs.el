    (let* ((spec (pichat-test-job-spec project-dir))
           (waiting (pichat-job-enqueue store spec))
           (_ (setq spec (plist-put spec :resources [(:key "other-workspace" :access "write")])))
           (independent (pichat-job-enqueue store spec))
           (pichat-jobs-max-concurrency 2)
           started)
      (cl-letf (((symbol-function 'pichat-job-executor--start)
                 (lambda (_executor claimed)
                   (push (plist-get claimed :id) started)
                   (when (equal (plist-get claimed :id) independent)

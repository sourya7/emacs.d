          (let ((count (length (pichat-job-records store 'runs))))
            (pichat-job-resolve-uncertain store first "Inspected")
            (should (= (length (pichat-job-records store 'runs)) count))
            (should (equal (plist-get (pichat-job-record store 'runs first) :stop-event)
                           (plist-get origin :stop-event)))))))))


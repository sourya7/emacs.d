             (_ (setf (plist-get spec :instructions)
                      "Use the plans skill for the exact selected Phase 3 only. Stop before Phase 4; no commit or push."))
             (id (pichat-job-executor-submit executor spec))
             (runtime (pichat-job-execution-session (gethash id (pichat-job-executor-contexts executor)))))

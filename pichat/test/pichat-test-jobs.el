  (ert-deftest pichat-integration-job-schedule-run-now-consumes-future-occurrence-once ()
    (pichat-test-with-job-executor (:script '(:turns [(:text "Early scheduled result")]))
      (let* ((job (pichat-job-save store (pichat-test-job-spec project-dir)))
             (due (+ (float-time) 3600))
             (selected (selected-window)) (shown (window-buffer)))

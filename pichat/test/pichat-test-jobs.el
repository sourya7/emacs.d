(ert-deftest pichat-jobs-model-selection-is-run-local-and-restores-on-cancel ()
  (pichat-test-with-job-views
    (pichat-job--setup (pichat-test-job-spec project-dir) nil executor)
    (let ((before (pichat-job--copy (plist-get pichat-job--draft :spec))) callback)
      (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "Model"))
                ((symbol-function 'yes-or-no-p) (lambda (&rest _) t))
                ((symbol-function 'pichat--list-models-async)
                 (lambda (_search cb &rest _) (setq callback cb) nil)))
        (pichat-job-execution-settings))
      (should-error (pichat-job--submission-spec) :type 'user-error)
      (cl-letf (((symbol-function 'pichat--read-model-table-choice)
                 (lambda (&rest _) (signal 'quit nil))))
        (funcall callback '("dummy")))
      (should-not (plist-get pichat-job--draft :pending))
      (should (equal (plist-get pichat-job--draft :spec) before))
      (should (equal pichat-default-model "pichat-fake/pichat-fake")))))


                  ((symbol-function 'rename-file) (lambda (&rest _) (error "Test private payload"))))
          (funcall callback))
        (should (pichat-job-executor-schedule-error executor))
        (should-not (string-match-p "private payload" (pichat-job-executor-schedule-error executor)))
        (should (= (hash-table-count (pichat-job-executor-schedules executor)) 0))
        (funcall callback)
        (pichat-job-executor-schedule-refresh executor)
        (should (equal (pichat-job-records store 'runs) []))))))

(ert-deftest pichat-job-schedule-ui-stages-cancels-saves-disabled-and-enables-separately ()

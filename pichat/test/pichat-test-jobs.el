      (should-not (pichat-session-list))
      (should (equal (pichat-job-records store 'runs) []))
      (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) nil)))
        (pichat-test-job-press "Enable…"))
      (should (= (hash-table-count (pichat-job-executor-schedules executor)) 0))
      (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
        (pichat-test-job-press "Enable…"))
      (should (string-match-p "Every 2 hours · Enabled" (buffer-string)))
      (should (= (hash-table-count (pichat-job-executor-schedules executor)) 1))
      ;; No-op Timing/Save preserves both cadence and authorization.
      (pichat-test-job-press "Change…")
      (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "Every")))
        (pichat-job-schedule-kind))
      (should (= (plist-get (plist-get settings-scope :rule) :seconds) 7200))
      (pichat-job-schedule-apply)
      (should (eq (plist-get (plist-get (pichat-job-record store 'jobs job) :schedule) :enabled) t))
      (pichat-test-job-press "Change…")
      (setf (plist-get (plist-get settings-scope :rule) :seconds) 10800)
      (pichat-job-schedule-apply)
      (should (string-match-p "Every 3 hours · Disabled" (buffer-string)))
      (should (= (hash-table-count (pichat-job-executor-schedules executor)) 0))
      (pichat-test-job-press "Change…")
      (pichat-job-schedule-remove)
      (pichat-job-schedule-cancel)
      (should (plist-get (pichat-job-record store 'jobs job) :schedule))
      (pichat-test-job-press "Change…")
      (pichat-job-schedule-remove)
      (pichat-job-schedule-apply)
      (should (string-match-p "Schedule: None" (buffer-string)))
      (should-not (plist-get (pichat-job-record store 'jobs job) :schedule))
      (should (equal (pichat-job-records store 'runs) [])))))


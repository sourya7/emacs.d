                ((symbol-function 'cancel-timer) #'ignore)
                ((symbol-function 'pichat-job-executor-pump) (lambda (_) (ert-fail "Uncommitted work launched"))))
        (pichat-job-schedule-set store job (list :kind "once" :start (+ now 1)))
        (pichat-job-schedule-enable store job t now)
        (pichat-job-executor-schedule-refresh executor)

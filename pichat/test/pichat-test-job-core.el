          (should-not (pichat-job-schedule-dispatch store job expected 100))
          (should-not (pichat-job-schedule-dispatch store job expected 61 nil t))
          (pichat-job-cancel-queued store id)
          (should-not (pichat-job-schedule-dispatch store job after 101 nil t))
          (should (= 2 (length (pichat-job-records store 'runs))))

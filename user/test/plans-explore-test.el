;;; plans-explore-test.el --- Read-only plans adapter fixtures -*- lexical-binding: t; -*-

;; emacs -Q --batch -L .local/elpaca/builds/vui -l user/json-explore.el \
;;   -l user/plans-explore.el -l user/test/plans-explore-test.el \
;;   -f ert-run-tests-batch-and-exit

(require 'ert)
(require 'json-explore)
(require 'plans-explore)

(defun plans-explore-test--write (path text)
  (write-region text nil path nil 'silent))

(defmacro plans-explore-test--with-cli (&rest body)
  (declare (indent 0))
  `(let* ((directory (make-temp-file "plans-explore-test-" t))
          (default-directory (file-name-as-directory directory))
          (plans-explore-program (expand-file-name "fake plans"))
          (before (buffer-list)))
     (unwind-protect
         (progn
           (plans-explore-test--write
            plans-explore-program
            "#!/bin/sh\nprintf '%s\\n' \"$PWD\" \"$@\" >> argv\nwhile [ $# -gt 0 ]; do\n  case \"$1\" in\n    --json|--local) shift;;\n    --root|--config|--project) shift 2;;\n    list|show|check|workspace) op=$1; break;;\n    *) exit 70;;\n  esac\ndone\ncat \"$op.json\"\n[ ! -f \"$op.err\" ] || cat \"$op.err\" >&2\n[ ! -f \"$op.exit\" ] || exit \"$(cat \"$op.exit\")\"\n")
           (set-file-modes plans-explore-program #o700)
           ,@body)
       (dolist (buffer (seq-difference (buffer-list) before))
         (when (buffer-live-p buffer) (kill-buffer buffer)))
       (delete-directory directory t))))

(defun plans-explore-test--wait ()
  (let ((deadline (+ (float-time) 5)))
    (while (and json-explore--request (< (float-time) deadline))
      (accept-process-output nil 0.05)))
  (should-not json-explore--request))

(defun plans-explore-test--argv (directory)
  (with-temp-buffer
    (insert-file-contents (expand-file-name "argv" directory))
    (split-string (buffer-string) "\n" t)))

(defun plans-explore-test--detail (id path line)
  (format "{\"id\":%s,\"path\":%s,\"org\":\"* Snapshot only\\n\",\"tasks\":[{\"line\":%d,\"state\":\"TODO\",\"title\":\"Fixture task\"}]}"
          (json-serialize id) (json-serialize path) line))

(ert-deftest plans-explore-archived-list-to-detail-preserves-context-and-history ()
  (plans-explore-test--with-cli
    (plans-explore-test--write
     "list.json" "[{\"id\":\"new-plan\",\"status\":\"active\",\"title\":\"New\",\"archived\":false,\"task_counts\":{\"done\":1,\"total\":2}},{\"id\":\"old-plan\",\"status\":\"done\",\"title\":\"Old\",\"archived\":true,\"task_counts\":{\"done\":3,\"total\":3}}]")
    (plans-explore-test--write "show.json" (plans-explore-test--detail "old-plan" "/unused" 1))
    (let* ((args (list "--json" "--root" (expand-file-name "checkout with spaces")
                       "--project" "fixture" "--config" (expand-file-name "config ; $literal")))
           (buffer (plans-explore-list :root "checkout with spaces" :project "fixture"
                                       :config "config ; $literal" :archived t :no-display t))
           (list-call (append (list directory) args '("list" "--all")))
           (show-call (append (list directory) args '("show" "--archived" "old-plan"))))
      (with-current-buffer buffer
        (plans-explore-test--wait)
        (should (equal (plans-explore-test--argv directory) list-call))
        (should (equal (json-explore--view-columns json-explore--view)
                       '(index "id" "title" "status" "task_counts")))
        (should (string-match-p "Progress.*\n.*1/2" (buffer-string)))
        (should (vui-goto-key '(nil 0 "task_counts")))
        (json-explore-open)
        (should (= (gethash "done" (json-explore--view-value json-explore--view)) 1))
        (json-explore-back)
        (should-error (plans-explore-visit) :type 'user-error)
        (should (vui-goto-key '(nil 0 "id")))
        (json-explore-sort) ; old-plan remains row ID 1 even when sorted first
        (json-explore-sort)
        (should (vui-goto-key '(nil 1 index)))
        (let ((plans-explore-program "/different-executable") (default-directory "/"))
          (should-not (command-remapping 'json-explore-open))
          (json-explore-open)
          (plans-explore-test--wait)
          (should (equal (gethash "id" (plans-explore--record)) "old-plan"))
          (json-explore-back)
          (should (equal (vui-key-at) '(nil 1 index)))
          (json-explore-forward)
          (should (equal (plans-explore-test--argv directory) (append list-call show-call)))
          (json-explore-refresh)
          (plans-explore-test--wait)
          (should (equal (plans-explore-test--argv directory) (append list-call show-call show-call))))))))

(ert-deftest plans-explore-check-only-accepts-validation-findings-at-exit-one ()
  (plans-explore-test--with-cli
    (plans-explore-test--write "check.json" "[{\"id\":\"fixture\",\"valid\":false,\"issues\":[\"missing title\"]}]")
    (plans-explore-test--write "check.exit" "1")
    (with-current-buffer (plans-explore-check :archived t :local t :no-display t)
      (plans-explore-test--wait)
      (should (equal (plans-explore-test--argv directory)
                     (list directory "--json" "--local" "check" "--all")))
      (should (string-match-p "Exit status 1" (buffer-string)))
      (should (vui-goto-key '(nil 0 "issues")))
      (plans-explore-open)
      (should (equal (json-explore--value-at-point) "missing title"))
      (json-explore-back)
      (let ((good json-explore--view))
        (dolist (case '(("[]" "1" "Unexpected plans check output")
                        ("{}" "1" "Unexpected plans check output")
                        ("" "1" "no JSON output")
                        ("[]" "2" "Exit status 2")))
          (plans-explore-test--write (expand-file-name "check.json" directory) (nth 0 case))
          (plans-explore-test--write (expand-file-name "check.exit" directory) (nth 1 case))
          (json-explore-refresh)
          (plans-explore-test--wait)
          (should (eq json-explore--view good))
          (should (string-match-p (nth 2 case) (buffer-string))))))
    (plans-explore-test--write "list.json" "[]")
    (plans-explore-test--write "list.exit" "1")
    (with-current-buffer (plans-explore-list :no-display t)
      (plans-explore-test--wait)
      (should-not (json-explore--view-value json-explore--view))
      (should (string-match-p "Exit status 1" (buffer-string))))))

(ert-deftest plans-explore-renders-malformed-inventory-ids-without-fetching-them ()
  (plans-explore-test--with-cli
    (let ((issue "PLAN_ID must be lowercase kebab-case and match directory"))
      (plans-explore-test--write
       "check.json" (format "[{\"id\":\"Bad_ID\",\"valid\":false,\"issues\":[%s]}]"
                            (json-serialize issue)))
      (plans-explore-test--write "check.exit" "1")
      (plans-explore-test--write "list.json" "[{\"id\":\"valid-plan\"},{\"id\":\"Bad_ID\"}]")
      (with-current-buffer (plans-explore-check :no-display t)
        (plans-explore-test--wait)
        (should (string-match-p "Exit status 1" (buffer-string)))
        (should (vui-goto-key '(nil 0 "id")))
        (should (equal (json-explore--value-at-point) "Bad_ID"))
        (let ((argv (plans-explore-test--argv directory)))
          (should-error (plans-explore-open-plan) :type 'user-error)
          (should-not json-explore--request)
          (should (equal (plans-explore-test--argv directory) argv)))
        (should (vui-goto-key '(nil 0 "issues")))
        (plans-explore-open)
        (should (equal (json-explore--value-at-point) issue)))
      (with-current-buffer (plans-explore-list :no-display t)
        (plans-explore-test--wait)
        (should (vui-goto-key '(nil 0 "id")))
        (should (equal (json-explore--value-at-point) "valid-plan"))
        (should (vui-goto-key '(nil 1 "id")))
        (should (equal (json-explore--value-at-point) "Bad_ID"))))))

(ert-deftest plans-explore-workspaces-list-and-local-unavailable ()
  (plans-explore-test--with-cli
    (plans-explore-test--write
     "workspace.json"
     "{\"project\":\"demo\",\"version\":1,\"workspaces\":[{\"plan_id\":\"fixture\"}],\"orphans\":[{\"name\":\"stray\"}]}")
    (with-current-buffer (plans-explore-workspaces :local t :no-display t)
      (should-not json-explore--request)
      (should (string-match-p "unavailable with --local" (buffer-string)))
      (should-error (json-explore-refresh) :type 'user-error))
    (should-not (file-exists-p "argv"))
    (with-current-buffer (plans-explore-workspaces :root directory :no-display t)
      (plans-explore-test--wait)
      (should (equal (plans-explore-test--argv directory)
                     (list directory "--json" "--root" directory "workspace" "list")))
      (should (vui-goto-key '(nil "project" value)))
      (should (string-match-p "Workspaces" (buffer-string)))
      (should (string-match-p "Orphans" (buffer-string)))
      (should (vui-goto-key '(("workspaces") 0 "plan_id")))
      (json-explore-next-cell 3)
      (should (equal (plist-get (json-explore-thing-at-point) :path) '("orphans" 0 "name")))
      (should (vui-goto-key '(nil "workspaces" section)))
      (json-explore-open)
      (should (vui-goto-key '(("workspaces") 0 "plan_id")))
      (should (equal (json-explore--value-at-point) "fixture")))))

(ert-deftest plans-explore-show-hides-org-and-visits-fetched-record ()
  (plans-explore-test--with-cli
    (let ((first (expand-file-name "first.org")) (next (expand-file-name "next.org"))
          (response (expand-file-name "show.json")))
      (plans-explore-test--write first "* First\n* Second\n* Third\n")
      (plans-explore-test--write next "#+STARTUP: overview\n* Tasks\n** Visited task\n")
      (plans-explore-test--write response (plans-explore-test--detail "fixture" first 2))
      (save-window-excursion
        (with-current-buffer (plans-explore-show "fixture" :local t :no-display t)
          (plans-explore-test--wait)
          (should (string-match-p "Tasks (1)" (buffer-string)))
          (should (vui-goto-key '(("tasks") 0 "state")))
          (should (eq (get-text-property (point) 'face) 'bold))
          (should-not (vui-goto-key '(nil "org" section)))
          (should-not (vui-goto-key '(nil "org" value)))
          (should-not (string-match-p "Org text\\|Snapshot only" (buffer-string)))
          (goto-char (point-min))
          (should-not (json-explore-thing-at-point))
          (cl-letf (((symbol-function 'display-buffer) (lambda (&rest _) nil)))
            (with-current-buffer (json-explore-inspect)
              (should buffer-read-only)
              (should-not buffer-file-name)
              (should (equal (gethash "org" (json-parse-string (buffer-string)))
                             "* Snapshot only\n"))))
          (should-not (get-file-buffer first))
          (should (vui-goto-key '(("tasks") 0 index)))
          (let ((kill-ring nil) (interprogram-cut-function nil))
            (json-explore-copy-path)
            (should (equal (current-kill 0) ".[\"tasks\"][0]")))
          (should (vui-goto-key '(nil "tasks" section)))
          (json-explore-toggle-section)
          (should-not (vui-goto-key '(("tasks") 0 "title")))
          (json-explore-toggle-section)
          (should (vui-goto-key '(("tasks") 0 "title")))
          (save-current-buffer (plans-explore-visit))
          (with-current-buffer (get-file-buffer first)
            (should view-mode)
            (should buffer-read-only)
            (should (= (line-number-at-pos) 2)))
          (goto-char (point-min))
          (save-current-buffer (plans-explore-visit))
          (with-current-buffer (get-file-buffer first)
            (should view-mode)
            (should buffer-read-only)
            (should (= (point) (point-min))))
          (should (vui-goto-key '(("tasks") 0 "title")))
          (plans-explore-test--write response (plans-explore-test--detail "fixture" next 3))
          (json-explore-refresh)
          (plans-explore-test--wait)
          (should (equal (json-explore--cell-at) '(("tasks") 0 "title")))
          (should-not (get-file-buffer next))
          (should (equal (save-current-buffer (plans-explore-visit))
                         "Snapshot line 3 may be stale; refresh to check"))
          (with-current-buffer (get-file-buffer next)
            (should view-mode)
            (should buffer-read-only)
            (should (= (line-number-at-pos) 3))
            (should-not (invisible-p (point))))
          (plans-explore-test--write response (plans-explore-test--detail "wrong-id" next 1))
          (json-explore-refresh)
          (plans-explore-test--wait)
          (should (string-match-p "Unexpected plans show output" (buffer-string)))
          (should (equal (gethash "id" (plans-explore--record)) "fixture")))))))

(ert-deftest plans-explore-refuses-invalid-selectors-and-plan-ids ()
  (should-error (plans-explore-show "--help" :no-display t) :type 'user-error)
  (should-error (plans-explore-show "Uppercase" :no-display t) :type 'user-error)
  (should-error (plans-explore-list :local t :project "fixture" :no-display t) :type 'user-error)
  (should-error (plans-explore-check :root "/ssh:fixture:/tmp/" :no-display t) :type 'user-error))

(ert-deftest plans-explore-uses-only-the-public-explorer-api ()
  (with-temp-buffer
    (insert-file-contents (symbol-file 'plans-explore-list 'defun))
    (goto-char (point-min))
    (should-not (re-search-forward "\\_<json-explore--" nil t))))

